---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
import { guides } from '../data/guides';
import CategoryIcon from '../components/CategoryIcon.astro';
import CategoryCard from '../components/CategoryCard.astro';

const { lang = 'en' } = Astro.props;

// Localize links helper
const relLink = (target: string) => {
  const cleanTarget = target.startsWith('/') ? target : `/${target}`;
  if (lang === 'en') return cleanTarget;
  return `/${lang}${cleanTarget}`;
};

const title = "ConvertOcean - 100% Private Offline File Converter & Web Utilities";
const description = "Securely convert, merge, split, and extract text from files client-side. Operating 100% locally in your browser sandbox with zero server uploads and complete privacy.";

const faqList = [
  {
    q: "How does ConvertOcean convert files without uploading them?",
    a: "ConvertOcean uses WebAssembly (WASM) and local JavaScript compilers to convert files directly inside your browser window. When you load a tool page, all required code is loaded into your browser tab cache, allowing your device's CPU/GPU to parse, compile, and format files locally. Since your file data remains inside sandboxed tab memory, it is never transmitted over the internet or uploaded to a remote server."
  },
  {
    q: "Is my confidential business or financial data safe when converting files?",
    a: "Yes, converting sensitive files on ConvertOcean is completely safe. Because all data processing happens locally on your device (client-side), confidential documents, financial statements, internal spreadsheet formulas, and tax details are never uploaded to any remote server or third-party database. You retain full data sovereignty at all times."
  },
  {
    q: "Can a client-side file converter run without an active internet connection?",
    a: "Yes, ConvertOcean is offline-capable. Once you load the tool page in your web browser, all formatting engines, scripts, and WebAssembly converters are stored in your browser tab cache. You can disconnect your device from the internet entirely and convert files locally with 100% functionality and speed."
  },
  {
    q: "Are files stored temporarily on your servers or cookies?",
    a: "No. ConvertOcean does not utilize remote servers for file processing or data storage. All file contents and parsed values reside temporarily in sandboxed browser memory. Once you download the converted file or close the web browser tab, all temporary data is instantly and permanently purged from your device's RAM."
  },
  {
    q: "What data does ConvertOcean collect about me?",
    a: "Never your files. Conversions run inside your browser, so file contents and filenames are never sent anywhere — you can disconnect from the internet and convert anyway. We do use Google Analytics for anonymous usage statistics, which records pages visited plus two events: that a tool was used, and that a conversion finished. Those events carry only the file extension, a coarse size band such as \"1–5 MB\", and the tool page — never a filename, contents, or exact size. The site also serves Google AdSense ads, so analytics and advertising cookies are set. Blocking them leaves every tool fully working. See our Privacy Policy for detail."
  },
  {
    q: "Do I need to register an account or pay for a conversion subscription?",
    a: "No registration, signups, or email entries are required. ConvertOcean is 100% free with no conversion limits, no monthly subscriptions, and no paywalls. Every tool is immediately unlocked and ready for secure, private client-side file conversions."
  }
];

const getToolCount = (categorySlug: string) => {
  if (categorySlug === 'file-converter') {
    return 30; // 30+ formats
  }
  if (categorySlug === 'pdf-tools') {
    return tools.filter(t =>
      t.categorySlug === 'pdf-tools' ||
      t.slug.toLowerCase().includes('pdf') ||
      t.name.toLowerCase().includes('pdf') ||
      t.slug.toLowerCase().includes('merge') ||
      t.slug.toLowerCase().includes('split')
    ).length;
  }
  return tools.filter(t => t.categorySlug === categorySlug).length;
};

// One accent, not six. The per-category hues (red / violet / green / blue /
// amber) were decorative — a card's category is already carried by the filter
// tabs and the tool name — and six competing hues on one grid is what made the
// page read as assembled rather than designed. Colour now lives in CSS as a
// single token; nothing is bound per card.

// Curated "most-used" tools for the homepage — high-intent, one-tap entry.
// Category tiles, in bento order — position determines tile size, so this
// array is the single place that ordering lives.
const categoryCards = [
  {
    href: '/file-converter/', categorySlug: 'file-converter',
    name: 'Universal File Converter', count: '30+ formats',
    action: 'Open File Converter',
    description: 'Convert files between dozens of formats directly inside your browser. Supports documents, spreadsheets, images, and structured data formats.',
  },
  {
    href: '/pdf-tools/', categorySlug: 'pdf-tools',
    name: 'PDF, Split & Merge Tools', count: String(getToolCount('pdf-tools')),
    action: 'Open PDF, Split & Merge Tools',
    description: 'Merge multiple PDF, Excel, Image, or Text documents, split ranges, extract pages, and compile files offline securely.',
  },
  {
    href: '/image-tools/', categorySlug: 'image-tools',
    name: 'Image Tools', count: String(getToolCount('image-tools')),
    description: 'Convert PNG, JPG, WebP, SVG, and BMP formats instantly. Compress, resize, and optimize file sizes client-side in seconds.',
  },
  {
    href: '/document-tools/', categorySlug: 'document-tools',
    name: 'Document Tools', count: String(getToolCount('document-tools')),
    description: 'Process text files, compile document PDFs, convert formatting, and combine rich logs securely inside your local browser tab.',
  },
  {
    href: '/excel-converter/', categorySlug: 'excel-converter',
    name: 'Excel Converter', count: String(getToolCount('excel-converter')),
    description: 'Inspect CSV and Excel sheets client-side. Convert CSV to JSON, JSON to Excel, XLSX to CSV, or compile reports to PDF offline.',
  },
  {
    href: '/business-tools/', categorySlug: 'business-tools',
    name: 'Business Tools', count: String(getToolCount('business-tools')),
    description: 'Create invoices, calculate taxes, and compile print-ready PDFs. Offline-first workflow.',
  },
  {
    href: '/developer-tools/', categorySlug: 'developer-tools',
    name: 'Developer Tools', count: String(getToolCount('developer-tools')),
    description: 'Format JSON, minify code, encode base64, and validate data structures locally.',
  },
];

const popularSlugs = ['pdf-to-word', 'excel-to-pdf', 'image-resizer', 'merge-pdf', 'jpg-to-png', 'image-to-text', 'word-to-pdf', 'split-pdf'];
const popularTools = popularSlugs
  .map(s => tools.find(t => t.slug === s))
  .filter((t): t is (typeof tools)[number] => Boolean(t));

// Nicer chip labels for format tokens (honest — only real formats).
const fmtLabels: Record<string, string> = {
  jpg: 'JPG', jpeg: 'JPG', png: 'PNG', webp: 'WEBP', svg: 'SVG', gif: 'GIF',
  pdf: 'PDF', word: 'DOCX', docx: 'DOCX', ppt: 'PPT', pptx: 'PPTX',
  excel: 'XLSX', xls: 'XLS', xlsx: 'XLSX', csv: 'CSV', json: 'JSON', xml: 'XML',
  txt: 'TXT', image: 'IMG', text: 'TEXT',
};
const chipLabel = (tok: string) => fmtLabels[tok] || tok.toUpperCase();

// Derive scannable chips from a tool slug: a format pair (A → B), or a single action/format chip.
type ToolChips = { pair: true; from: string; to: string } | { pair: false; single: string };
const toolChips = (slug: string): ToolChips => {
  const m = slug.match(/^(.+)-to-(.+)$/);
  if (m) return { pair: true, from: chipLabel(m[1]), to: chipLabel(m[2]) };
  if (slug.startsWith('merge-')) return { pair: false, single: 'MERGE' };
  if (slug.startsWith('split-')) return { pair: false, single: 'SPLIT' };
  if (slug.endsWith('-calculator')) return { pair: false, single: 'CALC' };
  if (slug.endsWith('-generator')) return { pair: false, single: 'PDF' };
  if (slug === 'image-resizer') return { pair: false, single: 'RESIZE' };
  if (slug === 'word-counter') return { pair: false, single: 'COUNT' };
  if (slug === 'json-formatter') return { pair: false, single: 'JSON' };
  return { pair: false, single: chipLabel(slug.split('-')[0]) };
};

// ── Tool grid filter buckets ─────────────────────────────────────────
// categorySlug is how the tools are filed, not how someone shops for one:
// most PDF tools sit under document-tools, and "excel-converter" is not a
// word anyone reaches for. Derive the bucket from the slug instead so every
// pill lands on a populated set (documents 7, pdf 12, images 22,
// spreadsheets 10, other 14).
const filterGroups = [
  { key: 'all', label: 'All' },
  { key: 'documents', label: 'Documents' },
  { key: 'pdf', label: 'PDF' },
  { key: 'images', label: 'Images' },
  { key: 'spreadsheets', label: 'Spreadsheets' },
  { key: 'other', label: 'Other' },
];

const filterKey = (slug: string, categorySlug: string) => {
  if (categorySlug === 'image-tools') return 'images';
  if (slug.includes('pdf')) return 'pdf';
  if (categorySlug === 'excel-converter') return 'spreadsheets';
  if (categorySlug === 'document-tools') return 'documents';
  return 'other';
};

---

<Layout title={title} description={description} lang={lang} faqList={faqList} band="lime">
  <style>
    /* ─── Hero ────────────────────────────────────────────────────────
       DESIGN.md's hero pattern: a two-column split, oversized
       left-aligned headline and supporting paragraph on the left, a
       contained visual on the right. The right column here is the eight
       most-used tools rather than a stock photo — on a utility site the
       most useful thing to put beside the promise is the work itself. */
    .hero-band { padding-block-start: clamp(2rem, 1.2rem + 4vw, 4rem); }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 1rem + 5vw, 5rem);
      align-items: center;
    }

    @media (max-width: 940px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: var(--spacing-2xl);
      }
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-title {
      font-size: var(--fs-display);
      font-weight: var(--fw-extrabold);
      line-height: var(--lh-display);
      letter-spacing: var(--ls-display);
      margin-bottom: var(--spacing-lg);
      color: var(--colors-display);
      /* Two-line editorial stack without a hardcoded <br>, which broke in
         the wrong place at every width between the two it was tuned for. */
      max-width: 15ch;
      text-wrap: balance;
    }

    /* DESIGN.md: body blocks are left-aligned in a generous measure,
       never centred. */
    .hero-subtitle {
      font-size: var(--fs-lead);
      letter-spacing: var(--ls-lead);
      color: var(--colors-body);
      max-width: 46ch;
      margin-bottom: var(--spacing-xl);
      line-height: var(--lh-body);
    }

    .hero-cta-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }

    .hero-proof {
      margin-top: var(--spacing-lg);
      font-size: var(--fs-small);
    }

    .hero-proof a {
      display: inline-flex;
      /* flex-start, so the mark stays on the first line when the sentence
         wraps on a narrow column rather than floating beside the middle. */
      align-items: flex-start;
      gap: 8px;
      padding-block: var(--spacing-xs);
      color: var(--colors-ink);
      font-weight: var(--fw-medium);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1.5px;
      /* On lime the ink underline is the emphasis; a second colour here
         would be a fourth hue in a band that is allowed one. */
      text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    }

    .hero-proof a:hover { text-decoration-color: currentColor; }
    .hero-proof svg { flex-shrink: 0; margin-top: 2px; }

    /* ─── Hero panel: the white lozenge on the lime field ─── */
    .hero-panel {
      background-color: var(--colors-surface);
      border-radius: var(--rounded-card-lg);
      padding: var(--spacing-lg);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      /* The panel is paper, so it keeps the paper contrast pair rather
         than inheriting the lime band's. */
      --colors-ink: var(--p-ink);
      --colors-body: #5f6357;
      --colors-mute: #61655a;
      --colors-hairline: #dcd9d0;
      --colors-canvas-soft: #eeece7;
      --colors-accent: var(--p-cobalt-ink);
    }

    :global([data-theme="dark"]) .hero-panel {
      --colors-ink: var(--p-bone);
      --colors-body: #a9ae9f;
      --colors-mute: #8d9285;
      --colors-hairline: #2f3547;
      --colors-canvas-soft: #262c3c;
      --colors-accent: var(--p-lime);
      background-color: var(--p-ink);
    }

    .hero-panel-title {
      font-size: var(--fs-micro);
      font-weight: var(--fw-bold);
      letter-spacing: var(--ls-micro);
      text-transform: uppercase;
      color: var(--colors-mute);
      padding-inline: var(--spacing-sm);
      margin-bottom: var(--spacing-xxs);
    }

    .hero-tool-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 0;
      padding: 0;
    }

    .hero-tool {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      min-height: 48px;
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--rounded-pill);
      text-decoration: none;
      color: var(--colors-ink);
      transition: background-color 0.15s ease, color 0.15s ease;
      touch-action: manipulation;
    }

    .hero-tool:hover {
      background-color: var(--colors-canvas-soft);
    }

    .hero-tool-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 34px;
      height: 34px;
      border-radius: var(--rounded-full);
      background-color: var(--colors-canvas-soft);
      color: var(--colors-ink);
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    /* The lime lands on the icon on hover — one small, deliberate flash of
       the action colour, rather than a glow around everything. */
    .hero-tool:hover .hero-tool-icon {
      background-color: var(--p-lime);
      color: var(--p-ink);
    }

    .hero-tool-name {
      font-size: var(--fs-body);
      font-weight: var(--fw-medium);
      /* min-width:0 so a long tool name can ellipsize instead of
         stretching the panel. */
      min-width: 0;
      flex: 1 1 auto;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .hero-tool-arrow {
      flex-shrink: 0;
      color: var(--colors-mute);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .hero-tool:hover .hero-tool-arrow,
    .hero-tool:focus-visible .hero-tool-arrow {
      opacity: 1;
      transform: none;
    }

    .hero-panel-all {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 44px;
      margin-top: var(--spacing-xxs);
      border-top: 1.5px solid var(--colors-hairline);
      padding-top: var(--spacing-sm);
      font-size: var(--fs-small);
      font-weight: var(--fw-bold);
      color: var(--colors-accent);
      text-decoration: none;
    }

    .hero-panel-all:hover { text-decoration: underline; text-underline-offset: 3px; }

    @media (prefers-reduced-motion: reduce) {
      .hero-tool-arrow { opacity: 1; transform: none; }
    }
  </style>
  <style is:global>
    /* ── Tool search ────────────────────────────────────────────────
       Rendered by this page and relocated into the nav bar (see the
       portal script below), because the nav lives in the shared Header
       component and only the homepage carries a search field.

       Global rather than scoped: the result rows are built by script, so
       a scoped hash would never reach them. */
    .nav-search {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
      max-width: 360px;
      margin: 0 var(--spacing-lg);
    }

    .search-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-md);
      background-color: var(--colors-canvas);
      transition: border-color 160ms cubic-bezier(0.4, 0, 0.2, 1),
                  background-color 160ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .search-input-wrapper:hover {
      border-color: var(--colors-hairline-strong);
    }

    /* The input suppresses its own outline, so the wrapper carries the
       focus ring for the whole compound control. */
    .search-input-wrapper:focus-within {
      border-color: var(--colors-accent);
      background-color: var(--colors-surface);
      outline: 2px solid var(--colors-accent);
      outline-offset: 1px;
    }

    .search-icon {
      position: absolute;
      left: 10px;
      display: flex;
      align-items: center;
      color: var(--colors-mute);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      min-width: 0;
      padding: 7px 34px 7px 32px;
      font-family: inherit;
      font-size: var(--fs-body);
      border: none;
      background: transparent;
      color: var(--colors-ink);
      /* elevation removed — separation comes from colour, not shadow */
    }

    .search-input::placeholder { color: var(--colors-mute); }

    .search-kbd {
      position: absolute;
      right: 8px;
      padding: 1px 6px;
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-sm);
      background: var(--colors-canvas-soft);
      font-family: var(--font-mono);
      font-size: var(--fs-micro);
      color: var(--colors-mute);
      pointer-events: none;
      transition: opacity 120ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .search-input-wrapper:focus-within .search-kbd { opacity: 0; }

    /* Below .nav-links' own breakpoint the search inherits that space. */
    @media (max-width: 990px) {
      .nav-search { max-width: none; }
    }

    /* No keyboard, no shortcut hint — and the width is wanted for text. */
    @media (max-width: 640px) {
      .search-kbd { display: none; }
      .nav-search { margin: 0 var(--spacing-sm); }
      .search-input { padding-right: var(--spacing-sm); }
    }

    /* ── Results panel ─────────────────────────────────────────────── */
    .search-results-panel {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      max-height: 380px;
      overflow-y: auto;
      padding: var(--spacing-xxs);
      background-color: var(--colors-surface);
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      /* A popover is the one place DESIGN.md still asks for elevation;
         this is its --shadow-lg value, single-layer and uncoloured. */
      /* elevation removed — separation comes from colour, not shadow */
      z-index: 999;
    }

    /* On a phone the field is narrower than the shortest useful result
       row, so the panel breaks out of it and hangs off the right edge. */
    @media (max-width: 520px) {
      .search-results-panel {
        left: auto;
        width: calc(100vw - var(--spacing-md) * 2);
        max-width: 340px;
      }
    }

    .search-result-item {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--rounded-sm);
      text-decoration: none;
      color: var(--colors-ink);
      transition: background-color 120ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .search-result-item:hover,
    .search-result-item.selected {
      background-color: var(--colors-accent-wash);
    }

    .search-result-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-sm);
      color: var(--colors-mute);
    }

    .search-result-info {
      display: flex;
      flex-direction: column;
      min-width: 0;
      text-align: left;
    }

    .search-result-name {
      font-size: var(--fs-body);
      font-weight: 600;
      color: var(--colors-ink);
    }

    .search-result-desc {
      font-size: var(--fs-small);
      color: var(--colors-mute);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  </style>
  <style>

    .section-divider {
      max-width: 1200px;
      margin: 0 auto var(--spacing-3xl);
      border: 0;
      height: 1px;
      background-color: var(--colors-hairline);
    }

    /* ── Section primitives ───────────────────────────────────────
       Shared by every band below the fold. Previously these lived as
       inline style attributes repeated per section, which is why the
       page had drifted to 22 different font sizes. */
    .section-title {
      font-size: var(--fs-title);
      font-weight: 600;
      letter-spacing: var(--ls-title);
      line-height: var(--lh-title);
      margin-bottom: var(--spacing-xl);
      color: var(--colors-display);
    }

    .section-title-sm {
      font-size: var(--fs-heading);
      font-weight: 600;
      letter-spacing: var(--ls-heading);
      line-height: var(--lh-heading);
      margin-top: var(--spacing-xl);
      color: var(--colors-display);
    }

    .section-lede {
      color: var(--colors-body);
      font-size: var(--fs-body);
      line-height: var(--lh-body);
      max-width: 600px;
      margin: 0 0 var(--spacing-xl);
    }

    /* A band separated from the previous one by a hairline rule. */
    .section-ruled {
      margin-top: var(--spacing-4xl);
      border-top: 1px solid var(--colors-hairline);
      padding-top: var(--spacing-3xl);
    }

    .links-title {
      font-size: var(--fs-subhead);
      font-weight: 600;
      letter-spacing: var(--ls-subhead);
      margin-bottom: var(--spacing-lg);
      color: var(--colors-display);
    }

    /* Long-form copy block: owns its own heading + list rhythm. */
    .prose {
      max-width: 800px;
      margin: 0 auto;
      color: var(--colors-body);
      font-size: var(--fs-body);
      line-height: 1.7;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }
    .prose h3 {
      font-size: var(--fs-subhead);
      font-weight: 600;
      letter-spacing: var(--ls-subhead);
      color: var(--colors-ink);
      margin-top: var(--spacing-md);
    }
    .prose ul {
      padding-left: var(--spacing-lg);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    /* The category grid layout lives in theme.css (global). It sizes the
       CategoryCard children, and Astro would scope a child selector here to
       this page's components — which the cards are not — so the rule would
       silently never match. Keep it global. */

    /* Guides on phones: 13 cards at 291px each made this the tallest band
       on the page (4,446px). Clamp the description and tighten the padding
       rather than dropping cards - every guide link stays in the document. */
    @media (max-width: 600px) {
      .featured-card {
        padding: var(--spacing-md);
        gap: var(--spacing-xs);
      }
      .featured-card-desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    }

    /* The single accent every tool and category tile draws from. */
    .popular-card,
    .explore-card {
      --accent: var(--colors-accent-display);
    }

    @media (max-width: 600px) {
      /* At 165px wide the description truncates to "Convert legacy E…",
         which carries no meaning the chips and name do not already give. */
      .explore-card-desc { display: none; }
    }

    .section-actions {
      margin-top: var(--spacing-xl);
    }

    .featured-badge--time {
      color: var(--colors-link);
      font-weight: 600;
    }

    .links-grid--centered {
      grid-template-columns: repeat(4, 1fr);
      justify-items: center;
    }
    @media (max-width: 560px) {
      .links-grid--centered {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Featured Tools Styling */
    .featured-section {
      max-width: 1200px;
      margin: 0 auto var(--spacing-4xl);
      padding: 0 var(--spacing-lg);
    }
    .featured-title {
      font-size: var(--fs-title);
      font-weight: 600;
      letter-spacing: -1.2px;
      margin-bottom: var(--spacing-xl);
      color: var(--colors-display);
    }
    .featured-grid {
      display: grid;
      /* auto-fit reflows 3 → 2 → 1 without breakpoints */
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }
    .featured-card {
      background-color: var(--colors-canvas);
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      padding: var(--spacing-lg);
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      transition: transform 0.2s, border-color 0.2s;
      /* elevation removed — separation comes from colour, not shadow */
    }
    .featured-card:hover {
      transform: translateY(-2px);
      border-color: var(--colors-hairline-strong);
      /* elevation removed — separation comes from colour, not shadow */
    }
    .featured-badge {
      align-self: flex-start;
      font-size: var(--fs-micro);
      font-weight: 500;
      padding: 2px 8px;
      border-radius: var(--rounded-pill);
      background-color: var(--colors-canvas-soft-2);
      color: var(--colors-body);
      font-family: var(--font-sans);
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }
    :global([data-theme="dark"]) .featured-badge {
      background-color: var(--colors-canvas-soft-2);
    }
    .featured-card-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }
    .featured-card-icon {
      font-size: var(--fs-heading);
      width: 44px;
      height: 44px;
      background-color: var(--colors-canvas-soft-2);
      border-radius: var(--rounded-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid var(--colors-hairline);
    }
    :global([data-theme="dark"]) .featured-card-icon {
      background-color: var(--colors-canvas-soft-2);
    }
    .featured-card-name {
      font-size: var(--fs-subhead);
      font-weight: 600;
      letter-spacing: -0.4px;
      color: var(--colors-ink);
      margin: 0;
    }
    .featured-card-desc {
      font-size: var(--fs-small);
      color: var(--colors-body);
      line-height: 1.5;
      flex-grow: 1;
      margin: 0;
    }
    .featured-cta {
      align-self: flex-start;
      margin-top: var(--spacing-xs);
    }

    /* Comparison Table Styling */
    .comparison-section {
      max-width: 1200px;
      margin: 0 auto var(--spacing-4xl);
      padding: 0 var(--spacing-lg);
    }
    .comparison-title {
      font-size: var(--fs-title);
      font-weight: 600;
      letter-spacing: -1.2px;
      color: var(--colors-display);
      margin-bottom: var(--spacing-xs);
    }
    .comparison-subtitle {
      font-size: var(--fs-body);
      color: var(--colors-body);
      max-width: 600px;
      margin: 0 0 var(--spacing-xl);
      line-height: 1.5;
    }
    .table-wrapper {
      overflow-x: auto;
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      background-color: var(--colors-canvas);
      /* elevation removed — separation comes from colour, not shadow */
    }
    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: var(--fs-body);
    }
    .comparison-table th, 
    .comparison-table td {
      padding: var(--spacing-md) var(--spacing-lg);
      border-bottom: 1px solid var(--colors-hairline);
    }
    .comparison-table th {
      font-weight: 600;
      color: var(--colors-ink);
      background-color: var(--colors-canvas-soft-2);
      font-size: var(--fs-small);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    :global([data-theme="dark"]) .comparison-table th {
      background-color: var(--colors-canvas-soft);
    }
    .comparison-table tr:last-child td {
      border-bottom: none;
    }
    .feature-name {
      font-weight: 500;
      color: var(--colors-ink);
    }
    .col-highlight {
      background-color: color-mix(in srgb, var(--colors-accent) 2%, transparent);
      font-weight: 600;
    }
    :global([data-theme="dark"]) .col-highlight {
      background-color: color-mix(in srgb, var(--colors-accent) 4%, transparent);
    }
    .text-success {
      color: var(--colors-accent);
      font-weight: 700;
      font-size: var(--fs-subhead);
    }
    .text-danger {
      color: var(--colors-mute);
      font-size: var(--fs-lead);
    }
    .category-count {
      font-size: var(--fs-body);
      font-weight: 500;
      color: var(--colors-mute);
      margin-left: 6px;
    }

    /* ─── Hero ─── */
    /* One centred column. The two-column split existed only to seat the
       drop zone beside the headline; a homepage drop zone is ambiguous
       (merge, split, compress, convert?), so what is left is a headline,
       one line of subtext and one action — .hero-container centres it. */

    /* ─── Delicate ocean wave at the hero's base (atmosphere) ─── */

    @media (prefers-reduced-motion: reduce) {
      .wave-a, .wave-b, .wave-c { animation: none; }
    }

    /* ─── Signature: the privacy claim, stated as a fact not a badge ───
       An ink pill on the lime field — the same float as the nav, one step
       smaller, and the one place lime appears as type rather than fill. */
    .hero-status {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xs);
      padding: 8px 16px;
      margin-bottom: var(--spacing-lg);
      border-radius: var(--rounded-pill);
      background-color: var(--p-ink);
      color: var(--p-bone);
      font-size: var(--fs-small);
      font-weight: var(--fw-medium);
      letter-spacing: 0;
    }
    .hero-status strong { color: var(--p-lime); font-weight: var(--fw-bold); }
    .hero-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--p-lime);
      flex-shrink: 0;
    }
    @media (max-width: 480px) { .hero-status { font-size: var(--fs-micro); padding: 6px 12px; } }

    /* ─── Popular Tools ─── */
    .popular-section {
      max-width: 1000px;
      margin: 0 auto;
      padding: var(--spacing-md) var(--spacing-lg) var(--spacing-2xl);
    }
    .popular-head { margin-bottom: var(--spacing-lg); }
    .popular-title {
      font-size: var(--fs-title);
      font-weight: 600;
      letter-spacing: var(--ls-title);
      color: var(--colors-display);
    }
    .popular-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-md);
    }
    @media (max-width: 860px) { .popular-grid { grid-template-columns: repeat(2, 1fr); } }
    /* Stays two-up on phones. Collapsing to one column gave each card its own
       row and stretched the section to four screens of scrolling, the same
       problem the explore grid had. Tighten the card instead of dropping a
       column: the icon, name and category all still fit at ~160px wide. */
    @media (max-width: 520px) {
      .popular-grid { gap: var(--spacing-sm); }
      .popular-card { padding: var(--spacing-md); gap: 8px; }
      .popular-card-icon { width: 34px; height: 34px; }
    }
    .popular-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: var(--spacing-lg);
      background: var(--colors-canvas);
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      text-decoration: none;
      position: relative;
      overflow: hidden;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s;
    }
    .popular-card::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 3px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.2s;
    }
    .popular-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--accent) 45%, var(--colors-hairline));
      /* elevation removed — separation comes from colour, not shadow */
    }
    .popular-card:hover::before { opacity: 1; }
    .popular-card-icon {
      width: 42px;
      height: 42px;
      border-radius: var(--rounded-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 12%, transparent);
    }
    .popular-card-name { font-size: var(--fs-body); font-weight: 600; color: var(--colors-ink); }
    .popular-card-cat {
      font-size: var(--fs-small);
      color: var(--colors-mute);
      font-family: var(--font-sans);
    }
    .popular-all {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: var(--spacing-lg);
      font-size: var(--fs-body);
      font-weight: 500;
      color: var(--colors-link);
      text-decoration: none;
    }
    .popular-all:hover { color: var(--colors-link-deep); }

    /* ─── Tool grid category filter ───
       Pills, per DESIGN.md's radius scale: --rounded-pill is the token for
       filter and status pills. These replace the old square .filter-tab
       (whose rules still live in theme.css, now unused by any page). */
    .tool-filter {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
      margin-bottom: var(--spacing-xl);
    }

    .tool-filter-pill {
      font-family: inherit;
      font-size: var(--fs-small);
      font-weight: 500;
      /* 8px/16px keeps the hit target at 34px; --spacing-* only. */
      padding: var(--spacing-xs) var(--spacing-md);
      border: 1.5px solid var(--colors-hairline);
      border-radius: var(--rounded-pill);
      background-color: var(--colors-surface);
      color: var(--colors-body);
      cursor: pointer;
      touch-action: manipulation;
      white-space: nowrap;
      transition: border-color 120ms cubic-bezier(0.4, 0, 0.2, 1),
                  background-color 120ms cubic-bezier(0.4, 0, 0.2, 1),
                  color 120ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .tool-filter-pill:hover {
      border-color: var(--colors-hairline-strong);
      color: var(--colors-ink);
    }

    .tool-filter-pill:focus-visible {
      outline: 2px solid var(--colors-accent);
      outline-offset: 2px;
    }

    /* The active state is one of the accent's few permitted appearances:
       it marks where you are, it is not decoration. */
    .tool-filter-pill[aria-pressed="true"] {
      background-color: var(--colors-action);
      border-color: var(--colors-action);
      color: var(--colors-action-ink);
    }

    .tool-filter-count {
      margin-left: var(--spacing-xxs);
      font-variant-numeric: tabular-nums;
      opacity: 0.7;
    }
  </style>

  <!-- Tool search. It belongs in the nav bar, but the nav bar is rendered by
       the shared Header component and only the homepage carries a search
       field — so it is authored here and moved into place by the inline
       script below, which runs during parse, before first paint. -->
  <div class="nav-search" id="searchContainer" data-tools={JSON.stringify(tools.map(t => ({ name: t.name, slug: t.slug, icon: t.icon, desc: t.description })))}>
    <div class="search-input-wrapper">
      <span class="search-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </span>
      <input
        type="text"
        id="searchInput"
        class="search-input"
        placeholder="Search tools…"
        aria-label="Search all tools"
        role="combobox"
        aria-expanded="false"
        aria-controls="searchResults"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-kbd">/</kbd>
    </div>
    <div id="searchResults" class="search-results-panel" role="listbox" aria-label="Tool search results"></div>
  </div>

  <script is:inline>
    // Runs synchronously at parse time: .nav-bar is already in the document
    // and the search field is the node immediately above, so this lands
    // before the browser paints either one.
    (function () {
      var bar = document.querySelector('.nav-bar');
      var box = document.getElementById('searchContainer');
      var right = bar && bar.querySelector('.nav-right-group');
      if (bar && box && right) bar.insertBefore(box, right);
    })();
  </script>

