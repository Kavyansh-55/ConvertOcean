---
/**
 * The "conversor de arquivos" page — the Portuguese counterpart of
 * /file-converter/, which every Portuguese page links to from the nav.
 *
 * Until 2026-09-27 this was a link directory only, while /file-converter/ is a
 * working converter: someone who searched "conversor de arquivos" landed on a
 * list instead of a tool. It now mirrors the English page — the same
 * UniversalFileConverter at the top, the same pillar + FAQ structure — and
 * keeps the directory below it, grouped by what the reader converts FROM,
 * which is how the Portuguese queries are phrased ("pdf para word").
 *
 * The directory is built from the locale data, so it lists exactly the
 * conversions that exist and can never point at a page that was never built.
 */
import Layout from '../../layouts/Layout.astro';
import UniversalFileConverter from '../../components/tools/UniversalFileConverter.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { getTools } from '../../i18n/content';
import type { Locale } from '../../i18n/config';

const lang: Locale = 'pt';
const title = 'Conversor de Arquivos Online Grátis — 100% Privado | ConvertOcean';
const description =
  'Converta PDF, Word, Excel, PowerPoint, imagens e dados direto no navegador. Os arquivos não saem do seu computador.';
const headline = 'Conversor de Arquivos';
const subtitle =
  'Converta planilhas e dados entre formatos direto no navegador — e escolha abaixo um dos conversores dedicados para PDF, Word e imagens. Sem cadastro e sem limite.';

const tools = getTools(lang);

/* Grouped by what the reader is converting FROM, which is how the search
   queries are phrased — "pdf para word", "imagem para pdf" — rather than by
   the internal category the tool belongs to. */
const groups = [
  { title: 'A partir de PDF', match: (s: string) => s.startsWith('pdf-para') },
  { title: 'Para PDF', match: (s: string) => s.endsWith('-para-pdf') },
  { title: 'Imagens', match: (s: string) => /^(jpg|jpeg|png|webp|heic|avif|svg|imagem)-para|^redimensionar|^dividir-imagem|^juntar-fotos/.test(s) },
  { title: 'Planilhas e dados', match: (s: string) => /^(xls|xlsx|csv|json|xml|ofx|qfx|qbo)-para/.test(s) },
  { title: 'Documentos', match: (s: string) => /^(word|docx|ppt|powerpoint)-para|documentos-word|arquivo-word|arquivos-txt|arquivo-txt|powerpoint$/.test(s) },
];

const seen = new Set<string>();
const sections = groups.map(g => {
  const items = tools
    .filter(t => !seen.has(t.slug) && g.match(t.slug))
    .sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'));
  items.forEach(t => seen.add(t.slug));
  return { title: g.title, items };
}).filter(s => s.items.length > 0);

/* Anything the groups above did not claim still gets a home — a tool silently
   missing from this page is the same quiet omission the locale keeps hitting. */
const rest = tools
  .filter(t => !seen.has(t.slug))
  .sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'));

/* Written for this page, not keyword-targeted: they answer what the converter
   above actually does, which is Excel, CSV and TXT in; PDF, JSON, CSV and
   XLSX out. Everything else goes through the dedicated tools below. */
const faqList = [
  {
    q: 'Como o ConvertOcean converte arquivos sem mandá-los para um servidor?',
    a: 'Os conversores rodam dentro do próprio navegador, com JavaScript e WebAssembly. Quando a página carrega, o código de conversão já está no seu aparelho; o arquivo é lido e convertido na memória da aba e não é transmitido pela internet em nenhum momento.'
  },
  {
    q: 'Quais formatos o conversor desta página aceita?',
    a: 'Este conversor lê planilhas Excel (.xlsx, .xls), CSV e arquivos de texto (.txt), mostra uma prévia dos dados e exporta para PDF, JSON, CSV ou XLSX. Para PDF, Word, PowerPoint e imagens, use os conversores dedicados listados logo abaixo — cada um tem opções próprias para o formato.'
  },
  {
    q: 'O conversor funciona sem internet?',
    a: 'Sim. Depois que a página termina de carregar, dá para desconectar o aparelho e converter normalmente: todo o processamento acontece localmente, no navegador.'
  },
  {
    q: 'Preciso criar conta ou pagar alguma coisa?',
    a: 'Não. Não há cadastro, assinatura, marca d’água nem limite diário. Todas as ferramentas do site são gratuitas e ficam liberadas desde o primeiro uso.'
  },
  {
    q: 'Os meus arquivos ficam guardados em algum lugar?',
    a: 'Não. O conteúdo do arquivo fica só na memória temporária da aba enquanto você converte, e some quando a aba é fechada. Nada é gravado em servidor, e o código do site é aberto para quem quiser conferir.'
  }
];
---

<Layout band="lime" title={title} description={description} lang={lang} category="Conversor de Arquivos" categorySlug="file-converter" faqList={faqList}>
  <style>
    .pillar-intro {
      max-width: 800px;
      margin: var(--spacing-3xl) auto 0;
      font-size: 14.5px;
      line-height: 1.7;
      color: var(--colors-body);
    }
    .pillar-intro h2 {
      font-size: 22px;
      font-weight: var(--fw-bold);
      color: var(--colors-ink);
      letter-spacing: -0.88px;
      margin-bottom: var(--spacing-md);
      font-family: var(--font-sans);
    }
    .pillar-intro p { margin-bottom: var(--spacing-md); }
    .fc-group { margin-top: var(--spacing-xl); }
    .fc-group-title {
      font-size: 17px;
      font-weight: var(--fw-bold);
      color: var(--colors-ink);
      letter-spacing: -0.5px;
      margin: 0 0 var(--spacing-sm);
      font-family: var(--font-sans);
    }
    .fc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: var(--spacing-sm);
    }
    .fc-item {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      /* 44px touch target (WCAG 2.5.8). */
      min-height: 44px;
      padding: var(--spacing-sm) var(--spacing-md);
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      background: var(--colors-canvas);
      color: var(--colors-ink);
      text-decoration: none;
      font-size: var(--fs-small);
      font-weight: var(--fw-bold);
      transition: border-color 0.2s;
    }
    .fc-item:hover { border-color: var(--colors-link); }
    .fc-item:focus-visible { outline: 2px solid var(--colors-link-deep); outline-offset: 2px; }
    .fc-item-icon { display: inline-flex; color: var(--colors-ink); flex-shrink: 0; }
    @media (prefers-reduced-motion: reduce) { .fc-item { transition: none; } }
  </style>
  <main id="main-content" tabindex="-1" class="page-container" style="max-width: 1000px; margin: 0 auto; padding-block: var(--spacing-xl) var(--spacing-4xl);">
    <UniversalFileConverter slug="file-converter" headline={headline} subtitle={subtitle} lang={lang} />

    <!-- Every conversion on the site, grouped by source format -->
    <section class="pillar-intro" data-reveal>
      <h2>Todos os conversores, pelo formato de origem.</h2>
      <p>
        O conversor acima resolve planilhas e dados. Para PDF, Word, PowerPoint e
        imagens, cada conversão tem uma página própria, com as opções certas para o
        formato — e nenhuma delas envia o arquivo para lugar nenhum.
      </p>

      {sections.map(sec => (
        <section class="fc-group">
          <h3 class="fc-group-title">{sec.title}</h3>
          <div class="fc-grid">
            {sec.items.map(t => (
              <a href={`/pt/${t.slug}/`} class="fc-item">
                <span class="fc-item-icon" aria-hidden="true"><CategoryIcon icon={t.icon} width="18" height="18" /></span>
                <span>{t.name}</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      {rest.length > 0 && (
        <section class="fc-group">
          <h3 class="fc-group-title">Outras ferramentas</h3>
          <div class="fc-grid">
            {rest.map(t => (
              <a href={`/pt/${t.slug}/`} class="fc-item">
                <span class="fc-item-icon" aria-hidden="true"><CategoryIcon icon={t.icon} width="18" height="18" /></span>
                <span>{t.name}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </section>

    <!-- FAQ Section -->
    <section class="faq-section" style="margin-top: var(--spacing-3xl);">
      <h2 class="faq-title" style="font-size: 20px; margin-bottom: var(--spacing-lg);">Perguntas frequentes</h2>
      <div class="faq-container">
        {faqList.map(faq => (
          <div class="faq-item">
            <button type="button" class="faq-question" aria-expanded="false">
              {faq.q}
              <svg class="faq-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
            <div class="faq-answer">
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
