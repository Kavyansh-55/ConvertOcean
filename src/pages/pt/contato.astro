---
/**
 * Portuguese contact page — mirrors src/pages/contact.astro.
 *
 * The first version skipped the form on the premise that "a form needs
 * somewhere to post to". It does not: the English form has no server behind
 * it — Send assembles the message and hands it to the reader's own email
 * program via mailto, and the note under the form says so. That is as honest
 * about where the message goes as a bare address, so the Portuguese page now
 * carries the same channels, form and structure as the English one, with the
 * Portuguese-only sections (LGPD requests) kept.
 */
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../i18n/config';

const lang: Locale = 'pt';
const SUPPORT_EMAIL = 'kavyanshtech7@gmail.com';
const REPO = 'https://github.com/Kavyansh-55/ConvertOcean';
const title = 'Fale Conosco | ConvertOcean';
const description =
  'Como entrar em contato com o ConvertOcean: dúvidas, erros de tradução, problemas em uma ferramenta ou solicitações sobre dados.';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Fale conosco — ConvertOcean",
  "url": "https://convertocean.com/pt/contato/",
  "inLanguage": "pt-BR",
  "mainEntity": {
    "@type": "Organization",
    "name": "ConvertOcean",
    "url": "https://convertocean.com",
    "email": SUPPORT_EMAIL,
    "contactPoint": [{
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": SUPPORT_EMAIL,
      "availableLanguage": ["Portuguese", "English"]
    }]
  }
};
---

<Layout title={title} description={description} lang={lang} category="Fale conosco" categorySlug="contact">
  <style>
    .contact-container {
      max-width: 600px;
      margin: 0 auto;
    }
    .contact-lead {
      font-size: 20px;
      color: var(--colors-body);
      line-height: 1.6;
      margin-bottom: var(--spacing-xl);
    }
    .contact-card {
      background-color: var(--colors-canvas);
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      padding: var(--spacing-xl);
      margin-top: var(--spacing-lg);
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: var(--spacing-md);
    }
    .form-label {
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--colors-body);
    }
    .text-area {
      min-height: 120px;
      resize: vertical;
      font-family: inherit;
      padding: var(--spacing-sm);
    }
    .contact-privacy-note {
      font-size: 12.5px;
      color: var(--colors-mute);
      line-height: 1.5;
      margin-top: var(--spacing-md);
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }
    .contact-channels {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-md);
      margin-top: var(--spacing-lg);
    }
    @media (max-width: 620px) {
      .contact-channels { grid-template-columns: 1fr; }
    }
    .channel {
      background-color: var(--colors-canvas);
      border: 1px solid var(--colors-hairline);
      border-radius: var(--rounded-lg);
      padding: var(--spacing-lg);
    }
    .channel-label {
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--colors-mute);
      margin: 0 0 6px;
    }
    .channel-value {
      font-size: 16px;
      font-weight: var(--fw-bold);
      word-break: break-word;
    }
    .channel-value a { color: var(--colors-link); text-decoration: none; }
    .channel-value a:hover { text-decoration: underline; }
    .channel-note {
      font-size: 13px;
      color: var(--colors-body);
      line-height: 1.55;
      margin: 8px 0 0;
    }

    .contact-section { margin-top: var(--spacing-2xl); }
    .contact-section h2 {
      font-size: 22px;
      font-weight: var(--fw-bold);
      color: var(--colors-ink);
      margin: 0 0 var(--spacing-xs);
    }
    .contact-section h2 + p, .contact-section h2 + ul { margin-top: 0; }
    .contact-section h2:not(:first-child) { margin-top: var(--spacing-xl); }
    .contact-section p,
    .contact-section li {
      font-size: 15px;
      line-height: 1.65;
      color: var(--colors-body);
    }
    .contact-section ul { padding-left: 1.15rem; margin: 6px 0 0; }
    .contact-section li { margin-bottom: 5px; }
    .contact-section a { color: var(--colors-link); }

    .submit-success {
      background-color: var(--colors-link-bg-soft);
      border: 1px solid var(--colors-link);
      color: var(--colors-link-deep);
      border-radius: var(--rounded-sm);
      padding: var(--spacing-md);
      font-size: 14px;
      font-weight: 500;
      display: none;
      align-items: center;
      gap: var(--spacing-xs);
      margin-bottom: var(--spacing-md);
    }
  </style>

  <main id="main-content" tabindex="-1" class="app-container" style="max-width: 1000px; margin: 0 auto; padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-4xl); position: relative; z-index: 1;">
    <div class="contact-container">
      <div class="page-header">
        <h1 class="page-title">Fale conosco.</h1>
        <p class="contact-lead">Dúvidas, erros, ideias de ferramentas novas — tudo chega direto a quem constrói o ConvertOcean. Não há fila de chamados nem central terceirizada no meio. Lemos em português e em inglês.</p>
      </div>

      <div class="contact-channels">
        <div class="channel">
          <p class="channel-label">E-mail</p>
          <p class="channel-value"><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
          <p class="channel-note">O melhor canal para assuntos privados, pedidos sobre dados ou quando você quer mandar uma captura de tela.</p>
        </div>
        <div class="channel">
          <p class="channel-label">GitHub Issues</p>
          <p class="channel-value"><a href={`${REPO}/issues`} rel="noopener">github.com/Kavyansh-55/ConvertOcean</a></p>
          <p class="channel-note">O melhor canal para erros e pedidos de ferramentas. O código é aberto (licença MIT): dá para ler o código que gerou o seu arquivo — e a correção, quando sair.</p>
        </div>
      </div>

      <!-- Contact Form Card -->
      <div class="contact-card">
        <div id="submitSuccess" class="submit-success">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
          <span>Obrigado! O seu programa de e-mail vai abrir com a mensagem pronta — é só enviar.</span>
        </div>

        <form id="contactForm">
          <div class="form-group">
            <label for="contactName" class="form-label">Nome</label>
            <input type="text" id="contactName" class="form-input" placeholder="Seu nome" required />
          </div>

          <div class="form-group">
            <label for="contactEmail" class="form-label">E-mail</label>
            <input type="email" id="contactEmail" class="form-input" placeholder="voce@exemplo.com.br" required />
          </div>

          <div class="form-group">
            <label for="contactReason" class="form-label">Assunto</label>
            <select id="contactReason" class="select-input" required>
              <option value="Dúvida">Dúvida geral</option>
              <option value="Erro">Erro em uma ferramenta</option>
              <option value="Tradução">Erro de português</option>
              <option value="Sugestão">Sugestão de ferramenta nova</option>
              <option value="LGPD">Solicitação sobre dados (LGPD)</option>
              <option value="Parceria">Parceria ou imprensa</option>
              <option value="Segurança">Problema de segurança</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contactMessage" class="form-label">Mensagem</label>
            <textarea id="contactMessage" class="form-input text-area" placeholder="Escreva a sua mensagem…" required></textarea>
          </div>

          <button type="submit" class="button button-primary" style="width: 100%; margin-top: var(--spacing-sm);">Enviar mensagem</button>
        </form>

        <p class="contact-privacy-note">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <span><strong>Como este formulário funciona:</strong> não há servidor por trás dele. Ao clicar em Enviar, a mensagem é montada e entregue ao seu próprio programa de e-mail — nada é gravado nem enviado para nós até você mesmo enviar. Se o aparelho não tiver um programa de e-mail configurado, nada vai acontecer; nesse caso, escreva direto para o endereço acima.</span>
        </p>
      </div>

      <section class="contact-section">
        <h2>O que ajuda a resolver mais rápido</h2>
        <ul>
          <li><strong>Um problema em uma ferramenta:</strong> diga qual página, o que você esperava e o que aconteceu. O tipo e o tamanho aproximado do arquivo ajudam muito — mas <em>não mande o arquivo</em>: ele quase sempre contém dados pessoais, e nós não precisamos dele para investigar.</li>
          <li><strong>O navegador e o sistema</strong> que você usa. Uma parte surpreendente dos problemas acontece em um navegador só.</li>
          <li><strong>Um erro de português:</strong> a tradução do site foi escrita por pessoa, não gerada automaticamente, mas erros passam. Indicar a página e o trecho já basta.</li>
          <li><strong>Uma ferramenta que falta:</strong> diga o que você estava tentando fazer, não só o formato. Saber a tarefa costuma mudar o que vale a pena construir.</li>
        </ul>

        <h2>Solicitações sobre dados</h2>
        <p>Para pedidos relacionados à LGPD — acesso, correção ou exclusão —, use o mesmo endereço. Vale saber de antemão que o conjunto é mínimo por construção: não há cadastro, os arquivos nunca chegam até nós e não formamos perfil de pessoa identificada. Os detalhes estão na <a href="/pt/privacidade/">política de privacidade</a>.</p>

        <h2>O que não conseguimos fazer</h2>
        <ul>
          <li><strong>Recuperar um arquivo que você converteu.</strong> Não é uma regra, é consequência da arquitetura: o arquivo nunca chegou até nós, então não existe cópia. Fechou a aba, ele some.</li>
          <li><strong>Ver os seus dados</strong> — por isso não dá para consultar "a conversão que fiz ontem". Nada sobre os seus arquivos é registrado.</li>
          <li><strong>Desbloquear documentos protegidos por senha ou por DRM.</strong></li>
          <li><strong>Dar orientação jurídica, fiscal ou contábil.</strong> As calculadoras mostram a fórmula para você conferir a conta, mas o resultado não substitui um profissional.</li>
        </ul>

        <h2>Prazo de resposta</h2>
        <p>O ConvertOcean é um projeto independente, não uma central de atendimento, então conte com alguns dias para a resposta — um pouco mais nos fins de semana. Todas as mensagens são lidas. Se um relato vira correção, ela vale para todo mundo de uma vez: não há contas nem planos por aqui.</p>
      </section>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <script is:inline define:vars={{ SUPPORT_EMAIL }}>
    // define:vars wraps this in an IIFE; bound with addEventListener for the
    // same reason as the English page (an inline onsubmit could not see it).
    (function () {
      var form = document.getElementById('contactForm');
      if (!form) return;

      form.addEventListener('submit', function (event) {
        event.preventDefault();

        var name = document.getElementById('contactName').value;
        var email = document.getElementById('contactEmail').value;
        var reason = document.getElementById('contactReason').value;
        var message = document.getElementById('contactMessage').value;

        var subject = encodeURIComponent('ConvertOcean [' + reason + '] - ' + name);
        var body = encodeURIComponent(
          'Nome: ' + name + '\nE-mail: ' + email + '\nAssunto: ' + reason + '\n\nMensagem:\n' + message
        );

        var mailtoUrl = 'mailto:' + SUPPORT_EMAIL + '?subject=' + subject + '&body=' + body;

        document.getElementById('submitSuccess').style.display = 'flex';
        form.reset();
        window.location.href = mailtoUrl;
      });
    })();
  </script>
</Layout>
