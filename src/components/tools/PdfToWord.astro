---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, headline, subtitle } = Astro.props;
---

<style>
  .text-preview {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    padding: var(--spacing-md);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    white-space: pre-wrap;
    max-height: 300px;
    overflow: auto;
    margin-top: var(--spacing-lg);
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span>⚠️</span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="📄" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">Upload PDF file (Max 25MB)</div>
  <input type="file" id="fileInput" class="file-input" accept=".pdf" />
</div>

<pre id="textPreview" class="text-preview" style="display: none;"></pre>

<div id="actionControls" class="panel-card" style="display: none; margin-top: var(--spacing-md); flex-direction: row; justify-content: space-between; align-items: center;">
  <span id="fileNameDisplay" style="font-weight:600; font-size:14px;"></span>
  <div class="button-group">
    <button class="button button-primary" id="btnDownload">Download DOCX</button>
    <button class="button button-danger" id="btnClear">Clear</button>
  </div>
</div>

<script>
  import { collectPageLines, buildDocxParts, pagesPlainText } from '../../scripts/pdf-to-docx.js';

  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput');
  const errorBanner = document.getElementById('errorBanner');
  const errorMessage = document.getElementById('errorMessage');
  const progressOverlay = document.getElementById('progressOverlay');
  const progressBarFill = document.getElementById('progressBarFill');
  const progressLabel = document.getElementById('progressLabel');
  const textPreview = document.getElementById('textPreview');
  const actionControls = document.getElementById('actionControls');
  const fileNameDisplay = document.getElementById('fileNameDisplay');
  const btnDownload = document.getElementById('btnDownload');
  const btnClear = document.getElementById('btnClear');

  let extractedPages = null;
  let originalName = '';

  // Drag and drop setup
  ['dragenter', 'dragover'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('dragover');
    }, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('dragover');
    }, false);
  });

  dropZone.addEventListener('drop', (e) => {
    const files = Array.from(e.dataTransfer.files).slice(0, 1);
    if (files.length > 0) handleFile(files[0]);
  });

  fileInput.addEventListener('change', (e) => {
    const files = Array.from(e.target.files).slice(0, 1);
    if (files.length > 0) handleFile(files[0]);
  });

  function showProgress(pct, label) {
    progressOverlay.style.display = 'flex';
    progressBarFill.style.width = pct + '%';
    progressLabel.textContent = label;
  }

  function hideProgress() {
    progressOverlay.style.display = 'none';
  }

  function showError(msg, link) {
    errorMessage.textContent = msg;
    if (link) {
      errorMessage.appendChild(document.createTextNode(' '));
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label;
      a.style.cssText = 'color: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 2px;';
      errorMessage.appendChild(a);
    }
    errorBanner.style.display = 'flex';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function hideError() {
    errorBanner.style.display = 'none';
  }

  async function handleFile(file) {
    hideError();
    if (!/\.pdf$/i.test(file.name)) {
      showError('Invalid file format. Please upload a .pdf document.');
      return;
    }
    if (file.size > 25 * 1024 * 1024) {
      showError('File is larger than the 25MB limit.');
      return;
    }
    originalName = file.name;
    showProgress(5, 'Loading PDF data structure…');
    try {
      const data = new Uint8Array(await file.arrayBuffer());
      const pdf = await window.pdfjsLib.getDocument({ data }).promise;
      const pages = [];

      for (let i = 1; i <= pdf.numPages; i++) {
        showProgress(Math.round(5 + (i / pdf.numPages) * 90), `Reading page ${i} of ${pdf.numPages}…`);
        const page = await pdf.getPage(i);
        // getOperatorList loads the page's fonts into commonObjs, which is
        // where the real font names (and therefore bold/italic) come from.
        try { await page.getOperatorList(); } catch (e) { /* styling degrades, text still converts */ }
        const textContent = await page.getTextContent();
        const fontNameOf = (id) => {
          try {
            const f = page.commonObjs.get(id);
            return (f && f.name) || '';
          } catch (e) {
            return '';
          }
        };
        const viewport = page.getViewport({ scale: 1 });
        pages.push({
          lines: collectPageLines(textContent, fontNameOf),
          width: viewport.width,
          height: viewport.height,
        });
      }

      const fullText = pagesPlainText(pages);

      // A scanned PDF is images of text with no text layer, so extraction
      // legitimately returns nothing. Without this check the tool reported
      // success and handed over an empty document.
      if (!fullText.replace(/\s/g, '')) {
        showError(
          'This PDF has no selectable text — it looks like a scan or a photo, ' +
          'so there is nothing to extract. Read it with OCR instead:',
          { label: 'Open Image to Text (OCR)', href: '/image-to-text/' }
        );
        hideProgress();
        return;
      }

      extractedPages = pages;
      textPreview.textContent = fullText.substring(0, 1200) + (fullText.length > 1200 ? '\n…[truncated preview]' : '');
      textPreview.style.display = 'block';
      fileNameDisplay.textContent = file.name;
      actionControls.style.display = 'flex';
      dropZone.style.display = 'none';
    } catch (err) {
      showError('Failed to parse PDF pages.');
    }
    hideProgress();
  }

  btnDownload.addEventListener('click', async () => {
    if (!extractedPages) return;
    try {
      showProgress(50, 'Building Word document…');
      // Real WordprocessingML package: styled runs, indents, tab stops and
      // detected tables — not plain text in an HTML file renamed .doc.
      const parts = buildDocxParts(extractedPages);
      const zip = new window.JSZip();
      for (const [path, content] of Object.entries(parts)) {
        zip.file(path, content);
      }
      const blob = await zip.generateAsync({
        type: 'blob',
        compression: 'DEFLATE',
        mimeType: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      });
      window.downloadBlob(
        blob,
        originalName.replace(/\.[^/.]+$/, '') + '.docx',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      );
    } catch (err) {
      showError('Failed to build the Word document.');
    }
    hideProgress();
  });

  btnClear.addEventListener('click', () => {
    extractedPages = null;
    textPreview.style.display = 'none';
    actionControls.style.display = 'none';
    dropZone.style.display = 'flex';
    fileInput.value = '';
  });
</script>
