---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, headline, subtitle } = Astro.props;

let acceptMime = ".docx";
let uploadLabel = "Word document (.docx) (Max 15MB)";
let targetFormat = "PDF";
if (slug === 'docx-to-txt') {
  targetFormat = "TXT";
}
---

<style>
  .preview-card {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    min-height: 250px;
    max-height: 500px;
    overflow: auto;
    margin-top: var(--spacing-lg);
    padding: var(--spacing-lg);
  }
  .preview-html-content {
    font-family: 'Inter', sans-serif;
    color: var(--colors-ink);
    line-height: 1.6;
  }
  .preview-html-content p {
    margin-bottom: var(--spacing-sm);
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/pdfmake@0.2.10/build/pdfmake.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/pdfmake@0.2.10/build/vfs_fonts.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span class="banner-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="📝" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">{uploadLabel}</div>
  <button type="button" class="upload-cta">Choose file</button>
  <input type="file" id="fileInput" class="file-input" accept={acceptMime} />
</div>

<!-- The script below is a bundled module (it imports the DOCX reader), and
     Astro define:vars only works on inline scripts, so config goes via the DOM. -->
<div id="toolConfig" hidden data-slug={slug} data-target={targetFormat}></div>

<!-- Preview Panel -->
<div id="previewCard" class="preview-card" style="display: none;">
  <div id="previewBody" class="preview-html-content"></div>
</div>

<!-- Controls -->
<div id="actionControls" class="panel-card" style="display: none; margin-top: var(--spacing-md); flex-direction: row; justify-content: space-between; align-items: center;">
  <span id="fileNameDisplay" style="font-weight:600; font-size:14px;"></span>
  <div class="button-group">
    <button class="button button-primary" id="btnDownload">Download {targetFormat}</button>
    <button class="button button-danger" id="btnClear">Clear</button>
  </div>
</div>

<script>
  import { buildDocDefinition, fontsNeeded } from '../../scripts/docx-to-pdf.js';
  import { registerPdfmakeFonts } from '../../scripts/pdf-fonts.js';

  (function() {
    const cfg = document.getElementById('toolConfig');
    const slug = cfg.dataset.slug;
    const targetFormat = cfg.dataset.target;

    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const previewCard = document.getElementById('previewCard');
    const previewBody = document.getElementById('previewBody');
    const actionControls = document.getElementById('actionControls');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const btnDownload = document.getElementById('btnDownload');
    const btnClear = document.getElementById('btnClear');

    let originalName = '';
    let docBytes = null;      // the uploaded .docx
    let plainText = '';       // for the docx-to-txt path

    ['dragenter', 'dragover'].forEach((ev) => {
      dropZone.addEventListener(ev, (e) => {
        e.preventDefault(); e.stopPropagation(); dropZone.classList.add('dragover');
      }, false);
    });
    ['dragleave', 'drop'].forEach((ev) => {
      dropZone.addEventListener(ev, (e) => {
        e.preventDefault(); e.stopPropagation(); dropZone.classList.remove('dragover');
      }, false);
    });
    dropZone.addEventListener('drop', (e) => {
      const files = Array.from(e.dataTransfer.files).slice(0, 1);
      if (files.length) handleFile(files[0]);
    });
    fileInput.addEventListener('change', (e) => {
      const files = Array.from(e.target.files).slice(0, 1);
      if (files.length) handleFile(files[0]);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }
    function hideProgress() { progressOverlay.style.display = 'none'; }
    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function hideError() { errorBanner.style.display = 'none'; }

    const parseXml = (text) => new DOMParser().parseFromString(text, 'application/xml');

    /**
     * Open the .docx and pull out every part the converter needs.
     *
     * Reading the package directly is the point of this path. The previous
     * implementation went through a docx-to-semantic-HTML step, which by design
     * discards direct formatting — alignment, colour, shading, fonts, headers,
     * footers and section geometry all disappeared before the PDF stage ever
     * saw them.
     */
    async function readDocxParts(bytes) {
      const zip = await JSZip.loadAsync(bytes);
      const readXml = async (path) => {
        const f = zip.file(path);
        return f ? parseXml(await f.async('string')) : null;
      };

      const document = await readXml('word/document.xml');
      if (!document || !document.documentElement || document.getElementsByTagName('parsererror').length) {
        throw new Error('unreadable document.xml');
      }

      const styles = await readXml('word/styles.xml');
      const numbering = await readXml('word/numbering.xml');

      /* Relationships resolve images, hyperlink targets and the header/footer
         parts. Without them a picture is a dangling id. */
      const relsDoc = await readXml('word/_rels/document.xml.rels');
      const images = new Map();
      const links = new Map();
      const running = new Map();

      if (relsDoc && relsDoc.documentElement) {
        for (const rel of Array.from(relsDoc.getElementsByTagName('Relationship'))) {
          const id = rel.getAttribute('Id');
          const type = rel.getAttribute('Type') || '';
          const target = rel.getAttribute('Target') || '';
          if (!id) continue;

          if (/\/hyperlink$/.test(type)) {
            if (rel.getAttribute('TargetMode') === 'External') links.set(id, target);
          } else if (/\/image$/.test(type)) {
            const path = 'word/' + target.replace(/^\.\//, '');
            const f = zip.file(path) || zip.file(path.replace('word/../', ''));
            if (f) {
              const ext = (target.split('.').pop() || 'png').toLowerCase();
              const mime = ext === 'jpg' || ext === 'jpeg' ? 'image/jpeg'
                : ext === 'gif' ? 'image/gif' : 'image/png';
              images.set(id, 'data:' + mime + ';base64,' + await f.async('base64'));
            }
          } else if (/\/(header|footer)$/.test(type)) {
            const doc = await readXml('word/' + target.replace(/^\.\//, ''));
            if (doc) running.set(id, doc);
          }
        }
      }

      return { document, styles, numbering, images, links, running };
    }

    /** Visible text, for the preview and for the TXT output. */
    function extractText(documentDoc) {
      const paras = Array.from(documentDoc.getElementsByTagName('w:p'));
      return paras.map((p) => {
        let s = '';
        for (const t of Array.from(p.getElementsByTagName('w:t'))) s += t.textContent;
        for (const tab of Array.from(p.getElementsByTagName('w:tab'))) s = '\t' + s;
        return s;
      }).join('\n');
    }

    async function handleFile(file) {
      hideError();
      originalName = file.name;

      if (!/\.docx$/i.test(file.name)) {
        showError('That is not a .docx file. Word 97-2003 .doc is a different format — open it in Word or LibreOffice and save as .docx first.');
        return;
      }

      showProgress(25, 'Reading Word document…');
      try {
        docBytes = await file.arrayBuffer();
        const parts = await readDocxParts(docBytes);
        plainText = extractText(parts.document);

        const pre = document.createElement('pre');
        pre.style.whiteSpace = 'pre-wrap';
        pre.style.fontFamily = 'inherit';
        pre.style.margin = '0';
        pre.textContent = plainText.slice(0, 4000) + (plainText.length > 4000 ? '\n…' : '');
        previewBody.innerHTML = '';
        previewBody.appendChild(pre);

        previewCard.style.display = 'block';
        fileNameDisplay.textContent = file.name;
        actionControls.style.display = 'flex';
        dropZone.style.display = 'none';
      } catch (err) {
        showError('Could not read that Word document. If it opens correctly in Word, try re-saving it as .docx and converting again.');
      }
      hideProgress();
    }

    /* Rasterising the on-screen preview is the last resort: it produces a
       screenshot of the *preview*, not of the document, so it is only ever
       reached when the real renderer has failed. */
    function rasterFallback(pdfName) {
      return window.exportElementToPdf(previewBody, {
        margin: 15,
        filename: pdfName,
        image: { type: 'jpeg', quality: 0.95 },
        pagebreak: { mode: ['avoid-all', 'css', 'legacy'] },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
      });
    }

    btnDownload.addEventListener('click', async () => {
      if (slug === 'docx-to-txt') {
        const blob = new Blob([plainText], { type: 'text/plain;charset=utf-8;' });
        window.downloadBlob(blob, originalName.replace(/\.[^/.]+$/, '') + '.txt', 'text/plain');
        return;
      }

      if (!docBytes) return;
      const pdfName = originalName.replace(/\.[^/.]+$/, '') + '.pdf';
      showProgress(40, 'Rendering PDF…');

      try {
        const parts = await readDocxParts(docBytes);

        /* Substitute faces are fetched only for the categories this document
           actually uses, so an all-Calibri file downloads nothing. */
        const needed = fontsNeeded(parts.document, parts.styles);
        const fontState = await registerPdfmakeFonts(window.pdfMake, needed,
          (msg) => showProgress(55, msg));

        const def = buildDocDefinition(Object.assign({}, parts, {
          fontsReady: fontState.ready,
          title: originalName.replace(/\.[^/.]+$/, ''),
        }));

        if (fontState.failed.length) {
          showError('Could not load the ' + fontState.failed.join(' and ') +
            ' substitute font, so those passages use the default face. The rest of the document is unaffected.');
        }

        showProgress(75, 'Building pages…');

        /* pdfmake can fail asynchronously — it swallows the error inside its
           layout pass and simply never calls back — so a bare getBlob has a
           silent-hang failure mode no try/catch can see. */
        let settled = false;
        const finish = (fn) => { if (!settled) { settled = true; fn(); } };
        const watchdog = setTimeout(() => {
          finish(() => {
            rasterFallback(pdfName)
              .then(() => hideProgress())
              .catch(() => {
                showError('This document took too long to lay out as a PDF. Try splitting it into fewer pages, or use Word → TXT if you only need the text.');
                hideProgress();
              });
          });
        }, 25000);

        window.pdfMake.createPdf(def).getBlob((blob) => {
          clearTimeout(watchdog);
          finish(() => {
            window.downloadBlob(blob, pdfName, 'application/pdf');
            hideProgress();
          });
        });
      } catch (err) {
        rasterFallback(pdfName)
          .then(() => hideProgress())
          .catch(() => {
            showError('This document could not be rendered as a PDF. Try Word → TXT if you only need the text, or re-save the file from Word and try again.');
            hideProgress();
          });
      }
    });

    btnClear.addEventListener('click', () => {
      docBytes = null;
      plainText = '';
      previewCard.style.display = 'none';
      previewBody.innerHTML = '';
      actionControls.style.display = 'none';
      dropZone.style.display = 'flex';
      fileInput.value = '';
    });
  })();
</script>
