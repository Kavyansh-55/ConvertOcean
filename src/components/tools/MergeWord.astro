---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, headline, subtitle } = Astro.props;
---

<style is:global>
  .merge-word-container .file-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    max-height: 300px;
    overflow-y: auto;
  }
  .merge-word-container .file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: var(--colors-canvas-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: 6px;
    font-size: 13px;
  }
  .merge-word-container .icon-btn {
    background: none;
    border: 1px solid var(--colors-hairline);
    border-radius: 4px;
    color: var(--colors-body);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 11px;
    transition: all 0.15s;
  }
  .merge-word-container .icon-btn:hover:not(:disabled) {
    background-color: var(--colors-canvas-soft-2);
    color: var(--colors-ink);
    border-color: var(--colors-hairline-strong);
  }
  .merge-word-container .icon-btn.danger:hover {
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.2);
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span>⚠️</span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing files…</div>
</div>

<div class="workspace-layout merge-word-container">
  <!-- Upload & Arrange List Panel -->
  <div class="panel-card">
    <h3 class="panel-section-title">Upload & Arrange Word Documents</h3>
    
    <div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
      <div class="upload-icon"><CategoryIcon icon="📝" width="40" height="40" /></div>
      <div class="upload-text-primary">Drag and drop Word files here, or click to browse</div>
      <div class="upload-text-secondary">Upload multiple .docx Word files (Max 15MB each)</div>
      <input type="file" id="fileInput" class="file-input" accept=".docx" multiple />
    </div>

    <div id="fileItemsList" class="file-list" style="display: none; margin-top: var(--spacing-md);"></div>
  </div>

  <!-- Settings & Merge Panel -->
  <div class="panel-card">
    <h3 class="panel-section-title">Merge Configuration</h3>
    
    <div class="form-group">
      <label class="form-label" for="mergeOutputName">Output Filename</label>
      <input type="text" id="mergeOutputName" class="form-input" value="merged_document.docx" />
    </div>

    <div class="button-group" style="margin-top: auto; display: flex; gap: var(--spacing-sm);">
      <button class="button button-primary" id="btnMerge" disabled style="flex: 1;">Merge & Download</button>
      <button class="button button-danger" id="btnClear" disabled>Clear Queue</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const fileItemsList = document.getElementById('fileItemsList');
    const mergeOutputName = document.getElementById('mergeOutputName');
    const btnMerge = document.getElementById('btnMerge');
    const btnClear = document.getElementById('btnClear');

    let mergeFiles = [];

    // Drag and drop setup
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('dragover');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      let files = Array.from(e.dataTransfer.files);
      if (files.length > 0) processFiles(files);
    });

    fileInput.addEventListener('change', (e) => {
      let files = Array.from(e.target.files);
      if (files.length > 0) processFiles(files);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }

    // Fix helper since downloadBlob was missing in some layout scopes
    window.downloadBlob = window.downloadBlob || function(blob, name) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    };

    function hideProgress() {
      progressOverlay.style.display = 'none';
    }

    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function processFiles(files) {
      hideError();
      let processed = 0;
      showProgress(10, "Loading Word documents…");

      files.forEach(f => {
        const ext = f.name.split('.').pop().toLowerCase();
        if (ext !== 'docx') {
          showError(`Skipped "${f.name}": Unsupported format. Only .docx is supported.`);
          processed++;
          if (processed === files.length) hideProgress();
          return;
        }

        const reader = new FileReader();
        reader.onload = async function(e) {
          try {
            const bytes = new Uint8Array(e.target.result);
            mergeFiles.push({
              name: f.name,
              bytes: bytes
            });
            processed++;

            if (processed === files.length) {
              fileInput.value = ''; // reset so same file can be re-added
              renderList();
              hideProgress();
            }
          } catch(err) {
            processed++;
            showError("Failed to parse " + f.name);
            hideProgress();
          }
        };
        reader.readAsArrayBuffer(f);
      });
    }

    function renderList() {
      if (mergeFiles.length === 0) {
        fileItemsList.innerHTML = '';
        fileItemsList.style.display = 'none';
        btnMerge.disabled = true;
        btnClear.disabled = true;
        return;
      }

      fileItemsList.innerHTML = '';
      mergeFiles.forEach((file, index) => {
        const div = document.createElement('div');
        div.className = 'file-item';
        div.innerHTML = `
          <span>${file.name}</span>
          <div style="display: flex; gap: 4px;">
            <button class="icon-btn" onclick="window.moveFile(${index}, -1)" ${index === 0 ? 'disabled' : ''}>▲</button>
            <button class="icon-btn" onclick="window.moveFile(${index}, 1)" ${index === mergeFiles.length - 1 ? 'disabled' : ''}>▼</button>
            <button class="icon-btn danger" onclick="window.removeMergeFile(${index})">✕</button>
          </div>
        `;
        fileItemsList.appendChild(div);
      });
      fileItemsList.style.display = 'flex';
      btnMerge.disabled = false;
      btnClear.disabled = false;
    }

    window.moveFile = function(index, direction) {
      const target = index + direction;
      if (target < 0 || target >= mergeFiles.length) return;
      const temp = mergeFiles[index];
      mergeFiles[index] = mergeFiles[target];
      mergeFiles[target] = temp;
      renderList();
    };

    window.removeMergeFile = function(idx) {
      mergeFiles.splice(idx, 1);
      renderList();
    };

    const REL_NS = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
    const REL_PKG_NS = 'http://schemas.openxmlformats.org/package/2006/relationships';
    const CT_NS = 'http://schemas.openxmlformats.org/package/2006/content-types';
    const MIME_BY_EXT = {
      png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif',
      bmp: 'image/bmp', tif: 'image/tiff', tiff: 'image/tiff', emf: 'image/x-emf',
      wmf: 'image/x-wmf', svg: 'image/svg+xml', webp: 'image/webp'
    };

    // Resolve a relationship Target (relative to word/document.xml) to a zip path.
    function resolveRelPath(rel) {
      if (rel.charAt(0) === '/') return rel.slice(1);           // package-absolute
      const stack = ['word'];                                    // dir of document.xml
      for (const part of rel.split('/')) {
        if (part === '..') stack.pop();
        else if (part && part !== '.') stack.push(part);
      }
      return stack.join('/');
    }

    btnMerge.addEventListener('click', async () => {
      if (mergeFiles.length < 2) {
        showError("Please upload at least 2 Word files.");
        return;
      }
      showProgress(20, "Loading base document ZIP structure…");
      try {
        const parser = new DOMParser();
        const serializer = new XMLSerializer();

        // Load the first document as the base we merge into.
        const firstZip = await JSZip.loadAsync(mergeFiles[0].bytes);
        const firstDoc = parser.parseFromString(await firstZip.file("word/document.xml").async("string"), "text/xml");
        const firstBody = firstDoc.getElementsByTagName("w:body")[0];
        const firstSectPr = firstBody.getElementsByTagName("w:sectPr")[0];

        // Base relationships (.rels) — where image/hyperlink references live.
        const baseRelsFile = firstZip.file("word/_rels/document.xml.rels");
        const baseRelsDoc = parser.parseFromString(
          baseRelsFile ? await baseRelsFile.async("string")
            : '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"></Relationships>',
          "application/xml"
        );
        const baseRelsRoot = baseRelsDoc.documentElement;
        let maxRid = 0;
        for (const rel of Array.from(baseRelsDoc.getElementsByTagName("Relationship"))) {
          const m = /rId(\d+)/.exec(rel.getAttribute("Id") || "");
          if (m) maxRid = Math.max(maxRid, parseInt(m[1]));
        }

        // Content types — image extensions must be declared or Word rejects the file.
        const ctDoc = parser.parseFromString(await firstZip.file("[Content_Types].xml").async("string"), "application/xml");
        const ctRoot = ctDoc.documentElement;
        const knownExts = new Set(Array.from(ctDoc.getElementsByTagName("Default")).map(d => (d.getAttribute("Extension") || "").toLowerCase()));
        const usedMediaNames = new Set(Object.keys(firstZip.files).filter(n => /^word\/media\//.test(n)).map(n => n.split('/').pop()));

        const ensureDefault = (ext) => {
          ext = ext.toLowerCase();
          if (knownExts.has(ext) || !MIME_BY_EXT[ext]) return;
          // createElementNS so the element stays in the content-types namespace;
          // a plain createElement lands it in the null namespace and serializes
          // with xmlns="", which invalidates the part.
          const d = ctDoc.createElementNS(CT_NS, "Default");
          d.setAttribute("Extension", ext);
          d.setAttribute("ContentType", MIME_BY_EXT[ext]);
          ctRoot.appendChild(d);
          knownExts.add(ext);
        };
        const addRel = (type, target, external) => {
          const id = "rId" + (++maxRid);
          const rel = baseRelsDoc.createElementNS(REL_PKG_NS, "Relationship");
          rel.setAttribute("Id", id);
          rel.setAttribute("Type", type);
          rel.setAttribute("Target", target);
          if (external) rel.setAttribute("TargetMode", "External");
          baseRelsRoot.appendChild(rel);
          return id;
        };
        // Gather every relationship reference (r:embed / r:id / r:link) in a subtree.
        const collectRefs = (node, out) => {
          if (node.nodeType !== 1) return;
          for (const attr of Array.from(node.attributes)) {
            if (attr.namespaceURI === REL_NS && attr.value) out.push({ el: node, local: attr.localName, oldId: attr.value });
          }
          for (const child of Array.from(node.childNodes)) collectRefs(child, out);
        };

        for (let i = 1; i < mergeFiles.length; i++) {
          showProgress(20 + Math.round((i / mergeFiles.length) * 55), `Merging document ${i + 1} of ${mergeFiles.length}…`);
          const zip = await JSZip.loadAsync(mergeFiles[i].bytes);
          const xmlDoc = parser.parseFromString(await zip.file("word/document.xml").async("string"), "text/xml");
          const body = xmlDoc.getElementsByTagName("w:body")[0];

          // Source relationships for this document.
          const srcRelsFile = zip.file("word/_rels/document.xml.rels");
          const srcRels = new Map();
          if (srcRelsFile) {
            const srcRelsDoc = parser.parseFromString(await srcRelsFile.async("string"), "application/xml");
            for (const rel of Array.from(srcRelsDoc.getElementsByTagName("Relationship"))) {
              srcRels.set(rel.getAttribute("Id"), {
                type: rel.getAttribute("Type"),
                target: rel.getAttribute("Target"),
                external: (rel.getAttribute("TargetMode") || "Internal") === "External"
              });
            }
          }

          // Page break before each appended document.
          const pageBreakNode = firstDoc.createElement("w:p");
          const rNode = firstDoc.createElement("w:r");
          const brNode = firstDoc.createElement("w:br");
          brNode.setAttribute("w:type", "page");
          rNode.appendChild(brNode);
          pageBreakNode.appendChild(rNode);
          if (firstSectPr) firstBody.insertBefore(pageBreakNode, firstSectPr);
          else firstBody.appendChild(pageBreakNode);

          // Import body elements (skip the trailing sectPr), tracking the copies.
          const imported = [];
          for (const node of Array.from(body.childNodes)) {
            if (node.nodeType === 1 && node.nodeName !== "w:sectPr") {
              const copy = firstDoc.importNode(node, true);
              if (firstSectPr) firstBody.insertBefore(copy, firstSectPr);
              else firstBody.appendChild(copy);
              imported.push(copy);
            }
          }

          // Remap this document's relationship references: copy media into the
          // base package under fresh names, register new relationship ids and
          // content types, then rewrite the references to the new ids.
          const refs = [];
          for (const node of imported) collectRefs(node, refs);
          const remap = new Map();
          for (const ref of refs) {
            if (remap.has(ref.oldId)) continue;
            const rel = srcRels.get(ref.oldId);
            if (!rel) continue;
            if (rel.external) {
              remap.set(ref.oldId, addRel(rel.type, rel.target, true));
            } else {
              const srcPath = resolveRelPath(rel.target);
              const srcFile = zip.file(srcPath);
              if (!srcFile) continue;
              const ext = (srcPath.split('.').pop() || 'bin').toLowerCase();
              let newName = `merge${i}_${ref.oldId}.${ext}`;
              while (usedMediaNames.has(newName)) newName = `merge${i}_${Math.random().toString(36).slice(2, 7)}.${ext}`;
              usedMediaNames.add(newName);
              firstZip.file("word/media/" + newName, await srcFile.async("uint8array"));
              ensureDefault(ext);
              remap.set(ref.oldId, addRel(rel.type, "media/" + newName, false));
            }
          }
          for (const ref of refs) {
            const newId = remap.get(ref.oldId);
            if (newId) ref.el.setAttributeNS(REL_NS, "r:" + ref.local, newId);
          }
        }

        // Drawing-object ids (wp:docPr / pic:cNvPr) must be unique across the
        // whole document; each source file numbered its own from 1, so after
        // merging there are duplicates and Word reports the file as corrupt.
        // Renumber every one sequentially.
        let drawingId = 0;
        const uniquifyIds = (node) => {
          if (node.nodeType !== 1) return;
          if ((node.localName === "docPr" || node.localName === "cNvPr") && node.hasAttribute("id")) {
            node.setAttribute("id", String(++drawingId));
          }
          for (const child of Array.from(node.childNodes)) uniquifyIds(child);
        };
        uniquifyIds(firstBody);

        showProgress(88, "Saving merged Word archive…");
        firstZip.file("word/document.xml", serializer.serializeToString(firstDoc));
        firstZip.file("word/_rels/document.xml.rels", serializer.serializeToString(baseRelsDoc));
        firstZip.file("[Content_Types].xml", serializer.serializeToString(ctDoc));

        const outBytes = await firstZip.generateAsync({ type: "blob" });
        let name = mergeOutputName.value || 'merged.docx';
        if (!name.endsWith('.docx')) name += '.docx';

        window.downloadBlob(outBytes, name, "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
      } catch(err) {
        showError("Failed to merge Word documents. Please ensure none of the files are corrupted.");
      }
      hideProgress();
    });

    btnClear.addEventListener('click', resetFile);

    function resetFile() {
      mergeFiles = [];
      renderList();
      fileInput.value = '';
      hideProgress();
      hideError();
    }
  })();
</script>
