---
import { t } from '../../i18n/ui';
const { slug, headline, subtitle, lang = 'en'} = Astro.props;
/* Indonesian pages open in Rupiah, at Rupiah scale (same ratios: BEP 200 unit). */
const isId = lang === 'id';
const k = isId ? 1000 : 1;
---

<style>
  .calc-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }
  @media (max-width: 900px) {
    .calc-workspace { grid-template-columns: 1fr; }
  }
  .calc-panel {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    /* elevation removed — separation comes from colour, not shadow */
  }
  .calc-panel-title {
    font-size: 13px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: var(--colors-mute);
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: var(--spacing-xs);
  }
  .mode-tabs {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }
  .mode-tab {
    padding: 8px 16px;
    border-radius: var(--rounded-pill);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas);
    color: var(--colors-body);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .mode-tab:hover { border-color: var(--colors-hairline-strong); }
  .mode-tab.active {
    background-color: var(--colors-action);
    color: var(--colors-action-ink);
    border-color: var(--colors-action);
    font-weight: var(--fw-bold);
  }
  .result-card {
    background-color: var(--colors-canvas-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-xs) 0;
    border-bottom: 1px solid var(--colors-hairline);
  }
  .result-row:last-child { border-bottom: none; }
  .result-label {
    font-size: 14px;
    color: var(--colors-body);
  }
  .result-value {
    font-size: 16px;
    font-weight: var(--fw-bold);
    color: var(--colors-ink);
    font-family: var(--font-sans);
  }
  .result-value.highlight {
    font-size: 24px;
    color: var(--colors-link);
  }
  .be-bar-container {
    width: 100%;
    height: 32px;
    border-radius: var(--rounded-md);
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    overflow: hidden;
    display: flex;
    position: relative;
  }
  .be-bar-var {
    height: 100%;
    background-color: var(--p-saffron);
    display: flex;
    align-items: center;
    justify-content: center;
    /* 12px. It sits inside a 32px bar with room to spare, and a label a
       reader is meant to read off a chart is held to the same floor as body
       text — more so here, because it is set on a saturated fill. */
    font-size: 12px;
    font-weight: var(--fw-bold);
    /* Dark, and static: this fill does not change with the theme, so the label
       must not either. White measured 3.27:1 on the red end and 1.54:1 on the
       amber. */
    color: var(--colors-ink-static);
    transition: width 0.4s cubic-bezier(0.16,1,0.3,1);
    min-width: 30px;
  }
  .be-bar-cm {
    height: 100%;
    background: var(--colors-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: var(--fw-bold);
    color: #fff;
    transition: width 0.4s cubic-bezier(0.16,1,0.3,1);
    min-width: 30px;
  }
  /* The accent lightens in dark mode (#2E96B0), so the white label that clears
     AA on the light accent (5.36:1) falls to 3.44:1. Flipping the label dark
     gives 5.76:1. --colors-ink would NOT do it: it inverts to #f5f5f5 in dark
     and measures 3.15:1, worse than the white it replaces. :global() on the
     ancestor is required - <html> carries data-theme but not this component's
     scope id, so a bare selector would compile to nothing. */
  :global([data-theme="dark"]) .be-bar-cm {
    color: var(--colors-canvas);
  }

  .formula-box {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    padding: var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--colors-body);
    line-height: 1.8;
  }
</style>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<div class="calc-workspace">
  <div class="calc-panel">
    <div class="calc-panel-title">{t('Calculation Mode', lang)}</div>
    <div class="mode-tabs">
      <button class="mode-tab active" aria-pressed="true" data-mode="units" id="beTabUnits">{t('Break-Even Point', lang)}</button>
      <button class="mode-tab" aria-pressed="false" data-mode="profit" id="beTabProfit">{t('Units for Target Profit', lang)}</button>
      <button class="mode-tab" aria-pressed="false" data-mode="price" id="beTabPrice">{t('Required Price', lang)}</button>
    </div>

    <div class="calc-panel-title">{t('Currency & Values', lang)}</div>
    <div class="form-group" style="margin-bottom: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xxs);">
      <label class="form-label" for="beCurrency" style="font-size: 13px; font-weight: 500;">{t('Currency', lang)}</label>
      <select id="beCurrency" class="select-input" style="height: 40px; border-radius: 6px; border: 1px solid var(--colors-hairline); padding: 0 var(--spacing-sm); font-size: 14px; background-color: var(--colors-canvas); color: var(--colors-ink);">
        <option value="$" selected={!isId}>{t('$ – US Dollar (USD)', lang)}</option>
        <option value="Rp" selected={isId}>{t('Rp – Indonesian Rupiah (IDR)', lang)}</option>
        <option value="€">{t('€ – Euro (EUR)', lang)}</option>
        <option value="£">{t('£ – British Pound (GBP)', lang)}</option>
        <option value="₹">{t('₹ – Indian Rupee (INR)', lang)}</option>
        <option value="¥">{t('¥ – Japanese Yen (JPY)', lang)}</option>
        <option value="¥">{t('¥ – Chinese Yuan (CNY)', lang)}</option>
        <option value="C$">{t('C$ – Canadian Dollar (CAD)', lang)}</option>
        <option value="A$">{t('A$ – Australian Dollar (AUD)', lang)}</option>
        <option value="CHF">{t('CHF – Swiss Franc (CHF)', lang)}</option>
        <option value="AED">{t('AED – UAE Dirham (AED)', lang)}</option>
        <option value="SGD">{t('SGD – Singapore Dollar (SGD)', lang)}</option>
        <option value="R">{t('R – South African Rand (ZAR)', lang)}</option>
        <option value="zł">{t('zł – Polish Złoty (PLN)', lang)}</option>
        <option value="₩">{t('₩ – South Korean Won (KRW)', lang)}</option>
      </select>
    </div>

    <div class="calc-panel-title">{t('Enter Values', lang)}</div>

    <div id="beFieldsUnits">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="beFixed1" id="beLblFixed1">{t('Total Fixed Costs ($)', lang)}</label>
        <input type="number" id="beFixed1" class="form-input" value={5000 * k} min="0" step="0.01" />
      </div>
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="beVar1" id="beLblVar1">{t('Variable Cost per Unit ($)', lang)}</label>
        <input type="number" id="beVar1" class="form-input" value={14 * k} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="bePrice1" id="beLblPrice1">{t('Selling Price per Unit ($)', lang)}</label>
        <input type="number" id="bePrice1" class="form-input" value={39 * k} min="0" step="0.01" />
      </div>
    </div>

    <div id="beFieldsProfit" style="display:none;">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="beFixed2" id="beLblFixed2">{t('Total Fixed Costs ($)', lang)}</label>
        <input type="number" id="beFixed2" class="form-input" value={5000 * k} min="0" step="0.01" />
      </div>
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="beVar2" id="beLblVar2">{t('Variable Cost per Unit ($)', lang)}</label>
        <input type="number" id="beVar2" class="form-input" value={14 * k} min="0" step="0.01" />
      </div>
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="bePrice2" id="beLblPrice2">{t('Selling Price per Unit ($)', lang)}</label>
        <input type="number" id="bePrice2" class="form-input" value={39 * k} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="beProfit2" id="beLblProfit2">{t('Target Profit ($)', lang)}</label>
        <input type="number" id="beProfit2" class="form-input" value={2500 * k} min="0" step="0.01" />
      </div>
    </div>

    <div id="beFieldsPrice" style="display:none;">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="beFixed3" id="beLblFixed3">{t('Total Fixed Costs ($)', lang)}</label>
        <input type="number" id="beFixed3" class="form-input" value={5000 * k} min="0" step="0.01" />
      </div>
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="beVar3" id="beLblVar3">{t('Variable Cost per Unit ($)', lang)}</label>
        <input type="number" id="beVar3" class="form-input" value={14 * k} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="beUnits3">{t('Expected Units Sold', lang)}</label>
        <input type="number" id="beUnits3" class="form-input" value="400" min="1" step="1" />
      </div>
    </div>

    <button class="button button-primary" id="beCalcBtn" style="align-self: flex-start;">{t('Calculate', lang)}</button>
  </div>

  <div class="calc-panel">
    <div class="calc-panel-title">{t('Results', lang)}</div>

    <div class="result-card" id="beResults">
      <div class="result-row">
        <span class="result-label" id="beResMainLbl">{t('Break-Even Point', lang)}</span>
        <span class="result-value highlight" id="beResMain">{t('200 units', lang)}</span>
      </div>
      <div class="result-row">
        <span class="result-label" id="beResRevenueLbl">{t('Break-Even Revenue', lang)}</span>
        <span class="result-value" id="beResRevenue">$7,800.00</span>
      </div>
      <div class="result-row">
        <span class="result-label">{t('Contribution Margin / Unit', lang)}</span>
        <span class="result-value" id="beResCM">$25.00</span>
      </div>
      <div class="result-row">
        <span class="result-label">{t('Contribution Margin Ratio', lang)}</span>
        <span class="result-value" id="beResRatio">64.10%</span>
      </div>
    </div>

    <div class="calc-panel-title" style="margin-top: var(--spacing-sm);">{t('Where Each Sales Dollar Goes', lang)}</div>
    <div class="be-bar-container">
      <div class="be-bar-var" id="beBarVar" style="width:36%;">{t('Variable 36%', lang)}</div>
      <div class="be-bar-cm" id="beBarCM" style="width:64%;">{t('Contribution 64%', lang)}</div>
    </div>

    <div class="calc-panel-title" style="margin-top: var(--spacing-sm);">{t('Formula Used', lang)}</div>
    <div class="formula-box" id="beFormula">
      {t('Contribution Margin = Price − Variable Cost = $39.00 − $14.00 = $25.00', lang)}<br/>
      {t('Break-Even Units = Fixed Costs ÷ Contribution Margin = $5,000.00 ÷ $25.00 = 200 units', lang)}<br/>
      {t('Break-Even Revenue = Break-Even Units × Price = 200 × $39.00 = $7,800.00', lang)}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const $ = id => document.getElementById(id);
    let mode = 'units';
    let currSym = $('beCurrency').value;

    // Currency selector
    $('beCurrency').addEventListener('change', function() {
      currSym = this.value;
      updateCurrencyLabels();
      calculate();
    });

    function updateCurrencyLabels() {
      ['beLblFixed1','beLblFixed2','beLblFixed3'].forEach(id => { $(id).textContent = __tf('Total Fixed Costs ({0})', currSym); });
      ['beLblVar1','beLblVar2','beLblVar3'].forEach(id => { $(id).textContent = __tf('Variable Cost per Unit ({0})', currSym); });
      ['beLblPrice1','beLblPrice2'].forEach(id => { $(id).textContent = __tf('Selling Price per Unit ({0})', currSym); });
      $('beLblProfit2').textContent = __tf('Target Profit ({0})', currSym);
    }

    const tabs = document.querySelectorAll('.mode-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
        tab.classList.add('active');
        tab.setAttribute('aria-pressed', 'true');
        mode = tab.dataset.mode;
        $('beFieldsUnits').style.display = mode === 'units' ? 'block' : 'none';
        $('beFieldsProfit').style.display = mode === 'profit' ? 'block' : 'none';
        $('beFieldsPrice').style.display = mode === 'price' ? 'block' : 'none';
        calculate();
      });
    });

    /* Indonesian pages: "Rp 7.800.000" — Rupiah without cents, Indonesian
       grouping for every currency. */
    const ID_MONEY = document.documentElement.lang === 'id';
    function fmt(n) {
      if (ID_MONEY) {
        const d = currSym === 'Rp' ? 0 : 2;
        return currSym + ' ' + n.toLocaleString('id-ID', { minimumFractionDigits: d, maximumFractionDigits: d });
      }
      return currSym + n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function fmtUnits(n) { const u = Math.ceil(n); return __tf(u === 1 ? '{0} unit' : '{0} units', u.toLocaleString()); }

    function setBar(varCost, price) {
      const container = $('beBarVar').parentElement;
      if (price <= 0 || varCost >= price) {
        $('beBarVar').style.width = '100%';
        $('beBarVar').textContent = __t('No contribution — price does not exceed variable cost');
        $('beBarCM').style.width = '0%';
        $('beBarCM').textContent = '';
        container.setAttribute('aria-label', __t('No contribution margin: price does not exceed variable cost'));
        return;
      }
      const varPct = Math.max(5, (varCost / price) * 100);
      const cmPct = Math.max(5, 100 - varPct);
      $('beBarVar').style.width = varPct + '%';
      $('beBarVar').textContent = __tf('Variable {0}%', Math.round(varPct));
      $('beBarCM').style.width = cmPct + '%';
      $('beBarCM').textContent = __tf('Contribution {0}%', Math.round(cmPct));
      container.setAttribute('aria-label', __tf('Each unit of sales: {0}% variable cost, {1}% contribution margin', Math.round(varPct), Math.round(cmPct)));
    }

    function showInvalid(message) {
      $('beResMain').textContent = '—';
      $('beResRevenue').textContent = '—';
      $('beResCM').textContent = '—';
      $('beResRatio').textContent = '—';
      $('beFormula').innerHTML = message;
    }

    function calculate() {
      if (mode === 'units') {
        $('beResMainLbl').textContent = __t('Break-Even Point');
        $('beResRevenueLbl').textContent = __t('Break-Even Revenue');
        const fixed = parseFloat($('beFixed1').value) || 0;
        const varCost = parseFloat($('beVar1').value) || 0;
        const price = parseFloat($('bePrice1').value) || 0;
        const cm = price - varCost;
        setBar(varCost, price);
        if (price <= 0 || cm <= 0) {
          showInvalid(__t('Break-even is not reachable: the selling price per unit must be greater than the variable cost per unit. Raise the price or reduce the variable cost.'));
          if (price > 0) {
            $('beResCM').textContent = fmt(cm);
            $('beResRatio').textContent = ((cm / price) * 100).toFixed(2) + '%';
          }
          return;
        }
        const exactUnits = fixed / cm;
        const units = Math.ceil(exactUnits);
        const revenue = units * price;
        const ratio = (cm / price) * 100;
        $('beResMain').textContent = fmtUnits(exactUnits);
        $('beResRevenue').textContent = fmt(revenue);
        $('beResCM').textContent = fmt(cm);
        $('beResRatio').textContent = ratio.toFixed(2) + '%';
        const roundNote = Number.isInteger(exactUnits) ? '' : ' ' + __tf('(exactly {0}, rounded up)', exactUnits.toFixed(2));
        $('beFormula').innerHTML = [
          __tf('Contribution Margin = Price − Variable Cost = {0} − {1} = {2}', fmt(price), fmt(varCost), fmt(cm)),
          __tf('Break-Even Units = Fixed Costs ÷ Contribution Margin = {0} ÷ {1} = {2}', fmt(fixed), fmt(cm), fmtUnits(units)) + roundNote,
          __tf('Break-Even Revenue = Break-Even Units × Price = {0} × {1} = {2}', units.toLocaleString(), fmt(price), fmt(revenue)),
        ].join('<br/>');
      } else if (mode === 'profit') {
        $('beResMainLbl').textContent = __t('Units for Target Profit');
        $('beResRevenueLbl').textContent = __t('Revenue Required');
        const fixed = parseFloat($('beFixed2').value) || 0;
        const varCost = parseFloat($('beVar2').value) || 0;
        const price = parseFloat($('bePrice2').value) || 0;
        const target = parseFloat($('beProfit2').value) || 0;
        const cm = price - varCost;
        setBar(varCost, price);
        if (price <= 0 || cm <= 0) {
          showInvalid(__t('The target is not reachable: the selling price per unit must be greater than the variable cost per unit. Raise the price or reduce the variable cost.'));
          if (price > 0) {
            $('beResCM').textContent = fmt(cm);
            $('beResRatio').textContent = ((cm / price) * 100).toFixed(2) + '%';
          }
          return;
        }
        const exactUnits = (fixed + target) / cm;
        const units = Math.ceil(exactUnits);
        const revenue = units * price;
        const ratio = (cm / price) * 100;
        $('beResMain').textContent = fmtUnits(exactUnits);
        $('beResRevenue').textContent = fmt(revenue);
        $('beResCM').textContent = fmt(cm);
        $('beResRatio').textContent = ratio.toFixed(2) + '%';
        const roundNote = Number.isInteger(exactUnits) ? '' : ' ' + __tf('(exactly {0}, rounded up)', exactUnits.toFixed(2));
        $('beFormula').innerHTML = [
          __tf('Contribution Margin = Price − Variable Cost = {0} − {1} = {2}', fmt(price), fmt(varCost), fmt(cm)),
          __tf('Units Required = (Fixed Costs + Target Profit) ÷ Contribution Margin = ({0} + {1}) ÷ {2} = {3}', fmt(fixed), fmt(target), fmt(cm), fmtUnits(units)) + roundNote,
          __tf('Revenue Required = Units × Price = {0} × {1} = {2}', units.toLocaleString(), fmt(price), fmt(revenue)),
        ].join('<br/>');
      } else {
        $('beResMainLbl').textContent = __t('Required Price per Unit');
        $('beResRevenueLbl').textContent = __t('Revenue at Break-Even');
        const fixed = parseFloat($('beFixed3').value) || 0;
        const varCost = parseFloat($('beVar3').value) || 0;
        const units = parseFloat($('beUnits3').value) || 0;
        if (units <= 0) {
          setBar(1, 0);
          showInvalid(__t('Enter the number of units you expect to sell (at least 1) to compute the price needed to break even.'));
          return;
        }
        const cm = fixed / units;
        const price = varCost + cm;
        const revenue = price * units;
        const ratio = price > 0 ? (cm / price) * 100 : 0;
        setBar(varCost, price);
        $('beResMain').textContent = fmt(price);
        $('beResRevenue').textContent = fmt(revenue);
        $('beResCM').textContent = fmt(cm);
        $('beResRatio').textContent = ratio.toFixed(2) + '%';
        $('beFormula').innerHTML = [
          __tf('Required Contribution / Unit = Fixed Costs ÷ Units = {0} ÷ {1} = {2}', fmt(fixed), units.toLocaleString(), fmt(cm)),
          __tf('Required Price = Variable Cost + Required Contribution = {0} + {1} = {2}', fmt(varCost), fmt(cm), fmt(price)),
          __tf('Revenue at Break-Even = Price × Units = {0} × {1} = {2}', fmt(price), units.toLocaleString(), fmt(revenue)),
        ].join('<br/>');
      }
    }

    $('beCalcBtn').addEventListener('click', calculate);
    ['beFixed1','beVar1','bePrice1','beFixed2','beVar2','bePrice2','beProfit2','beFixed3','beVar3','beUnits3'].forEach(id => {
      $(id).addEventListener('input', calculate);
    });

    updateCurrencyLabels();
    window.addEventListener('load', calculate);
  })();
</script>
