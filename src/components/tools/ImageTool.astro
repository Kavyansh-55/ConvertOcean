---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, name, headline, subtitle } = Astro.props;

// Determine file inputs accept attribute and output format details
let acceptMime = "image/*";
let targetFormat = "PNG";
if (slug === 'png-to-jpg') {
  acceptMime = "image/png";
  targetFormat = "JPG";
} else if (slug === 'jpg-to-png') {
  acceptMime = "image/jpeg,image/jpg";
  targetFormat = "PNG";
} else if (slug === 'png-to-webp') {
  acceptMime = "image/png";
  targetFormat = "WEBP";
} else if (slug === 'webp-to-png') {
  acceptMime = "image/webp";
  targetFormat = "PNG";
} else if (slug === 'jpg-to-webp') {
  acceptMime = "image/jpeg,image/jpg";
  targetFormat = "WEBP";
} else if (slug === 'webp-to-jpg') {
  acceptMime = "image/webp";
  targetFormat = "JPG";
} else if (slug === 'svg-to-png') {
  acceptMime = "image/svg+xml";
  targetFormat = "PNG";
} else if (slug === 'svg-to-jpg') {
  acceptMime = "image/svg+xml";
  targetFormat = "JPG";
} else if (slug === 'svg-to-webp') {
  acceptMime = "image/svg+xml";
  targetFormat = "WEBP";
} else if (slug === 'jpg-to-jpeg') {
  acceptMime = "image/jpeg,image/jpg";
  targetFormat = "JPEG";
} else if (slug === 'jpeg-to-jpg') {
  acceptMime = "image/jpeg,image/jpg";
  targetFormat = "JPG";
} else if (slug === 'avif-to-jpg') {
  acceptMime = "image/avif,.avif";
  targetFormat = "JPG";
} else if (slug === 'avif-to-png') {
  acceptMime = "image/avif,.avif";
  targetFormat = "PNG";
}
---

<style>
  .img-preview-box {
    max-width: 100%;
    max-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--rounded-md);
    border: 1px solid var(--colors-hairline);
    background: #1e1e1e;
    overflow: hidden;
    margin-top: var(--spacing-lg);
  }
  .img-preview {
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
  }
</style>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span>⚠️</span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="🖼️" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">Image file (Max 15MB)</div>
  <input type="file" id="fileInput" class="file-input" accept={acceptMime} />
</div>

<div id="previewBox" class="img-preview-box" style="display: none;">
  <img id="imgPreview" class="img-preview" alt="Converted Preview" />
</div>

<div id="actionControls" class="panel-card" style="display: none; margin-top: var(--spacing-md); flex-direction: row; justify-content: space-between; align-items: center;">
  <span id="fileNameDisplay" style="font-weight:600; font-size:14px;"></span>
  <div class="button-group">
    <button class="button button-primary" id="btnDownload">Download {targetFormat}</button>
    <button class="button button-danger" id="btnClear">Clear</button>
  </div>
</div>

<script is:inline define:vars={{ slug, targetFormat }}>
  (function() {
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const previewBox = document.getElementById('previewBox');
    const imgPreview = document.getElementById('imgPreview');
    const actionControls = document.getElementById('actionControls');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const btnDownload = document.getElementById('btnDownload');
    const btnClear = document.getElementById('btnClear');

    let outBlob = null;
    let originalName = '';

    // Drag and drop setup
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('dragover');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      let files = Array.from(e.dataTransfer.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e) => {
      let files = Array.from(e.target.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }

    function hideProgress() {
      progressOverlay.style.display = 'none';
    }

    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function handleFile(file) {
      hideError();
      originalName = file.name;
      const extension = file.name.split('.').pop().toLowerCase();

      // Simple verification
      if (slug === 'png-to-jpg' && extension !== 'png') {
        showError("Invalid file type. Please choose a PNG file.");
        return;
      }
      if (slug === 'jpg-to-png' && !['jpg', 'jpeg'].includes(extension)) {
        showError("Invalid file type. Please choose a JPG or JPEG file.");
        return;
      }
      if (slug === 'png-to-webp' && extension !== 'png') {
        showError("Invalid file type. Please choose a PNG file.");
        return;
      }
      if (slug === 'webp-to-png' && extension !== 'webp') {
        showError("Invalid file type. Please choose a WebP file.");
        return;
      }
      if (slug === 'jpg-to-webp' && !['jpg', 'jpeg'].includes(extension)) {
        showError("Invalid file type. Please choose a JPG or JPEG file.");
        return;
      }
      if (slug === 'webp-to-jpg' && extension !== 'webp') {
        showError("Invalid file type. Please choose a WebP file.");
        return;
      }
      if (['svg-to-png', 'svg-to-jpg', 'svg-to-webp'].includes(slug) && extension !== 'svg') {
        showError("Invalid file type. Please choose an SVG file.");
        return;
      }
      if (['jpg-to-jpeg', 'jpeg-to-jpg'].includes(slug) && !['jpg', 'jpeg'].includes(extension)) {
        showError("Invalid file type. Please choose a JPG or JPEG file.");
        return;
      }
      if (['avif-to-jpg', 'avif-to-png'].includes(slug) && extension !== 'avif') {
        showError("Invalid file type. Please choose an AVIF file.");
        return;
      }

      showProgress(30, "Loading image bytes…");
      const isAvif = ['avif-to-jpg', 'avif-to-png'].includes(slug);
      const img = new Image();
      img.onload = function() {
          if (isAvif) URL.revokeObjectURL(img.src);
          showProgress(70, "Rendering and converting format…");

          let mimeType = 'image/png';
          if (['png-to-jpg', 'webp-to-jpg', 'svg-to-jpg', 'jpeg-to-jpg', 'jpg-to-jpeg', 'avif-to-jpg'].includes(slug)) {
            mimeType = 'image/jpeg';
          } else if (['png-to-webp', 'jpg-to-webp', 'svg-to-webp'].includes(slug)) {
            mimeType = 'image/webp';
          }
          const isJpeg = mimeType === 'image/jpeg';
          const isSvg = ['svg-to-png', 'svg-to-jpg', 'svg-to-webp'].includes(slug);

          // Output dimensions. SVGs frequently report a zero or tiny intrinsic
          // size, which produced a blank or blurry raster; give them a sensible
          // resolution and upscale small ones so lines stay crisp.
          let w = img.naturalWidth || img.width;
          let h = img.naturalHeight || img.height;
          if (isSvg) {
            if (!w || !h) { w = 1024; h = 768; }
            const minSide = Math.min(w, h);
            if (minSide < 1024) { const s = 1024 / minSide; w = Math.round(w * s); h = Math.round(h * s); }
            const maxSide = Math.max(w, h);
            if (maxSide > 4096) { const s = 4096 / maxSide; w = Math.round(w * s); h = Math.round(h * s); }
          }
          if (!w || !h) { showError("Could not read the image dimensions."); hideProgress(); return; }

          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          // JPEG has no alpha channel: without a fill, transparent pixels turn
          // black. Lay down white first so transparent PNG/WebP/SVG areas match
          // what other converters produce.
          if (isJpeg) {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, w, h);
          }
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.drawImage(img, 0, 0, w, h);

          canvas.toBlob(blob => {
            if (!blob) { showError("This format could not be encoded in your browser."); hideProgress(); return; }
            outBlob = blob;
            imgPreview.src = URL.createObjectURL(blob);
            previewBox.style.display = 'flex';
            fileNameDisplay.textContent = file.name;
            actionControls.style.display = 'flex';
            dropZone.style.display = 'none';
            hideProgress();
          }, mimeType, 0.92);
      };
      img.onerror = function() {
        if (img.src) URL.revokeObjectURL(img.src);
        if (isAvif) {
          showError("Your browser could not decode this AVIF file. AVIF needs Chrome/Edge 85+, Firefox 93+, or Safari 16.4+ — on an older browser, try updating it first. If your browser is current, the file itself may be damaged.");
        } else {
          showError("Failed to parse image data.");
        }
        hideProgress();
      };
      if (isAvif) {
        // Windows often has no MIME registration for .avif, so file.type comes
        // back empty and a data URL would carry application/octet-stream —
        // which the image decoder rejects. Force the type via a Blob URL.
        img.src = URL.createObjectURL(new Blob([file], { type: 'image/avif' }));
      } else {
        const reader = new FileReader();
        reader.onload = function(e) { img.src = e.target.result; };
        reader.readAsDataURL(file);
      }
    }

    btnDownload.addEventListener('click', () => {
      let ext = targetFormat.toLowerCase();
      if (ext === 'jpg') ext = 'jpg';
      const outName = originalName.replace(/\.[^/.]+$/, "") + '.' + ext;
      window.downloadBlob(outBlob, outName, outBlob.type);
    });

    btnClear.addEventListener('click', () => {
      outBlob = null;
      previewBox.style.display = 'none';
      actionControls.style.display = 'none';
      dropZone.style.display = 'flex';
      fileInput.value = '';
    });
  })();
</script>
