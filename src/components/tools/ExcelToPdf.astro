---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, headline, subtitle } = Astro.props;
---

<style>
  .preview-card {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    min-height: 200px;
    max-height: 400px;
    overflow: auto;
    margin-top: var(--spacing-lg);
  }
  .sheet-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: var(--spacing-sm) var(--spacing-lg);
    border-bottom: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas-soft);
  }
  .sheet-tab {
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--colors-hairline);
    background: none;
    color: var(--colors-body);
    cursor: pointer;
  }
  .sheet-tab.active {
    background-color: var(--colors-ink);
    color: var(--colors-canvas);
    border-color: var(--colors-ink);
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span class="banner-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="📊" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">XLS, XLSX, or CSV (Max 25MB)</div>
  <button type="button" class="upload-cta">Choose file</button>
  <input type="file" id="fileInput" class="file-input" accept=".xlsx,.xls,.csv" />
</div>

<!-- Preview Panel -->
<div id="previewCard" class="preview-card" style="display: none;">
  <div id="sheetTabs" class="sheet-tabs"></div>
  <div id="previewBody" class="preview-body" style="padding: var(--spacing-lg);"></div>
</div>

<!-- Options -->
<div id="optionsRow" class="panel-card" style="display: none; margin-top: var(--spacing-md); flex-direction: row; gap: var(--spacing-lg); align-items: center; flex-wrap: wrap;">
  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
    <input type="checkbox" id="optHeader" checked /> First row is a header
  </label>
  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
    <input type="checkbox" id="optLandscape" checked /> Landscape orientation
  </label>
  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
    <input type="checkbox" id="optAllSheets" checked /> Include all sheets
  </label>
</div>

<div id="actionControls" class="panel-card" style="display: none; margin-top: var(--spacing-md); flex-direction: row; justify-content: space-between; align-items: center;">
  <span id="fileNameDisplay" style="font-weight:600; font-size:14px;"></span>
  <div class="button-group">
    <button class="button button-primary" id="btnConvert">Convert & Download PDF</button>
    <button class="button button-danger" id="btnClear">Clear</button>
  </div>
</div>

<script>
  import { parseCsv, readXlsxFills, readXlsxColWidths, decodeRef, diagnoseSpreadsheet } from '../../scripts/tabular.js';
  import { prepareFonts } from '../../scripts/pdf-fonts.js';

  (function() {
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const previewCard = document.getElementById('previewCard');
    const previewBody = document.getElementById('previewBody');
    const sheetTabs = document.getElementById('sheetTabs');
    const optionsRow = document.getElementById('optionsRow');
    const optHeader = document.getElementById('optHeader');
    const optLandscape = document.getElementById('optLandscape');
    const optAllSheets = document.getElementById('optAllSheets');
    const actionControls = document.getElementById('actionControls');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const btnConvert = document.getElementById('btnConvert');
    const btnClear = document.getElementById('btnClear');

    let originalName = '';
    let sheets = []; // [{ name, rows: string[][] }]

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('dragover');
      }, false);
    });
    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('dragover');
      }, false);
    });
    dropZone.addEventListener('drop', (e) => {
      const files = Array.from(e.dataTransfer.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });
    fileInput.addEventListener('change', (e) => {
      const files = Array.from(e.target.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }
    function hideProgress() { progressOverlay.style.display = 'none'; }
    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function hideError() { errorBanner.style.display = 'none'; }

    /**
     * autoTable columnStyles carrying the workbook's own column widths.
     *
     * Returns an empty object when the sheet declared none, so content-based
     * sizing stays the default rather than every table being forced to a
     * guess.
     */
    function columnStylesFor(sheet, rows, doc, landscape) {
      const widths = sheet.colWidths;
      if (!widths || !widths.length) return {};

      const columns = Math.max(...rows.map(r => r.length));
      const wanted = [];
      let total = 0;
      for (let c = 0; c < columns; c++) {
        const w = widths[c];
        if (!w) return {};              // a partial set would skew the rest
        wanted.push(w);
        total += w;
      }

      // 30pt margins either side, on whichever orientation was chosen.
      const available = (landscape ? 841.89 : 595.28) - 60;
      const scale = total > available ? available / total : 1;

      const styles = {};
      wanted.forEach((w, c) => { styles[c] = { cellWidth: w * scale }; });
      return styles;
    }

    // Trim fully-empty trailing rows/columns so a sheet's used range is tight.
    function trimGrid(rows) {
      let out = rows.map(r => r.map(c => (c == null ? '' : String(c))));
      while (out.length && out[out.length - 1].every(c => c === '')) out.pop();
      let maxCol = 0;
      out.forEach(r => { for (let i = r.length - 1; i >= 0; i--) { if (r[i] !== '') { maxCol = Math.max(maxCol, i + 1); break; } } });
      return out.map(r => r.slice(0, maxCol));
    }

    function renderPreview(activeIndex) {
      sheetTabs.innerHTML = '';
      sheets.forEach((s, i) => {
        const tab = document.createElement('button');
        tab.className = 'sheet-tab' + (i === activeIndex ? ' active' : '');
        tab.textContent = s.name + ' (' + s.rows.length + ')';
        tab.addEventListener('click', () => renderPreview(i));
        sheetTabs.appendChild(tab);
      });
      const rows = sheets[activeIndex].rows;
      let html = '<table class="preview-table">';
      const bodyStart = optHeader.checked ? 1 : 0;
      if (optHeader.checked && rows[0]) {
        html += '<thead><tr>' + rows[0].map(c => '<th>' + escapeHtml(c) + '</th>').join('') + '</tr></thead>';
      }
      html += '<tbody>';
      for (let i = bodyStart; i < Math.min(rows.length, bodyStart + 60); i++) {
        html += '<tr>' + rows[i].map(c => '<td>' + escapeHtml(c) + '</td>').join('') + '</tr>';
      }
      html += '</tbody></table>';
      if (rows.length > bodyStart + 60) html += '<div style="padding:8px 0;font-size:12px;color:var(--colors-body);">…' + (rows.length - bodyStart - 60) + ' more rows in the PDF</div>';
      previewBody.innerHTML = html;
    }

    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function handleFile(file) {
      hideError();
      if (file.size > 25 * 1024 * 1024) { showError('File is larger than the 25MB limit.'); return; }
      originalName = file.name;
      showProgress(20, 'Parsing spreadsheet…');

      /* A CSV is text, and it has to be decoded as such.
         Handing its raw bytes to the spreadsheet library let that library pick
         the codepage, which turned every non-ASCII character into mojibake and
         parsed "0044123456" as a number, dropping the leading zeros. For a PDF
         we only need the fields as written, so the CSV parser gives us exactly
         that — embedded commas, quotes and newlines included. */
      const isCsv = /\.csv$/i.test(file.name);
      const reader = new FileReader();

      reader.onload = async function(e) {
        try {
          if (isCsv) {
            const rows = trimGrid(parseCsv(String(e.target.result)));
            sheets = rows.length ? [{ name: 'Sheet1', rows }] : [];
          } else {
            const data = new Uint8Array(e.target.result);
            const wb = XLSX.read(data, { type: 'array', cellDates: true });

            /* SheetJS's community build does not read styles at all, so a
               workbook converted through it arrives with its fills gone — the
               numbers are right and the page no longer looks like the
               spreadsheet. The colours live in xl/styles.xml, which can simply
               be read from the same bytes. A failure here must not stop the
               conversion: an unstyled PDF beats no PDF. */
            let fillsBySheet = new Map();
            let widthsBySheet = new Map();
            try {
              const styleZip = await JSZip.loadAsync(data);
              fillsBySheet = await readXlsxFills(styleZip);
              widthsBySheet = await readXlsxColWidths(styleZip);
            } catch { /* styles unreadable — carry on without them */ }

            sheets = [];
            wb.SheetNames.forEach(name => {
              const sheet = wb.Sheets[name];
              // raw:false yields display strings (formatted dates/numbers).
              const raw = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false, blankrows: false });
              const rows = trimGrid(raw);
              if (!rows.length) return;

              /* Map the sheet's own cell references onto the trimmed grid.
                 sheet_to_json starts at the used range's origin, which is not
                 always A1, so the offset has to come from !ref rather than be
                 assumed. */
              const cellFills = fillsBySheet.get(name) || new Map();
              const range = sheet['!ref'] ? XLSX.utils.decode_range(sheet['!ref']) : null;
              const originRow = range ? range.s.r : 0;
              const originCol = range ? range.s.c : 0;

              const fills = rows.map(() => []);
              for (const [ref, colour] of cellFills) {
                const pos = decodeRef(ref);
                if (!pos) continue;
                const r = pos.row - originRow;
                const c = pos.col - originCol;
                if (r >= 0 && r < fills.length && c >= 0) fills[r][c] = colour;
              }

              sheets.push({ name, rows, fills, colWidths: widthsBySheet.get(name) || null });
            });
          }

          if (!sheets.length) {
            showError('This workbook has no data to convert.');
            hideProgress();
            return;
          }

          renderPreview(0);
          previewCard.style.display = 'flex';
          optionsRow.style.display = 'flex';
          fileNameDisplay.textContent = file.name + '  •  ' + sheets.length + (sheets.length === 1 ? ' sheet' : ' sheets');
          actionControls.style.display = 'flex';
          dropZone.style.display = 'none';
        } catch (err) {
          /* "Failed to parse the file" fit every cause equally badly: a
             password-protected workbook, a Word document under an .xlsx name
             and a half-downloaded file all produced the same sentence, so a
             reader had no way to know which of them they were holding — and
             neither did we when they asked. Say which, when the bytes can
             tell us. */
          const raw = isCsv ? null : new Uint8Array(e.target.result);
          const why = raw ? diagnoseSpreadsheet(raw, file.name) : null;
          showError(why || 'Failed to parse the file. Please ensure it is a valid CSV/Excel workbook.');
          console.error('[excel-to-pdf] parse failed:', err);
        }
        hideProgress();
      };
      if (isCsv) reader.readAsText(file, 'utf-8');
      else reader.readAsArrayBuffer(file);
    }

    optHeader.addEventListener('change', () => { if (sheets.length) renderPreview(currentActive()); });
    function currentActive() {
      const tabs = Array.from(sheetTabs.children);
      const idx = tabs.findIndex(t => t.classList.contains('active'));
      return idx < 0 ? 0 : idx;
    }

    btnConvert.addEventListener('click', async () => {
      if (!sheets.length) return;
      showProgress(40, 'Building PDF tables…');
      try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: optLandscape.checked ? 'landscape' : 'portrait', unit: 'pt', format: 'a4' });
        const toRender = optAllSheets.checked ? sheets : [sheets[currentActive()]];
        const multi = toRender.length > 1;

        /* Embed a Unicode font if the data needs one. jsPDF's standard fonts
           are WinAnsi-only, so without this a spreadsheet containing Hindi or
           an em dash produced wrong glyphs rather than an obvious failure. */
        const allText = toRender
          .map((s) => s.rows.map((r) => r.join(' ')).join(' ')).join(' ');
        const fontState = await prepareFonts(doc, allText, (msg) => showProgress(45, msg));
        const ready = new Set(fontState.ready);
        const bodyFont = ready.has('latin') ? 'NotoSans' : 'helvetica';

        /* autoTable draws each cell with a single font, so a cell is given the
           font matching the script it is actually written in. A cell mixing
           two scripts still gets one font — the warning below is what keeps
           that honest. */
        const fontForCell = (text) => {
          const s = String(text == null ? '' : text);
          if (ready.has('devanagari') && /[ऀ-ॿ]/.test(s)) return 'NotoSansDevanagari';
          return bodyFont;
        };

        /* Perceived brightness, so text on a workbook's own fill stays
           readable. Weighted for how the eye responds rather than a flat
           average, which would call a saturated blue "light". */
        const isDark = (hex) => {
          const m = /^#?([0-9a-f]{6})$/i.exec(String(hex));
          if (!m) return false;
          const n = parseInt(m[1], 16);
          const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
          return (0.299 * r + 0.587 * g + 0.114 * b) < 140;
        };

        if (fontState.failed.length) {
          showError('Could not load the ' + fontState.failed.join(' and ') +
            ' font, so some characters may not appear correctly. Check your connection and try again.');
        } else if (fontState.unsupported.length) {
          showError('This file contains ' + fontState.unsupported.join(' and ') +
            ' characters, which cannot be embedded in a PDF here. They will be blank in the output — ' +
            'everything else converts normally.');
        }

        toRender.forEach((sheet, si) => {
          if (si > 0) doc.addPage();
          const rows = sheet.rows;
          const hasHeader = optHeader.checked && rows.length > 1;
          if (multi) {
            doc.setFontSize(12);
            doc.setTextColor(20);
            doc.text(sheet.name, 30, 28);
          }
          doc.autoTable({
            head: hasHeader ? [rows[0]] : undefined,
            body: hasHeader ? rows.slice(1) : rows,
            startY: multi ? 38 : 30,
            margin: { top: 30, left: 30, right: 30, bottom: 30 },
            styles: { font: bodyFont, fontSize: 8, cellPadding: 3, overflow: 'linebreak', lineWidth: 0.5, lineColor: [190, 190, 190], textColor: 30 },
            headStyles: { font: bodyFont, fillColor: [234, 236, 240], textColor: 20, fontStyle: 'bold', lineWidth: 0.5, lineColor: [190, 190, 190] },
            alternateRowStyles: { fillColor: [249, 250, 251] },
            tableWidth: 'auto',
            /* Honour the workbook's own column widths. autoTable otherwise
               sizes purely from content, which is a reasonable default but
               throws away a deliberate choice — a wide label column next to
               narrow figures is information. Widths are scaled together when
               they exceed the page, so a wide sheet still fits rather than
               being clipped. */
            columnStyles: columnStylesFor(sheet, rows, doc, optLandscape.checked),
            didParseCell: (data) => {
              // Pick the font per cell from the script it actually contains.
              const text = Array.isArray(data.cell.raw) ? data.cell.raw.join(' ') : data.cell.raw;
              data.cell.styles.font = fontForCell(text);
              // The embedded Noto faces are registered as 'normal' only, so a
              // bold header style would silently fall back to a face that has
              // no Devanagari glyphs.
              if (data.cell.styles.font !== 'helvetica') data.cell.styles.fontStyle = 'normal';

              /* Repaint the cell with the workbook's own fill. autoTable's
                 default chrome is a grey header band and zebra striping, which
                 looks tidy but is not what the user's spreadsheet looked
                 like. `head` is row 0 of the sheet when the header option is
                 on, so the source row index has to account for that. */
              const sourceRow = data.section === 'head'
                ? 0
                : data.row.index + (hasHeader ? 1 : 0);
              const colour = sheet.fills && sheet.fills[sourceRow]
                && sheet.fills[sourceRow][data.column.index];
              if (colour) {
                data.cell.styles.fillColor = colour;
                // A dark fill needs light text, or the value disappears into it.
                data.cell.styles.textColor = isDark(colour) ? '#ffffff' : '#1a1a1a';
              }
            },
          });
        });

        const blob = doc.output('blob');
        window.downloadBlob(blob, originalName.replace(/\.[^/.]+$/, '') + '.pdf', 'application/pdf');
      } catch (err) {
        showError('PDF compilation failed.');
      }
      hideProgress();
    });

    btnClear.addEventListener('click', () => {
      sheets = [];
      previewCard.style.display = 'none';
      optionsRow.style.display = 'none';
      actionControls.style.display = 'none';
      dropZone.style.display = 'flex';
      fileInput.value = '';
      sheetTabs.innerHTML = '';
      previewBody.innerHTML = '';
    });
  })();
</script>
