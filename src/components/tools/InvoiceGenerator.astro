---
import { t } from '../../i18n/ui';
const { slug, headline, subtitle, lang = 'en'} = Astro.props;

/* Sample data per locale, rendered into the form AND read by the script from
   #invSample, so the two cannot drift. The Portuguese page opened on HDFC
   Bank account and IFSC details, GST at 18% and US dollars, with no Real in
   the currency list. The Portuguese sample is a plain fatura: it must not
   imply a nota fiscal, which only SEFAZ or a municipal system can issue.
   The English sample is unchanged. */
const isPt = lang === 'pt';
/* Indonesian pages (/id/contoh-invoice/) open on an Indonesian service
   invoice in Rupiah, with no PPN (a small vendor that is not a PKP charges
   none) and no real bank numbers — the "DP" and payment terms are the kind
   of detail researched queries ask for ("contoh invoice dp"). */
const isId = lang === 'id';
const sample = isId ? {
  TaxModel: 'none',
  TaxRate: 0,
  CustomTaxLabel: 'Pajak',
  VendorName: 'Studio Contoh',
  VendorAddress: 'Jl. Melati No. 12\nJakarta Selatan 12345\ntagihan@studiocontoh.example',
  ClientName: 'PT Klien Contoh',
  ClientAddress: 'Jl. Sudirman No. 88\nJakarta Pusat 10220\nkeuangan@klien.example',
  Terms: 'Pembayaran melalui transfer bank paling lambat 14 hari setelah tanggal invoice.\nDP 50% telah diterima; sisa tagihan dibayar saat pekerjaan selesai.',
  LineItems: [
    { desc: 'Pembuatan website company profile (5 halaman)', qty: 1, rate: 7500000 },
    { desc: 'Optimasi kecepatan website (jam)', qty: 4, rate: 350000 }
  ]
} : isPt ? {
  TaxModel: 'none',
  TaxRate: 0,
  CustomTaxLabel: 'Imposto',
  VendorName: 'Estúdio Exemplo',
  VendorAddress: 'Rua das Flores, 123 — Sala 4\nSão Paulo, SP 01000-000\ncontato@estudioexemplo.com.br',
  ClientName: 'Empresa Cliente Ltda.',
  ClientAddress: 'Av. Paulista, 1000\nSão Paulo, SP 01310-100\nfinanceiro@cliente.com.br',
  Terms: 'Pagamento via PIX — chave: financeiro@estudioexemplo.com.br\nVencimento em 15 dias a partir da data de emissão.',
  LineItems: [
    { desc: 'Desenvolvimento de site institucional', qty: 1, rate: 2500.00 },
    { desc: 'Otimização de desempenho (horas)', qty: 4, rate: 350.00 }
  ]
} : {
  /* US sample (2026-09-28): the English site targets US/UK/CA/AU, and the
     page used to open on HDFC Bank / IFSC details and GST 18%. No bank
     numbers at all — a sample that looks like real account details gets
     copied into real invoices. .example addresses (RFC 2606). */
  TaxModel: 'none',
  TaxRate: 0,
  CustomTaxLabel: 'Tax',
  VendorName: 'Brightline Design Co.',
  VendorAddress: '450 Market Street, Suite 12\nSan Francisco, CA 94105\nbilling@brightline.example',
  ClientName: 'Harbor & Pine LLC',
  ClientAddress: '88 Congress Street\nBoston, MA 02109\naccounts@harborpine.example',
  Terms: 'Payment is due within 15 days of the invoice date.\nPay by ACH bank transfer or card — details on request.',
  LineItems: [
    { desc: 'Website design and build (5 pages)', qty: 1, rate: 2500.00 },
    { desc: 'Performance optimization (hours)', qty: 4, rate: 350.00 }
  ]
};
---

<style>
  /* Split Screen Workspace specific overrides for invoice builder */
  .split-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }
  @media (max-width: 1024px) {
    .split-workspace {
      grid-template-columns: 1fr;
    }
  }
  .editor-pane {
    /* The textareas below use field-sizing: content, which also makes their
       longest line their min-content WIDTH. A grid item will not shrink below
       its min-content, so one long line of payment terms widened the whole
       column and the page scrolled sideways at 320px. min-width: 0 lets the
       pane take the track width and the textareas wrap inside it. */
    min-width: 0;
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  .preview-pane {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-x: auto;
  }
  .form-card {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: 8px;
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    /* elevation removed — separation comes from colour, not shadow */
  }
  .form-card-title {
    font-size: 13px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: var(--colors-mute);
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: var(--spacing-xs);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
  }
  .textarea-input {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--colors-hairline);
    padding: var(--spacing-sm);
    font-size: 13px;
    background-color: var(--colors-canvas);
    color: var(--colors-ink);
    resize: vertical;
    /* Every one of these ships three lines of default content. At the
       browser's default rows=2 the third line was clipped in half on
       first paint, so the tool looked broken before anyone touched it.
       Three rows plus an explicit line-height makes the box fit what is
       actually in it; `resize: vertical` still lets people grow it. */
    line-height: 1.5;
    min-height: calc(3 * 1.5em + 2 * var(--spacing-sm) + 2px);
    /* Three lines of content wrap to four in a phone-width box, so a fixed
       three-row floor clips again at 390px. Where supported the box simply
       grows to fit what is in it; elsewhere the floor above still applies
       and `resize: vertical` remains the manual escape hatch. */
    field-sizing: content;
    font-family: inherit;
  }
  .textarea-input:focus {
    border-color: var(--colors-ink);
  }
  .item-edit-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .item-edit-table :global(th) {
    text-align: left;
    font-family: var(--font-sans);
    font-size: 12px; /* was 11px: under the 12px floor verify-mobile enforces */
    color: var(--colors-mute);
    text-transform: uppercase;
    padding-bottom: 6px;
  }
  :global(.item-edit-row) :global(td) {
    padding: var(--spacing-xs) 0;
  }
  :global(.item-delete-btn) {
    background: none;
    border: none;
    color: var(--colors-error);
    cursor: pointer;
    font-size: 18px;
    padding: 0 var(--spacing-xs);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .a4-wrapper {
    transform-origin: top center;
    /* elevation removed — separation comes from colour, not shadow */
    background-color: #ffffff;
    color: #171717;
  }
  .invoice-pdf-container {
    --inv-accent: #171717;
    width: 700px;
    min-height: 900px;
    padding: 40px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #171717;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .invoice-pdf-header {
    display: flex;
    justify-content: space-between;
    border-bottom: 2px solid var(--inv-accent);
    padding-bottom: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }
  /* Optional logo, scaled down in the browser before it is placed. */
  .pdf-logo {
    display: block;
    max-height: 56px;
    max-width: 180px;
    object-fit: contain;
    margin-bottom: 8px;
  }
  .pdf-logo[hidden] { display: none; }
  /* Templates (2026-10-04). The class is toggled at runtime on an element the
     template writes, so it is wrapped in :global() — see the scoped-CSS note
     in CLAUDE.md. Modern: a colour band; Minimal: thin grey rules, no colour. */
  .invoice-pdf-container:global(.tpl-modern) .invoice-pdf-header {
    background: var(--inv-accent);
    margin: -40px -40px var(--spacing-xl);
    padding: 32px 40px;
    border-bottom: 0;
  }
  .invoice-pdf-container:global(.tpl-modern) .pdf-brand-title { color: #ffffff; }
  .invoice-pdf-container:global(.tpl-modern) .pdf-doc-type,
  .invoice-pdf-container:global(.tpl-modern) .invoice-pdf-header .pdf-meta-text { color: rgba(255, 255, 255, 0.85); }
  .invoice-pdf-container:global(.tpl-modern) .invoice-pdf-table th {
    background: var(--inv-accent);
    color: #ffffff;
    border-bottom: 0;
    padding: 8px 6px;
  }
  .invoice-pdf-container:global(.tpl-minimal) .invoice-pdf-header { border-bottom: 1px solid #d4d4d4; }
  .invoice-pdf-container:global(.tpl-minimal) .pdf-brand-title { font-weight: 600; font-size: 20px; letter-spacing: -0.6px; }
  .invoice-pdf-container:global(.tpl-minimal) .invoice-pdf-table th { border-bottom: 1px solid #d4d4d4; }
  .invoice-pdf-container:global(.tpl-minimal) .invoice-pdf-table tr:last-child td { border-bottom: 1px solid #d4d4d4; }
  .invoice-pdf-container:global(.tpl-minimal) .pdf-totals-table tr.grand-total td { border-top: 1px solid #171717; }
  .pdf-brand-title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -1.2px;
  }
  .pdf-doc-type {
    font-size: 16px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: #888888;
    text-align: right;
  }
  .pdf-meta-text {
    font-size: 12px;
    font-family: var(--font-sans);
    color: #4d4d4d;
    margin-top: 4px;
  }
  .invoice-pdf-addresses {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }
  .address-col-title {
    font-size: 10px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: #888888;
    margin-bottom: 6px;
  }
  .address-details {
    font-size: 12px;
    line-height: 1.6;
    color: #4d4d4d;
    white-space: pre-wrap;
  }
  .invoice-pdf-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--spacing-2xl);
  }
  .invoice-pdf-table th {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    color: #888888;
    border-bottom: 1px solid var(--inv-accent);
    padding: var(--spacing-xs) 6px;
    text-align: left;
  }
  .invoice-pdf-table td {
    font-size: 12px;
    padding: 12px 6px;
    border-bottom: 1px solid #ebebeb;
    color: #4d4d4d;
  }
  .invoice-pdf-table tr:last-child td {
    border-bottom: 1px solid #171717;
  }
  .invoice-pdf-table th.right-align, .invoice-pdf-table td.right-align {
    text-align: right;
  }
  .pdf-summary-block {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--spacing-2xl);
  }
  .pdf-totals-table {
    width: 250px;
    border-collapse: collapse;
    font-size: 13px;
  }
  .pdf-totals-table td {
    padding: var(--spacing-xs) 6px;
    color: #4d4d4d;
  }
  .pdf-totals-table tr.grand-total td {
    font-weight: var(--fw-bold);
    color: #171717;
    font-size: 16px;
    border-top: 2px solid var(--inv-accent);
    padding-top: var(--spacing-sm);
  }
  .pdf-totals-table td.right-align {
    text-align: right;
    font-family: var(--font-sans);
  }
  .invoice-pdf-footer {
    border-top: 1px solid #ebebeb;
    padding-top: var(--spacing-md);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .pdf-terms {
    max-width: 400px;
    font-size: 11px;
    color: #888888;
    line-height: 1.6;
    white-space: pre-wrap;
  }
  /* Indonesian invoices state the total in words ("terbilang"). */
  .inv-id-words {
    font-size: 12px;
    font-style: italic;
    color: #171717;
    margin: 0 0 var(--spacing-md);
  }
  .pdf-thankyou {
    font-size: 12px;
    font-weight: 500;
    color: #171717;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr !important;
      gap: var(--spacing-xs) !important;
    }
    .item-edit-table,
    .item-edit-table :global(thead),
    .item-edit-table :global(tbody),
    .item-edit-table :global(tr),
    .item-edit-table :global(td) {
      display: block !important;
      width: 100% !important;
    }
    .item-edit-table :global(thead) {
      display: none !important;
    }
    :global(.item-edit-row) {
      position: relative !important;
      padding: var(--spacing-sm) 0 !important;
      border-bottom: 1px solid var(--colors-hairline) !important;
      display: flex !important;
      flex-direction: column !important;
      gap: var(--spacing-xs) !important;
    }
    :global(.item-edit-row) :global(td) {
      padding: 0 !important;
    }
    :global(.item-edit-row) :global(td:nth-child(1))::before {
      content: "Description";
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--colors-mute);
      display: block;
      margin-bottom: 4px;
    }
    :global(.item-edit-row) :global(td:nth-child(2))::before {
      content: "Quantity";
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--colors-mute);
      display: block;
      margin-bottom: 4px;
    }
    :global(.item-edit-row) :global(td:nth-child(3))::before {
      content: "Rate";
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--colors-mute);
      display: block;
      margin-bottom: 4px;
    }
    :global(.item-edit-row) :global(td:nth-child(4)) {
      position: absolute !important;
      /* width:auto undoes the `width: 100%` every td gets from the block
         rule above — without it this box spanned the full card and the
         button sat at its left edge, over the description field. */
      width: auto !important;
      right: 0 !important;
      top: 0 !important;
    }
    :global(.item-delete-btn) {
      padding: 4px !important;
      font-size: 22px !important;
    }
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<div class="split-workspace">
  <!-- Left panel: Editors and inputs -->
  <section class="editor-pane">
    <!-- Card: Meta settings -->
    <div class="form-card">
      <div class="form-card-title">{t('Invoice Settings', lang)}</div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="inputInvNo">{t('Invoice Number', lang)}</label>
          <input type="text" id="inputInvNo" class="form-input" value="CO-2026-001" />
        </div>
        <div class="form-group">
          <label class="form-label" for="inputTaxSelect">{t('Tax Configuration', lang)}</label>
          <select id="inputTaxSelect" class="select-input">
            <option value="none" selected>{t('No Tax', lang)}</option>
            {isId && <option value="PPN">PPN (11%)</option>}
            <option value="GST">GST (18%)</option>
            <option value="IGST">IGST (18%)</option>
            <option value="VAT">VAT (15%)</option>
            <option value="custom">{t('Custom Tax Rate', lang)}</option>
          </select>
        </div>
      </div>
      <div id="customTaxGroup" class="form-row" style="display: none; margin-top: var(--spacing-xxs);">
        <div class="form-group">
          <label class="form-label" for="inputCustomTaxLabel">{t('Tax Label', lang)}</label>
          <input type="text" id="inputCustomTaxLabel" class="form-input" value={sample.CustomTaxLabel} style="height: 36px; font-size: 13px;" />
        </div>
        <div class="form-group">
          <label class="form-label" for="inputCustomTaxRate">{t('Tax Rate (%)', lang)}</label>
          <input type="number" id="inputCustomTaxRate" class="form-input" value="5" min="0" max="100" step="0.01" style="height: 36px; font-size: 13px;" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="invCurrency">{t('Currency', lang)}</label>
          <select id="invCurrency" class="select-input">
            <option value="$" selected={!isPt && !isId}>{t('$ – US Dollar (USD)', lang)}</option>
            <option value="Rp" selected={isId}>{t('Rp – Indonesian Rupiah (IDR)', lang)}</option>
            <option value="R$" selected={isPt}>{t('R$ – Real Brasileiro (BRL)', lang)}</option>
            <option value="&euro;">{t('€ – Euro (EUR)', lang)}</option>
            <option value="&pound;">{t('£ – British Pound (GBP)', lang)}</option>
            <option value="&#8377;">{t('₹ – Indian Rupee (INR)', lang)}</option>
            <option value="&yen;">{t('¥ – Japanese Yen (JPY)', lang)}</option>
            <option value="&yen;">{t('¥ – Chinese Yuan (CNY)', lang)}</option>
            <option value="C$">{t('C$ – Canadian Dollar (CAD)', lang)}</option>
            <option value="A$">{t('A$ – Australian Dollar (AUD)', lang)}</option>
            <option value="CHF">{t('CHF – Swiss Franc', lang)}</option>
            <option value="AED">{t('AED – UAE Dirham', lang)}</option>
            <option value="SGD">{t('SGD – Singapore Dollar', lang)}</option>
            <option value="R">{t('R – South African Rand', lang)}</option>
            <option value="zł">{t('zł – Polish Złoty (PLN)', lang)}</option>
            <option value="₩">{t('₩ – South Korean Won (KRW)', lang)}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="inputInvDate">{t('Invoice Date', lang)}</label>
          <input type="date" id="inputInvDate" class="form-input" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="inputDueDate">{t('Due Date', lang)}</label>
          <input type="date" id="inputDueDate" class="form-input" />
        </div>
      </div>
    </div>

    <!-- Card: Design -->
    <div class="form-card">
      <div class="form-card-title">{t('Design', lang)}</div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="invTemplate">{t('Template', lang)}</label>
          <select id="invTemplate" class="select-input" name="template">
            <option value="classic" selected>{t('Classic', lang)}</option>
            <option value="modern">{t('Modern (colour header)', lang)}</option>
            <option value="minimal">{t('Minimal (prints cheaply)', lang)}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="invAccent">{t('Accent colour', lang)}</label>
          <select id="invAccent" class="select-input" name="accent-colour">
            <option value="#171717" selected>{t('Charcoal', lang)}</option>
            <option value="#1d4ed8">{t('Blue', lang)}</option>
            <option value="#047857">{t('Green', lang)}</option>
            <option value="#b91c1c">{t('Red', lang)}</option>
            <option value="#6d28d9">{t('Purple', lang)}</option>
            <option value="#c2410c">{t('Orange', lang)}</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="invLogo">{t('Logo (optional, stays on your device)', lang)}</label>
        <input type="file" id="invLogo" class="form-input" accept="image/png,image/jpeg,image/webp" />
      </div>
      <button type="button" class="button button-secondary" id="invLogoRemove" style="display: none; height: 34px; font-size: 13px;">{t('Remove logo', lang)}</button>
    </div>

    <!-- Card: Vendor details -->
    <div class="form-card">
      <div class="form-card-title">{t('From (Vendor / Company)', lang)}</div>
      <div class="form-group">
        <label class="form-label" for="inputVendorName">{t('Billing Entity Name', lang)}</label>
        <input type="text" id="inputVendorName" class="form-input" value={sample.VendorName} />
      </div>
      <div class="form-group">
        <label class="form-label" for="inputVendorAddress">{t('Address & Contact Info', lang)}</label>
        <textarea id="inputVendorAddress" class="textarea-input" rows="3">{sample.VendorAddress}</textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="inputVendorTaxId">{t('Business GSTIN / VAT ID / Tax ID (Optional)', lang)}</label>
        <input type="text" id="inputVendorTaxId" class="form-input" placeholder={t('e.g., GSTIN, VAT, or ABN', lang)} style="height: 36px; font-size: 13px;" />
      </div>
    </div>

    <!-- Card: Client details -->
    <div class="form-card">
      <div class="form-card-title">{t('To (Client Recipient)', lang)}</div>
      <div class="form-group">
        <label class="form-label" for="inputClientName">{t('Client Entity Name', lang)}</label>
        <input type="text" id="inputClientName" class="form-input" value={sample.ClientName} />
      </div>
      <div class="form-group">
        <label class="form-label" for="inputClientAddress">{t('Address & Details', lang)}</label>
        <textarea id="inputClientAddress" class="textarea-input" rows="3">{sample.ClientAddress}</textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="inputClientTaxId">{t('Customer GSTIN / VAT ID / Tax ID (Optional)', lang)}</label>
        <input type="text" id="inputClientTaxId" class="form-input" placeholder={t('e.g., Client GSTIN, VAT', lang)} style="height: 36px; font-size: 13px;" />
      </div>
    </div>

    <!-- Card: Line items editor -->
    <div class="form-card">
      <div class="form-card-title">{t('Itemized Line Items', lang)}</div>
      <table class="item-edit-table" id="itemEditTable">
        <thead>
          <tr>
            <th style="width: 50%;">{t('Description', lang)}</th>
            <th style="width: 15%;">{t('Qty', lang)}</th>
            <th style="width: 25%;" id="invRateHeader">{t('Rate ($)', lang)}</th>
            <th style="width: 10%;"></th>
          </tr>
        </thead>
        <tbody id="itemEditRows">
        </tbody>
      </table>
      <button class="button button-secondary" id="btnAddItem" style="height: 34px; font-size: 13px; margin-top: var(--spacing-xs);">{t('+ Add Line Item', lang)}</button>
    </div>

    <!-- Card: Notes/Terms -->
    <div class="form-card">
      <div class="form-card-title">{t('Terms & Bank Notes', lang)}</div>
      <div class="form-group">
        <label class="form-label" for="inputTerms">{t('Payment Terms & Instructions', lang)}</label>
        <textarea id="inputTerms" class="textarea-input" rows="3">{sample.Terms}</textarea>
        <script type="application/json" id="invSample" set:html={JSON.stringify(sample)}></script>
      </div>
    </div>

    <div class="actions-bar" style="margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
      <button id="btnDownload" class="button button-primary">{t('Download Invoice PDF', lang)}</button>
      <button id="btnClearForm" class="button button-danger">{t('Clear Form', lang)}</button>
    </div>
  </section>

  <!-- Right panel: Interactive PDF sheet display -->
  <section class="preview-pane" id="previewPane">
    <div class="a4-wrapper" id="a4Wrapper">
      <div class="invoice-pdf-container" id="invoicePdfContainer">
        <!-- Header -->
        <div class="invoice-pdf-header">
          <div>
            <img id="pdfLogo" class="pdf-logo" alt="" hidden />
            <div class="pdf-brand-title" id="pdfVendorTitle">{sample.VendorName}</div>
            <div class="pdf-meta-text" id="pdfVendorSub">{t('Vendor Billing Profile', lang)}</div>
          </div>
          <div>
            <div class="pdf-doc-type">{t('Tax Invoice', lang)}</div>
            <div class="pdf-meta-text" style="text-align: right;">
              {t('No:', lang)} <strong id="pdfInvNo">CO-2026-001</strong><br />
              {t('Date:', lang)} <span id="pdfInvDate">--/--/----</span><br />
              {t('Due Date:', lang)} <span id="pdfDueDate">--/--/----</span>
            </div>
          </div>
        </div>

        <!-- Address Details -->
        <div class="invoice-pdf-addresses">
          <div>
            <div class="address-col-title">{t('Billing Entity (From)', lang)}</div>
            <div class="address-details" id="pdfVendorAddr"></div>
            <div id="pdfVendorTaxIdContainer" style="display: none; font-size: 11px; margin-top: 4px; color: #4d4d4d;">
              <strong>{t('Tax ID:', lang)}</strong> <span id="pdfVendorTaxId"></span>
            </div>
          </div>
          <div>
            <div class="address-col-title">{t('Billed Client (To)', lang)}</div>
            <!-- The "Client Entity Name" field was collected into invoiceData
                 and used only to name the downloaded file: there was no element
                 for it here, so the client's name never appeared on the invoice
                 at all. The vendor side had one; this side did not. -->
            <div class="address-details" id="pdfClientName" style="font-weight: 700;"></div>
            <div class="address-details" id="pdfClientAddr"></div>
            <div id="pdfClientTaxIdContainer" style="display: none; font-size: 11px; margin-top: 4px; color: #4d4d4d;">
              <strong>{t('Tax ID:', lang)}</strong> <span id="pdfClientTaxId"></span>
            </div>
          </div>
        </div>

        <!-- Items Table -->
        <table class="invoice-pdf-table">
          <thead>
            <tr>
              <th style="width: 50%;">{t('Line Description', lang)}</th>
              <th style="width: 10%; text-align: right;">{t('Qty', lang)}</th>
              <th style="width: 20%; text-align: right;">{t('Unit Rate', lang)}</th>
              <th style="width: 20%; text-align: right;">{t('Amount', lang)}</th>
            </tr>
          </thead>
          <tbody id="pdfTableRows">
          </tbody>
        </table>

        <!-- Totals block & Footer layout -->
        <div style="margin-top: auto;">
          <div class="pdf-summary-block">
            <table class="pdf-totals-table">
              <tr>
                <td>{t('Subtotal', lang)}</td>
                <td class="right-align" id="pdfSubtotal">$0.00</td>
              </tr>
              <tr id="pdfTaxRow">
                <td id="pdfTaxLabel">GST (18%)</td>
                <td class="right-align" id="pdfTaxAmount">$0.00</td>
              </tr>
              <tr class="grand-total">
                <td>{t('Grand Total', lang)}</td>
                <td class="right-align" id="pdfGrandTotal">$0.00</td>
              </tr>
            </table>
          </div>
          {isId && <div class="inv-id-words" id="pdfWords"></div>}

          <div class="invoice-pdf-footer">
            <div>
              <div class="address-col-title">{t('Terms & Notes', lang)}</div>
              <div class="pdf-terms" id="pdfTerms"></div>
            </div>
            <div class="pdf-thankyou">{t('Thank you for your business.', lang)}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (function() {
    let invoiceData = {
      InvNo: "CO-2026-001",
      InvDate: "",
      DueDate: "",
      TaxModel: "GST", 
      TaxRate: 0.18,
      /* Every text field below is overwritten by the locale's sample on the
         next line; these are only the shape. They used to hold an Indian
         sample (HDFC, Bengaluru) that no page shows any more. */
      VendorName: "",
      VendorAddress: "",
      VendorTaxId: "",
      ClientName: "",
      ClientAddress: "",
      ClientTaxId: "",
      Terms: "",
      CustomTaxLabel: "",
      LineItems: []
    };
    /* The locale's sample, rendered by the component (see #invSample). */
    Object.assign(invoiceData, JSON.parse(document.getElementById('invSample').textContent));

    let invCurrSym = document.getElementById('invCurrency').value;
    const inputInvNo = document.getElementById('inputInvNo');
    const inputTaxSelect = document.getElementById('inputTaxSelect');
    const invCurrency = document.getElementById('invCurrency');
    const inputInvDate = document.getElementById('inputInvDate');
    const inputDueDate = document.getElementById('inputDueDate');
    const inputVendorName = document.getElementById('inputVendorName');
    const inputVendorAddress = document.getElementById('inputVendorAddress');
    const inputClientName = document.getElementById('inputClientName');
    const inputClientAddress = document.getElementById('inputClientAddress');
    const inputTerms = document.getElementById('inputTerms');
    const itemEditRows = document.getElementById('itemEditRows');
    const btnAddItem = document.getElementById('btnAddItem');
    const btnDownload = document.getElementById('btnDownload');
    const btnClearForm = document.getElementById('btnClearForm');
    const previewPane = document.getElementById('previewPane');
    const a4Wrapper = document.getElementById('a4Wrapper');

    window.addEventListener('load', () => {
      // Set default dates
      const today = new Date();
      invoiceData.InvDate = today.toISOString().substring(0, 10);
      
      const due = new Date();
      due.setDate(today.getDate() + 15);
      invoiceData.DueDate = due.toISOString().substring(0, 10);

      inputInvDate.value = invoiceData.InvDate;
      inputDueDate.value = invoiceData.DueDate;

      renderEditorTable();
      updatePreviewPage();
      scaleA4Preview();
    });

    window.addEventListener('resize', scaleA4Preview);

    function scaleA4Preview() {
      if (!previewPane || !a4Wrapper) return;
      const paneWidth = previewPane.clientWidth - 40;
      const scale = paneWidth < 700 ? paneWidth / 700 : 1;
      a4Wrapper.style.transform = `scale(${scale})`;
      previewPane.style.minHeight = `${900 * scale + 40}px`;
    }

    /* Brazilian receipts read "R$ 5.000,00", not "R$5000.00". English keeps
       its existing format exactly. */
    const PT_MONEY = document.documentElement.lang === 'pt';
    /* Indonesian: "Rp 8.900.000" — Rupiah without cents. */
    const ID_MONEY = document.documentElement.lang === 'id';
    function fmt(n) {
      if (ID_MONEY) {
        const d = invCurrSym === 'Rp' ? 0 : 2;
        return invCurrSym + ' ' + n.toLocaleString('id-ID', { minimumFractionDigits: d, maximumFractionDigits: d });
      }
      return PT_MONEY
        ? invCurrSym + ' ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        : invCurrSym + n.toFixed(2);
    }

    /* Rupiah in words: 8900000 → "delapan juta sembilan ratus ribu". Same
       routine as the receipt generator. */
    function terbilang(n) {
      const s = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];
      n = Math.floor(n);
      if (n < 12) return s[n];
      if (n < 20) return terbilang(n - 10) + ' belas';
      if (n < 100) return terbilang(Math.floor(n / 10)) + ' puluh ' + terbilang(n % 10);
      if (n < 200) return 'seratus ' + terbilang(n - 100);
      if (n < 1000) return terbilang(Math.floor(n / 100)) + ' ratus ' + terbilang(n % 100);
      if (n < 2000) return 'seribu ' + terbilang(n - 1000);
      if (n < 1e6) return terbilang(Math.floor(n / 1000)) + ' ribu ' + terbilang(n % 1000);
      if (n < 1e9) return terbilang(Math.floor(n / 1e6)) + ' juta ' + terbilang(n % 1e6);
      if (n < 1e12) return terbilang(Math.floor(n / 1e9)) + ' miliar ' + terbilang(n % 1e9);
      return terbilang(Math.floor(n / 1e12)) + ' triliun ' + terbilang(n % 1e12);
    }

    function updatePreviewPage() {
      document.getElementById('pdfVendorTitle').textContent = invoiceData.VendorName || "Billing Entity";
      document.getElementById('pdfVendorAddr').textContent = invoiceData.VendorAddress;
      document.getElementById('pdfClientName').textContent = invoiceData.ClientName;
      document.getElementById('pdfClientAddr').textContent = invoiceData.ClientAddress;
      document.getElementById('pdfInvNo').textContent = invoiceData.InvNo || "INV-000";
      document.getElementById('pdfInvDate').textContent = formatDate(invoiceData.InvDate);
      document.getElementById('pdfDueDate').textContent = formatDate(invoiceData.DueDate);
      document.getElementById('pdfTerms').textContent = invoiceData.Terms;

      const tbody = document.getElementById('pdfTableRows');
      tbody.innerHTML = '';

      let subtotal = 0;
      invoiceData.LineItems.forEach(item => {
        const itemAmount = item.qty * item.rate;
        subtotal += itemAmount;

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${item.desc || "Line item details"}</td>
          <td class="right-align">${item.qty}</td>
          <td class="right-align">${fmt(item.rate)}</td>
          <td class="right-align">${fmt(itemAmount)}</td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('pdfSubtotal').textContent = fmt(subtotal);
      const taxAmount = subtotal * invoiceData.TaxRate;
      const grandTotal = subtotal + taxAmount;

      const taxRow = document.getElementById('pdfTaxRow');
      if (invoiceData.TaxModel === 'none') {
        taxRow.style.display = 'none';
      } else {
        taxRow.style.display = 'table-row';
        const label = invoiceData.TaxModel === 'custom' ? invoiceData.CustomTaxLabel : invoiceData.TaxModel;
        const ratePct = parseFloat((invoiceData.TaxRate * 100).toFixed(4));
        document.getElementById('pdfTaxLabel').textContent = `${label} (${ratePct}%)`;
        document.getElementById('pdfTaxAmount').textContent = fmt(taxAmount);
      }
      document.getElementById('pdfGrandTotal').textContent = fmt(grandTotal);
      const words = document.getElementById('pdfWords');
      if (words) {
        const w = invCurrSym === 'Rp' ? terbilang(Math.round(grandTotal)).replace(/\s+/g, ' ').trim() : '';
        words.textContent = w ? __t('In words:') + ' ' + w.charAt(0).toUpperCase() + w.slice(1) + ' rupiah' : '';
      }

      // Render Tax IDs
      const pdfVendorTaxIdContainer = document.getElementById('pdfVendorTaxIdContainer');
      const pdfVendorTaxId = document.getElementById('pdfVendorTaxId');
      if (invoiceData.VendorTaxId) {
        pdfVendorTaxId.textContent = invoiceData.VendorTaxId;
        pdfVendorTaxIdContainer.style.display = 'block';
      } else {
        pdfVendorTaxIdContainer.style.display = 'none';
      }

      const pdfClientTaxIdContainer = document.getElementById('pdfClientTaxIdContainer');
      const pdfClientTaxId = document.getElementById('pdfClientTaxId');
      if (invoiceData.ClientTaxId) {
        pdfClientTaxId.textContent = invoiceData.ClientTaxId;
        pdfClientTaxIdContainer.style.display = 'block';
      } else {
        pdfClientTaxIdContainer.style.display = 'none';
      }
    }

    function renderEditorTable() {
      itemEditRows.innerHTML = '';
      const hdr = document.getElementById('invRateHeader');
      if (hdr) hdr.textContent = `${__t('Rate')} (${invCurrSym})`;
      invoiceData.LineItems.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.className = 'item-edit-row';
        tr.innerHTML = `
          <td>
            <input type="text" class="form-input" aria-label="${__tf('Item {0} description', index + 1)}" value="${item.desc}" oninput="window.updateLineItem(${index}, 'desc', this.value)">
          </td>
          <td>
            <input type="number" class="form-input" style="padding: 0 6px; text-align: center;" aria-label="${__tf('Item {0} quantity', index + 1)}" inputmode="numeric" value="${item.qty}" min="1" oninput="window.updateLineItem(${index}, 'qty', this.value)">
          </td>
          <td>
            <input type="number" class="form-input" aria-label="${__tf('Item {0} unit price', index + 1)}" inputmode="decimal" value="${item.rate}" min="0" step="0.01" oninput="window.updateLineItem(${index}, 'rate', this.value)">
          </td>
          <td>
            <button type="button" class="item-delete-btn" aria-label="${__tf('Remove item {0}', index + 1)}" onclick="window.deleteLineItem(${index})">×</button>
          </td>
        `;
        itemEditRows.appendChild(tr);
      });
    }

    window.updateLineItem = function(index, key, val) {
      if (key === 'qty') {
        invoiceData.LineItems[index].qty = parseInt(val) || 1;
      } else if (key === 'rate') {
        invoiceData.LineItems[index].rate = parseFloat(val) || 0;
      } else {
        invoiceData.LineItems[index].desc = val;
      }
      updatePreviewPage();
    };

    window.deleteLineItem = function(index) {
      if (invoiceData.LineItems.length > 1) {
        invoiceData.LineItems.splice(index, 1);
        renderEditorTable();
        updatePreviewPage();
      }
    };

    btnAddItem.addEventListener('click', () => {
      invoiceData.LineItems.push({ desc: "New Line Item Details", qty: 1, rate: 0.00 });
      renderEditorTable();
      updatePreviewPage();
    });

    // Inputs listeners
    inputInvNo.addEventListener('input', (e) => { invoiceData.InvNo = e.target.value; updatePreviewPage(); });
    inputTaxSelect.addEventListener('change', (e) => {
      const taxType = e.target.value;
      invoiceData.TaxModel = taxType;
      const customTaxGroup = document.getElementById('customTaxGroup');
      if (taxType === 'GST' || taxType === 'IGST') {
        invoiceData.TaxRate = 0.18;
        customTaxGroup.style.display = 'none';
      } else if (taxType === 'PPN') {
        /* PMK 131/2024: 12% × DPP nilai lain 11/12 = effective 11% for
           anything that is not a luxury good. */
        invoiceData.TaxRate = 0.11;
        customTaxGroup.style.display = 'none';
      } else if (taxType === 'VAT') {
        invoiceData.TaxRate = 0.15;
        customTaxGroup.style.display = 'none';
      } else if (taxType === 'custom') {
        customTaxGroup.style.display = 'flex';
        const customRate = parseFloat(document.getElementById('inputCustomTaxRate').value) || 0;
        invoiceData.TaxRate = customRate / 100;
        invoiceData.CustomTaxLabel = document.getElementById('inputCustomTaxLabel').value || 'Tax';
      } else {
        invoiceData.TaxRate = 0;
        customTaxGroup.style.display = 'none';
      }
      updatePreviewPage();
    });
    document.getElementById('inputCustomTaxLabel').addEventListener('input', (e) => {
      invoiceData.CustomTaxLabel = e.target.value || 'Tax';
      updatePreviewPage();
    });
    document.getElementById('inputCustomTaxRate').addEventListener('input', (e) => {
      const rate = parseFloat(e.target.value) || 0;
      invoiceData.TaxRate = rate / 100;
      updatePreviewPage();
    });
    document.getElementById('inputVendorTaxId').addEventListener('input', (e) => {
      invoiceData.VendorTaxId = e.target.value;
      updatePreviewPage();
    });
    document.getElementById('inputClientTaxId').addEventListener('input', (e) => {
      invoiceData.ClientTaxId = e.target.value;
      updatePreviewPage();
    });
    invCurrency.addEventListener('change', (e) => {
      invCurrSym = e.target.value;
      renderEditorTable();
      updatePreviewPage();
    });
    inputInvDate.addEventListener('change', (e) => { invoiceData.InvDate = e.target.value; updatePreviewPage(); });
    inputDueDate.addEventListener('change', (e) => { invoiceData.DueDate = e.target.value; updatePreviewPage(); });
    inputVendorName.addEventListener('input', (e) => { invoiceData.VendorName = e.target.value; updatePreviewPage(); });
    inputVendorAddress.addEventListener('input', (e) => { invoiceData.VendorAddress = e.target.value; updatePreviewPage(); });
    inputClientName.addEventListener('input', (e) => { invoiceData.ClientName = e.target.value; updatePreviewPage(); });
    inputClientAddress.addEventListener('input', (e) => { invoiceData.ClientAddress = e.target.value; updatePreviewPage(); });
    inputTerms.addEventListener('input', (e) => { invoiceData.Terms = e.target.value; updatePreviewPage(); });

    function formatDate(dateString) {
      if (!dateString) return '--/--/----';
      const parts = dateString.split('-');
      if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
      return dateString;
    }

    btnDownload.addEventListener('click', () => {
      const element = document.getElementById('invoicePdfContainer');
      const clone = element.cloneNode(true);
      
      // Getting a non-blank page out of html2canvas here needs THREE things, and
      // each one fails silently on its own — you still get a plausible PDF file:
      //   1. in normal flow      (position:absolute/fixed -> canvas 1588x0)
      //   2. not moved off-screen (left:-10000px -> right size, 0% ink, white page)
      //   3. document scrolled to the top at render time
      // (3) is why this looked fixed and was not: the download button sits below
      // the fold, so by the time anyone clicks it the page is scrolled, and every
      // render came back blank. Measured: scrollY 0 -> 3.07% ink, scrollY 4456 -> 0%.
      // html2canvas's own scrollY/windowHeight options did not compensate.
      // So: park the clone at the top of the document, jump to the top, render,
      // then put the scroll position back.
      const savedScroll = window.scrollY || document.documentElement.scrollTop || 0;
      const pdfHost = document.createElement('div');
      pdfHost.style.height = '0';
      pdfHost.style.overflow = 'hidden';

      clone.style.transform = 'none';
      clone.style.position = 'static';
      clone.style.width = '794px';
      clone.style.height = 'auto';
      clone.style.opacity = '1';
      clone.style.visibility = 'visible';
      // cloneNode copies ids, so without this the document briefly holds duplicates
      // and getElementById becomes ambiguous mid-render.
      clone.removeAttribute('id');
      clone.querySelectorAll('[id]').forEach(n => n.removeAttribute('id'));
      pdfHost.appendChild(clone);
      document.body.insertBefore(pdfHost, document.body.firstChild);
      window.scrollTo(0, 0);

      const finishPdf = () => {
        pdfHost.remove();
        window.scrollTo(0, savedScroll);
      };

      const filename = (invoiceData.InvNo || 'invoice') + '_' + (invoiceData.ClientName.replace(/\s+/g, '_').toLowerCase()) + '.pdf';
      
      const opt = {
        margin:       0,
        filename:     filename,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'pt', format: 'a4', orientation: 'portrait' }
      };

      html2pdf().set(opt).from(clone).save().then(finishPdf).catch(err => {
        console.error("PDF generation error: ", err);
        finishPdf();
      });
    });

    btnClearForm.addEventListener('click', () => {
      invoiceData.VendorName = "";
      invoiceData.VendorAddress = "";
      invoiceData.VendorTaxId = "";
      invoiceData.ClientName = "";
      invoiceData.ClientAddress = "";
      invoiceData.ClientTaxId = "";
      invoiceData.InvNo = "";
      invoiceData.Terms = "";
      invoiceData.CustomTaxLabel = "Tax";
      invoiceData.LineItems = [{ desc: "New Line Item Details", qty: 1, rate: 0.00 }];
      
      inputVendorName.value = "";
      inputVendorAddress.value = "";
      document.getElementById('inputVendorTaxId').value = "";
      inputClientName.value = "";
      inputClientAddress.value = "";
      document.getElementById('inputClientTaxId').value = "";
      inputInvNo.value = "";
      inputTerms.value = "";
      document.getElementById('inputCustomTaxLabel').value = "Tax";
      document.getElementById('inputCustomTaxRate').value = "5";
      document.getElementById('customTaxGroup').style.display = 'none';

      renderEditorTable();
      updatePreviewPage();
    });
  })();
</script>

<script is:inline>
  /* Template, accent colour and logo. The logo is drawn onto a canvas no
     larger than 400 x 160 so a 5 MB photo does not become a 5 MB PDF. */
  (function () {
    const box = document.getElementById('invoicePdfContainer');
    const tpl = document.getElementById('invTemplate');
    const acc = document.getElementById('invAccent');
    const logo = document.getElementById('invLogo');
    const img = document.getElementById('pdfLogo');
    const rm = document.getElementById('invLogoRemove');
    if (!box || !tpl) return;
    const apply = () => {
      box.classList.remove('tpl-modern', 'tpl-minimal');
      if (tpl.value !== 'classic') box.classList.add('tpl-' + tpl.value);
      box.style.setProperty('--inv-accent', tpl.value === 'minimal' ? '#171717' : acc.value);
      acc.disabled = tpl.value === 'minimal';
    };
    tpl.addEventListener('change', apply);
    acc.addEventListener('change', apply);
    logo.addEventListener('change', () => {
      const f = logo.files && logo.files[0];
      if (!f) return;
      const r = new FileReader();
      r.onload = () => {
        const im = new Image();
        im.onload = () => {
          const k = Math.min(1, 400 / im.width, 160 / im.height);
          const cv = document.createElement('canvas');
          cv.width = Math.max(1, Math.round(im.width * k));
          cv.height = Math.max(1, Math.round(im.height * k));
          cv.getContext('2d').drawImage(im, 0, 0, cv.width, cv.height);
          img.src = cv.toDataURL('image/png');
          img.hidden = false;
          rm.style.display = 'inline-flex';
        };
        im.src = r.result;
      };
      r.readAsDataURL(f);
    });
    rm.addEventListener('click', () => {
      img.removeAttribute('src');
      img.hidden = true;
      logo.value = '';
      rm.style.display = 'none';
    });
    apply();
  })();
</script>
