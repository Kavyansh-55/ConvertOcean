---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, headline, subtitle } = Astro.props;
---

<style>
  .pages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--spacing-md);
    max-height: 350px;
    overflow-y: auto;
  }
  .split-range-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--colors-hairline);
  }
  .split-range-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 260px;
    min-width: 0;
  }
  .split-range-field .form-input { max-width: 320px; }
  .split-range-hint {
    font-size: 11.5px;
    color: var(--colors-mute);
  }
  .split-range-hint.invalid { color: var(--colors-danger, #b91c1c); }
  .split-range-actions {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }
  @media (max-width: 600px) {
    .split-range-bar { align-items: stretch; }
    .split-range-field .form-input { max-width: none; }
  }
  .page-thumb-card {
    background-color: var(--colors-canvas-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: 6px;
    padding: var(--spacing-xs);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    cursor: pointer;
  }
  .page-thumb-card.selected {
    border-color: var(--colors-link);
    box-shadow: 0 0 0 1px var(--colors-link);
  }
  .page-thumb-checkbox {
    position: absolute;
    top: 4px;
    right: 4px;
    accent-color: var(--colors-ink);
    cursor: pointer;
  }
  .page-thumb-canvas {
    width: 80px;
    height: auto;
    background: white;
    border: 1px solid var(--colors-hairline);
  }
</style>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span>⚠️</span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="🥞" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">A single PDF (Max 25MB)</div>
  <input type="file" id="fileInput" class="file-input" accept=".pdf" />
</div>

<div id="splitWorkspace" class="panel-card" style="display: none; margin-top: var(--spacing-lg);">
  <div class="split-range-bar">
    <div class="split-range-field">
      <label class="input-label" for="pageRanges">Pages to extract</label>
      <input type="text" id="pageRanges" class="form-input" placeholder="e.g. 1-5, 8, 11-13" autocomplete="off" />
      <span class="split-range-hint" id="pageRangeHint">Type page numbers or ranges — or click the pages below.</span>
    </div>
    <div class="split-range-actions">
      <button type="button" class="button button-secondary" id="btnSelectAllPages">Select all</button>
      <button type="button" class="button button-secondary" id="btnClearPages">Clear selection</button>
    </div>
  </div>
  <div id="pagesGrid" class="pages-grid" style="margin-bottom: var(--spacing-md);"></div>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-sm);">
    <input type="text" id="splitOutputName" class="form-input" style="max-width: 300px;" value="extracted_pages.pdf" />
    <div class="button-group" style="display: flex; gap: var(--spacing-sm);">
      <button class="button button-primary" id="btnExtract">Extract Selected Pages</button>
      <button class="button button-danger" id="btnClear">Clear</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const splitWorkspace = document.getElementById('splitWorkspace');
    const pagesGrid = document.getElementById('pagesGrid');
    const splitOutputName = document.getElementById('splitOutputName');
    const btnExtract = document.getElementById('btnExtract');
    const btnClear = document.getElementById('btnClear');
    const pageRanges = document.getElementById('pageRanges');
    const pageRangeHint = document.getElementById('pageRangeHint');
    const btnSelectAllPages = document.getElementById('btnSelectAllPages');
    const btnClearPages = document.getElementById('btnClearPages');

    let splitFile = null;
    let selectedPages = new Set();

    // Drag and drop setup
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('dragover');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      let files = Array.from(e.dataTransfer.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e) => {
      let files = Array.from(e.target.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }

    function hideProgress() {
      progressOverlay.style.display = 'none';
    }

    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function handleFile(file) {
      hideError();
      showProgress(10, "Loading PDF pages…");
      const reader = new FileReader();
      reader.onload = async function(e) {
        try {
          const bytes = new Uint8Array(e.target.result);
          // pdf.js transfers the buffer it is handed to its worker, which
          // leaves the original detached and zero-length. Extraction later
          // read that empty buffer and every split failed with "Failed to
          // extract pages". Render the thumbnails from a throwaway copy and
          // keep these bytes intact for pdf-lib.
          const previewBytes = bytes.slice();
          const loadingTask = pdfjsLib.getDocument({ data: previewBytes });
          const pdf = await loadingTask.promise;

          splitFile = { name: file.name, bytes: bytes, count: pdf.numPages };
          splitOutputName.value = file.name.replace(/\.[^/.]+$/, "") + '_extracted.pdf';
          selectedPages.clear();
          pageRanges.value = '';
          editingRanges = false;
          updateSelectionHint();

          pagesGrid.innerHTML = '';
          
          for(let i = 1; i <= pdf.numPages; i++) {
            showProgress(Math.round(10 + (i / pdf.numPages) * 90), `Loading preview ${i} of ${pdf.numPages}…`);
            const page = await pdf.getPage(i);
            const viewport = page.getViewport({ scale: 0.2 });
            const canvas = document.createElement('canvas');
            canvas.className = 'page-thumb-canvas';
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            await page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise;
            
            const card = document.createElement('div');
            card.className = 'page-thumb-card';
            card.innerHTML = `
              <input type="checkbox" class="page-thumb-checkbox" id="p-chk-${i}" />
              <span style="font-size:11px; margin-top:4px;">Page ${i}</span>
            `;
            card.insertBefore(canvas, card.firstChild);
            
            const checkbox = card.querySelector('.page-thumb-checkbox');
            checkbox.addEventListener('change', () => togglePageSelect(i, card, checkbox));
            card.addEventListener('click', (evt) => {
              if (evt.target !== checkbox) {
                checkbox.checked = !checkbox.checked;
                togglePageSelect(i, card, checkbox);
              }
            });
            
            pagesGrid.appendChild(card);
          }
          splitWorkspace.style.display = 'block';
          dropZone.style.display = 'none';
        } catch(err) {
          showError("Failed to parse PDF structure.");
        }
        hideProgress();
      };
      reader.readAsArrayBuffer(file);
    }

    function togglePageSelect(pageIndex, cardElement, checkboxElement) {
      if (checkboxElement.checked) {
        selectedPages.add(pageIndex);
        cardElement.classList.add('selected');
      } else {
        selectedPages.delete(pageIndex);
        cardElement.classList.remove('selected');
      }
      // Touching the grid hands control back to it: without this the field stays
      // frozen on whatever was last typed and silently disagrees with the pages.
      editingRanges = false;
      syncRangeFromSelection();
    }

    // --- Page range input -------------------------------------------------
    // Clicking 40 thumbnails one at a time is the wrong tool for "pages 1-30",
    // so ranges and clicking drive the same selection and stay in sync.

    // "1-5, 8, 11-13" -> Set{1,2,3,4,5,8,11,12,13}. Returns null if the text is
    // malformed so the caller can say so instead of silently selecting nothing.
    function parsePageRanges(text, maxPage) {
      if (!text.trim()) return new Set();
      const out = new Set();
      for (const rawPart of text.split(',')) {
        const part = rawPart.trim();
        if (!part) continue;
        const range = part.match(/^(\d+)\s*[-–—]\s*(\d+)$/);
        const single = part.match(/^(\d+)$/);
        if (range) {
          let a = parseInt(range[1], 10);
          let b = parseInt(range[2], 10);
          if (!a || !b) return null;
          if (a > b) { const t = a; a = b; b = t; }   // "10-5" reads as 5-10
          if (a < 1 || b > maxPage) return null;
          for (let n = a; n <= b; n++) out.add(n);
        } else if (single) {
          const n = parseInt(single[1], 10);
          if (n < 1 || n > maxPage) return null;
          out.add(n);
        } else {
          return null;
        }
      }
      return out;
    }

    // Set{1,2,3,5,8,9} -> "1-3, 5, 8-9"
    function formatPageRanges(pages) {
      const sorted = Array.from(pages).sort((a, b) => a - b);
      const parts = [];
      let i = 0;
      while (i < sorted.length) {
        let j = i;
        while (j + 1 < sorted.length && sorted[j + 1] === sorted[j] + 1) j++;
        parts.push(i === j ? String(sorted[i]) : sorted[i] + '-' + sorted[j]);
        i = j + 1;
      }
      return parts.join(', ');
    }

    function applySelection(pages) {
      selectedPages = new Set(pages);
      pagesGrid.querySelectorAll('.page-thumb-card').forEach((card, idx) => {
        const pageNo = idx + 1;
        const box = card.querySelector('.page-thumb-checkbox');
        const on = selectedPages.has(pageNo);
        box.checked = on;
        card.classList.toggle('selected', on);
      });
      updateSelectionHint();
    }

    function updateSelectionHint(msg, invalid) {
      const total = (splitFile && splitFile.count) || 0;
      pageRangeHint.classList.toggle('invalid', !!invalid);
      pageRangeHint.textContent = msg || (
        selectedPages.size === 0
          ? 'Type page numbers or ranges — or click the pages below.'
          : selectedPages.size + ' of ' + total + ' page' + (total === 1 ? '' : 's') + ' selected.'
      );
    }

    // Typing wins over the field's own formatting: rewriting the text mid-edit
    // would fight the cursor, so the field is only reformatted on blur.
    let editingRanges = false;

    function syncRangeFromSelection() {
      if (!editingRanges) pageRanges.value = formatPageRanges(selectedPages);
      updateSelectionHint();
    }

    pageRanges.addEventListener('input', () => {
      editingRanges = true;
      const total = (splitFile && splitFile.count) || 0;
      const parsed = parsePageRanges(pageRanges.value, total);
      if (parsed === null) {
        updateSelectionHint('Use numbers and ranges within 1–' + total + ', e.g. "1-5, 8".', true);
        return;
      }
      applySelection(parsed);
    });

    pageRanges.addEventListener('blur', () => {
      editingRanges = false;
      const total = (splitFile && splitFile.count) || 0;
      if (parsePageRanges(pageRanges.value, total) !== null) {
        pageRanges.value = formatPageRanges(selectedPages);
        updateSelectionHint();
      }
    });

    btnSelectAllPages.addEventListener('click', () => {
      const total = (splitFile && splitFile.count) || 0;
      const all = [];
      for (let n = 1; n <= total; n++) all.push(n);
      applySelection(all);
      pageRanges.value = formatPageRanges(selectedPages);
    });

    btnClearPages.addEventListener('click', () => {
      applySelection([]);
      pageRanges.value = '';
    });

    btnExtract.addEventListener('click', async () => {
      hideError();
      if(selectedPages.size === 0) {
        showError("Please select at least 1 page.");
        return;
      }
      showProgress(20, "Extracting PDF pages…");
      try {
        if (!splitFile || !splitFile.bytes || !splitFile.bytes.byteLength) {
          throw new Error('PDF data unavailable — reload the page and add the file again.');
        }
        // pdf-lib needs its own copy: it also keeps a reference, and a second
        // extraction from the same bytes would otherwise read a spent buffer.
        const doc = await PDFLib.PDFDocument.load(splitFile.bytes.slice());
        const sub = await PDFLib.PDFDocument.create();
        const indices = Array.from(selectedPages).sort((a,b)=>a-b).map(x => x - 1);
        
        const copied = await sub.copyPages(doc, indices);
        copied.forEach(p => sub.addPage(p));
        
        const outBytes = await sub.save();
        let name = splitOutputName.value || 'extracted.pdf';
        if(!name.endsWith('.pdf')) name += '.pdf';
        window.downloadBlob(new Blob([outBytes], { type: "application/pdf" }), name);
      } catch(err) {
        // Say what actually went wrong. The bare message hid a detached
        // buffer for as long as this bug existed.
        showError("Failed to extract pages: " + (err && err.message ? err.message : 'unknown error'));
      }
      hideProgress();
    });

    btnClear.addEventListener('click', resetFile);

    function resetFile() {
      splitFile = null;
      selectedPages.clear();
      pageRanges.value = '';
      editingRanges = false;
      updateSelectionHint();
      splitWorkspace.style.display = 'none';
      dropZone.style.display = 'flex';
      fileInput.value = '';
      hideProgress();
    }
  })();
</script>
