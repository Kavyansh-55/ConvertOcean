---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, headline, subtitle } = Astro.props;
---

<style>
  .pages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--spacing-md);
    max-height: 350px;
    overflow-y: auto;
  }
  /* The mode selector. Written in the template, so scoped CSS reaches it —
     unlike the thumbnails below, which are built at runtime and need
     :global(). */
  .split-modes {
    border: 1px solid var(--colors-hairline);
    border-radius: 8px;
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
  }
  .split-modes legend {
    padding: 0 var(--spacing-xs);
  }
  .split-mode {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    font-size: 13.5px;
    line-height: 1.5;
    cursor: pointer;
    /* The label wraps its radio, so the whole row is one hit target with no
       dead zone between the two — and the row is tall enough to be a thumb
       target rather than just the 13px control. */
    min-height: 44px;
    padding-block: 6px;
    touch-action: manipulation;
  }
  .split-mode input[type="radio"] {
    flex: none;
    margin: 0;
    accent-color: var(--colors-ink);
  }
  .split-mode strong { font-weight: 600; }
  .split-mode-num {
    width: 5.5em;
    display: inline-block;
    padding: 2px 6px;
  }
  .split-mode-note {
    font-size: 12px;
    color: var(--colors-mute);
    margin: var(--spacing-xs) 0 0;
    min-height: 1.2em;
  }
  /* A whole-document mode ignores the page picker, so the picker says so
     rather than sitting there looking live. */
  .split-range-bar.inactive,
  .pages-grid.inactive { opacity: 0.55; }

  .split-range-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--colors-hairline);
  }
  .split-range-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 260px;
    min-width: 0;
  }
  .split-range-field .form-input { max-width: 320px; }
  /* 12px is the floor the mobile suite holds body text to, and this is body
     text. It sat at 11.5px unnoticed because the panel it lives in is hidden
     until a file is added, so nothing had ever measured it. */
  .split-range-hint {
    font-size: 12px;
    color: var(--colors-mute);
  }
  .split-range-hint.invalid { color: var(--colors-danger, #b91c1c); }
  .split-range-actions {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }
  @media (max-width: 600px) {
    .split-range-bar { align-items: stretch; }
    .split-range-field .form-input { max-width: none; }
  }
  :global(.page-thumb-card) {
    background-color: var(--colors-canvas-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: 6px;
    padding: var(--spacing-xs);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    cursor: pointer;
  }
  :global(.page-thumb-card.selected) {
    border-color: var(--colors-link);
    /* elevation removed — separation comes from colour, not shadow */
  }
  :global(.page-thumb-checkbox) {
    position: absolute;
    top: 4px;
    right: 4px;
    accent-color: var(--colors-ink);
    cursor: pointer;
  }
  :global(.page-thumb-canvas) {
    width: 80px;
    height: auto;
    background: white;
    border: 1px solid var(--colors-hairline);
  }
</style>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span class="banner-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="🥞" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">A single PDF (Max 25MB)</div>
  <button type="button" class="upload-cta">Choose file</button>
  <input type="file" id="fileInput" class="file-input" accept=".pdf" />
</div>

<div id="splitWorkspace" class="panel-card" style="display: none; margin-top: var(--spacing-lg);">
  <fieldset class="split-modes">
    <legend class="input-label">What should come out</legend>
    <label class="split-mode"><input type="radio" name="splitMode" value="one" checked />
      <span><strong>One PDF</strong> containing the pages I pick</span></label>
    <label class="split-mode"><input type="radio" name="splitMode" value="each" />
      <span><strong>A separate PDF for every page</strong> I pick, in a ZIP</span></label>
    <label class="split-mode"><input type="radio" name="splitMode" value="parts" />
      <span><strong>The whole PDF in</strong>{' '}
        <input type="number" id="partCount" class="form-input split-mode-num" value="2" min="2" max="100"
               aria-label="Number of equal parts" inputmode="numeric" autocomplete="off" />{' '}
        <strong>equal parts</strong>, in a ZIP</span></label>
    <label class="split-mode"><input type="radio" name="splitMode" value="size" />
      <span><strong>The whole PDF in parts under</strong>{' '}
        <input type="number" id="partSize" class="form-input split-mode-num" value="2" min="0.1" step="0.1"
               aria-label="Maximum size of each part, in MB" inputmode="decimal" autocomplete="off" />{' '}
        <strong>MB each</strong>, in a ZIP</span></label>
    <p class="split-mode-note" id="splitModeNote"></p>
  </fieldset>
  <div class="split-range-bar">
    <div class="split-range-field">
      <label class="input-label" for="pageRanges">Pages to extract</label>
      <input type="text" id="pageRanges" class="form-input" placeholder="e.g. 1-5, 8, 11-13" autocomplete="off" />
      <span class="split-range-hint" id="pageRangeHint">Type page numbers or ranges — or click the pages below.</span>
    </div>
    <div class="split-range-actions">
      <button type="button" class="button button-secondary" id="btnSelectAllPages">Select all</button>
      <button type="button" class="button button-secondary" id="btnClearPages">Clear selection</button>
    </div>
  </div>
  <div id="pagesGrid" class="pages-grid" style="margin-bottom: var(--spacing-md);"></div>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-sm);">
    <input type="text" id="splitOutputName" class="form-input" style="max-width: 300px;" value="extracted_pages.pdf"
           aria-label="Name for the file you get back" autocomplete="off" />
    <div class="button-group" style="display: flex; gap: var(--spacing-sm);">
      <button class="button button-primary" id="btnExtract">Extract Selected Pages</button>
      <button class="button button-danger" id="btnClear">Clear</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const splitWorkspace = document.getElementById('splitWorkspace');
    const pagesGrid = document.getElementById('pagesGrid');
    const splitOutputName = document.getElementById('splitOutputName');
    const btnExtract = document.getElementById('btnExtract');
    const partCount = document.getElementById('partCount');
    const partSize = document.getElementById('partSize');
    const splitModeNote = document.getElementById('splitModeNote');
    const modeRadios = Array.from(document.querySelectorAll('input[name="splitMode"]'));
    const btnClear = document.getElementById('btnClear');
    const pageRanges = document.getElementById('pageRanges');
    const pageRangeHint = document.getElementById('pageRangeHint');
    const btnSelectAllPages = document.getElementById('btnSelectAllPages');
    const btnClearPages = document.getElementById('btnClearPages');

    let splitFile = null;
    let selectedPages = new Set();

    // Drag and drop setup
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('dragover');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      let files = Array.from(e.dataTransfer.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e) => {
      let files = Array.from(e.target.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }

    function hideProgress() {
      progressOverlay.style.display = 'none';
    }

    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function handleFile(file) {
      /* The drop zone promises 25MB; this is what keeps it. Published by
         [tool].astro because this script is is:inline and cannot import. */
      const tooLarge = window.coFileTooLarge && window.coFileTooLarge(file, 25);
      if (tooLarge) { showError(tooLarge); return; }
      hideError();
      showProgress(10, "Loading PDF pages…");
      const reader = new FileReader();
      reader.onload = async function(e) {
        try {
          const bytes = new Uint8Array(e.target.result);
          // pdf.js transfers the buffer it is handed to its worker, which
          // leaves the original detached and zero-length. Extraction later
          // read that empty buffer and every split failed with "Failed to
          // extract pages". Render the thumbnails from a throwaway copy and
          // keep these bytes intact for pdf-lib.
          const previewBytes = bytes.slice();
          const loadingTask = pdfjsLib.getDocument({ data: previewBytes, isEvalSupported: false });
          const pdf = await loadingTask.promise;

          splitFile = { name: file.name, bytes: bytes, count: pdf.numPages };
          splitOutputName.value = file.name.replace(/\.[^/.]+$/, "") + '_extracted.pdf';
          selectedPages.clear();
          pageRanges.value = '';
          editingRanges = false;
          updateSelectionHint();

          pagesGrid.innerHTML = '';
          
          for(let i = 1; i <= pdf.numPages; i++) {
            showProgress(Math.round(10 + (i / pdf.numPages) * 90), `Loading preview ${i} of ${pdf.numPages}…`);
            const page = await pdf.getPage(i);
            const viewport = page.getViewport({ scale: 0.2 });
            const canvas = document.createElement('canvas');
            canvas.className = 'page-thumb-canvas';
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            await page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise;
            
            const card = document.createElement('div');
            card.className = 'page-thumb-card';
            card.innerHTML = `
              <input type="checkbox" class="page-thumb-checkbox" id="p-chk-${i}" />
              <span style="font-size:11px; margin-top:4px;">Page ${i}</span>
            `;
            card.insertBefore(canvas, card.firstChild);
            
            const checkbox = card.querySelector('.page-thumb-checkbox');
            checkbox.addEventListener('change', () => togglePageSelect(i, card, checkbox));
            card.addEventListener('click', (evt) => {
              if (evt.target !== checkbox) {
                checkbox.checked = !checkbox.checked;
                togglePageSelect(i, card, checkbox);
              }
            });
            
            pagesGrid.appendChild(card);
          }
          splitWorkspace.style.display = 'block';
          dropZone.style.display = 'none';
        } catch(err) {
          showError("Failed to parse PDF structure.");
        }
        hideProgress();
      };
      reader.readAsArrayBuffer(file);
    }

    function togglePageSelect(pageIndex, cardElement, checkboxElement) {
      if (checkboxElement.checked) {
        selectedPages.add(pageIndex);
        cardElement.classList.add('selected');
      } else {
        selectedPages.delete(pageIndex);
        cardElement.classList.remove('selected');
      }
      // Touching the grid hands control back to it: without this the field stays
      // frozen on whatever was last typed and silently disagrees with the pages.
      editingRanges = false;
      syncRangeFromSelection();
    }

    // --- Page range input -------------------------------------------------
    // Clicking 40 thumbnails one at a time is the wrong tool for "pages 1-30",
    // so ranges and clicking drive the same selection and stay in sync.

    // "1-5, 8, 11-13" -> Set{1,2,3,4,5,8,11,12,13}. Returns null if the text is
    // malformed so the caller can say so instead of silently selecting nothing.
    function parsePageRanges(text, maxPage) {
      if (!text.trim()) return new Set();
      const out = new Set();
      for (const rawPart of text.split(',')) {
        const part = rawPart.trim();
        if (!part) continue;
        const range = part.match(/^(\d+)\s*[-–—]\s*(\d+)$/);
        const single = part.match(/^(\d+)$/);
        if (range) {
          let a = parseInt(range[1], 10);
          let b = parseInt(range[2], 10);
          if (!a || !b) return null;
          if (a > b) { const t = a; a = b; b = t; }   // "10-5" reads as 5-10
          if (a < 1 || b > maxPage) return null;
          for (let n = a; n <= b; n++) out.add(n);
        } else if (single) {
          const n = parseInt(single[1], 10);
          if (n < 1 || n > maxPage) return null;
          out.add(n);
        } else {
          return null;
        }
      }
      return out;
    }

    // Set{1,2,3,5,8,9} -> "1-3, 5, 8-9"
    function formatPageRanges(pages) {
      const sorted = Array.from(pages).sort((a, b) => a - b);
      const parts = [];
      let i = 0;
      while (i < sorted.length) {
        let j = i;
        while (j + 1 < sorted.length && sorted[j + 1] === sorted[j] + 1) j++;
        parts.push(i === j ? String(sorted[i]) : sorted[i] + '-' + sorted[j]);
        i = j + 1;
      }
      return parts.join(', ');
    }

    function applySelection(pages) {
      selectedPages = new Set(pages);
      pagesGrid.querySelectorAll('.page-thumb-card').forEach((card, idx) => {
        const pageNo = idx + 1;
        const box = card.querySelector('.page-thumb-checkbox');
        const on = selectedPages.has(pageNo);
        box.checked = on;
        card.classList.toggle('selected', on);
      });
      updateSelectionHint();
    }

    function updateSelectionHint(msg, invalid) {
      const total = (splitFile && splitFile.count) || 0;
      pageRangeHint.classList.toggle('invalid', !!invalid);
      pageRangeHint.textContent = msg || (
        selectedPages.size === 0
          ? 'Type page numbers or ranges — or click the pages below.'
          : selectedPages.size + ' of ' + total + ' page' + (total === 1 ? '' : 's') + ' selected.'
      );
    }

    // Typing wins over the field's own formatting: rewriting the text mid-edit
    // would fight the cursor, so the field is only reformatted on blur.
    let editingRanges = false;

    function syncRangeFromSelection() {
      if (!editingRanges) pageRanges.value = formatPageRanges(selectedPages);
      updateSelectionHint();
    }

    pageRanges.addEventListener('input', () => {
      editingRanges = true;
      const total = (splitFile && splitFile.count) || 0;
      const parsed = parsePageRanges(pageRanges.value, total);
      if (parsed === null) {
        updateSelectionHint('Use numbers and ranges within 1–' + total + ', e.g. "1-5, 8".', true);
        return;
      }
      applySelection(parsed);
    });

    pageRanges.addEventListener('blur', () => {
      editingRanges = false;
      const total = (splitFile && splitFile.count) || 0;
      if (parsePageRanges(pageRanges.value, total) !== null) {
        pageRanges.value = formatPageRanges(selectedPages);
        updateSelectionHint();
      }
    });

    btnSelectAllPages.addEventListener('click', () => {
      const total = (splitFile && splitFile.count) || 0;
      const all = [];
      for (let n = 1; n <= total; n++) all.push(n);
      applySelection(all);
      pageRanges.value = formatPageRanges(selectedPages);
    });

    btnClearPages.addEventListener('click', () => {
      applySelection([]);
      pageRanges.value = '';
    });

    function currentMode() {
      const on = modeRadios.find((r) => r.checked);
      return on ? on.value : 'one';
    }

    /* A whole-document mode does not use the page picker. Saying so beats
       leaving a live-looking selection that has no effect on the output. */
    function syncMode() {
      const mode = currentMode();
      const whole = mode === 'parts' || mode === 'size';
      const bar = document.querySelector('.split-range-bar');
      /* Dimmed but still focusable and clickable is the worst of both: it
         looks disabled and behaves live. `inert` takes the picker out of the
         tab order and stops it responding, which is what the dimming claims
         is happening. */
      if (bar) {
        bar.classList.toggle('inactive', whole);
        bar.toggleAttribute('inert', whole);
      }
      pagesGrid.classList.toggle('inactive', whole);
      pagesGrid.toggleAttribute('inert', whole);
      btnExtract.textContent = mode === 'one' ? 'Extract Selected Pages'
        : mode === 'each' ? 'Extract Pages as Separate Files'
        : 'Split into Parts';
      splitModeNote.textContent = whole
        ? 'Every page is included — the selection above is not used in this mode.'
        : '';
    }
    modeRadios.forEach((r) => r.addEventListener('change', syncMode));
    syncMode();

    /** The output name with its extension removed, for building part names. */
    function baseName() {
      const raw = (splitOutputName.value || 'split.pdf').trim();
      return raw.replace(/\.(pdf|zip)$/i, '') || 'split';
    }

    /** A PDF holding exactly these 1-based page numbers, as bytes. */
    async function buildPart(doc, pageNumbers) {
      const sub = await PDFLib.PDFDocument.create();
      const copied = await sub.copyPages(doc, pageNumbers.map((n) => n - 1));
      copied.forEach((pg) => sub.addPage(pg));
      return sub.save();
    }

    /* Contiguous chunks, as evenly as they divide. 10 pages into 3 gives
       4/3/3 rather than 3/3/3 and a leftover part nobody asked for. */
    function equalParts(total, count) {
      const groups = [];
      const base = Math.floor(total / count);
      let extra = total % count;
      let page = 1;
      for (let i = 0; i < count; i++) {
        const take = base + (extra > 0 ? 1 : 0);
        if (extra > 0) extra--;
        if (take === 0) break;
        const pages = [];
        for (let k = 0; k < take; k++) pages.push(page++);
        groups.push(pages);
      }
      return groups;
    }

    /**
     * Parts that each fit under a byte budget.
     *
     * Per-page sizes are estimated first, because assembling and saving the
     * whole candidate part once per added page is unusably slow on a long
     * document. But an estimate is not what the reader was promised, so every
     * assembled part is then measured, and pages are handed back to the next
     * part until it really fits. The size that decides the split is always the
     * measured one.
     *
     * A single page larger than the budget cannot be made to fit by splitting.
     * It becomes a part of its own and is reported, rather than looping.
     */
    async function sizedParts(doc, total, budget, onProgress) {
      const est = [];
      for (let n = 1; n <= total; n++) {
        est.push((await buildPart(doc, [n])).byteLength);
        if (onProgress) onProgress(n / total);
      }

      const groups = [];
      const oversize = [];
      let n = 1;
      while (n <= total) {
        const pages = [];
        let running = 0;
        while (n <= total && (pages.length === 0 || running + est[n - 1] <= budget)) {
          pages.push(n);
          running += est[n - 1];
          n++;
        }
        let bytes = await buildPart(doc, pages);
        while (bytes.byteLength > budget && pages.length > 1) {
          n = pages.pop();
          bytes = await buildPart(doc, pages);
        }
        if (bytes.byteLength > budget) oversize.push(pages[0]);
        groups.push({ pages: pages, bytes: bytes });
      }
      return { groups: groups, oversize: oversize };
    }

    async function zipAndDownload(entries, zipName) {
      if (typeof JSZip === 'undefined') {
        throw new Error('The archive engine did not load. Check your connection and reload the page.');
      }
      const zip = new JSZip();
      for (const entry of entries) zip.file(entry[0], entry[1]);
      const blob = await zip.generateAsync({ type: 'blob' });
      window.downloadBlob(blob, zipName);
    }

    btnExtract.addEventListener('click', async () => {
      hideError();
      const mode = currentMode();
      const needsSelection = mode === 'one' || mode === 'each';
      if (needsSelection && selectedPages.size === 0) {
        showError("Please select at least 1 page.");
        return;
      }
      showProgress(20, "Extracting PDF pages…");
      try {
        if (!splitFile || !splitFile.bytes || !splitFile.bytes.byteLength) {
          throw new Error('PDF data unavailable — reload the page and add the file again.');
        }
        // pdf-lib needs its own copy: it also keeps a reference, and a second
        // extraction from the same bytes would otherwise read a spent buffer.
        const doc = await PDFLib.PDFDocument.load(splitFile.bytes.slice());
        const total = doc.getPageCount();
        const picked = Array.from(selectedPages).sort((a, b) => a - b);
        const base = baseName();

        if (mode === 'one') {
          const outBytes = await buildPart(doc, picked);
          let name = splitOutputName.value || 'extracted.pdf';
          if (!name.endsWith('.pdf')) name += '.pdf';
          window.downloadBlob(new Blob([outBytes], { type: "application/pdf" }), name);

        } else if (mode === 'each') {
          const entries = [];
          const pad = String(total).length;
          for (let i = 0; i < picked.length; i++) {
            const n = picked[i];
            entries.push([base + '_page_' + String(n).padStart(pad, '0') + '.pdf', await buildPart(doc, [n])]);
            showProgress(20 + Math.round(70 * (i + 1) / picked.length), 'Writing page ' + n + '…');
          }
          showProgress(95, 'Packing ' + entries.length + ' files…');
          await zipAndDownload(entries, base + '_pages.zip');

        } else if (mode === 'parts') {
          const want = Math.max(2, Math.min(100, parseInt(partCount.value, 10) || 2));
          if (want > total) {
            throw new Error('This PDF has ' + total + ' page' + (total === 1 ? '' : 's') +
              ', so it cannot be split into ' + want + ' parts.');
          }
          const groups = equalParts(total, want);
          const entries = [];
          const pad = String(groups.length).length;
          for (let i = 0; i < groups.length; i++) {
            entries.push([base + '_part_' + String(i + 1).padStart(pad, '0') + '.pdf', await buildPart(doc, groups[i])]);
            showProgress(20 + Math.round(70 * (i + 1) / groups.length), 'Writing part ' + (i + 1) + ' of ' + groups.length + '…');
          }
          showProgress(95, 'Packing ' + entries.length + ' files…');
          await zipAndDownload(entries, base + '_parts.zip');

        } else {
          const mb = parseFloat(partSize.value);
          if (!(mb > 0)) throw new Error('Enter a size in MB, for example 2.');
          const budget = Math.round(mb * 1024 * 1024);
          const sized = await sizedParts(doc, total, budget,
            (frac) => showProgress(20 + Math.round(50 * frac), 'Measuring pages…'));
          const entries = [];
          const pad = String(sized.groups.length).length;
          sized.groups.forEach((g, i) => {
            entries.push([base + '_part_' + String(i + 1).padStart(pad, '0') + '.pdf', g.bytes]);
          });
          showProgress(95, 'Packing ' + entries.length + ' files…');
          await zipAndDownload(entries, base + '_parts.zip');
          if (sized.oversize.length) {
            showError('Split into ' + sized.groups.length + ' parts, but page' +
              (sized.oversize.length === 1 ? ' ' : 's ') + sized.oversize.join(', ') +
              ' is larger than ' + mb + ' MB on its own, so that part is over the limit. ' +
              'Compressing the PDF first will bring it down.');
          }
        }
      } catch(err) {
        // Say what actually went wrong. The bare message hid a detached
        // buffer for as long as this bug existed.
        showError("Failed to extract pages: " + (err && err.message ? err.message : 'unknown error'));
      }
      hideProgress();
    });

    btnClear.addEventListener('click', resetFile);

    function resetFile() {
      splitFile = null;
      selectedPages.clear();
      pageRanges.value = '';
      editingRanges = false;
      updateSelectionHint();
      splitWorkspace.style.display = 'none';
      dropZone.style.display = 'flex';
      syncMode();
      fileInput.value = '';
      hideProgress();
    }
  })();
</script>
