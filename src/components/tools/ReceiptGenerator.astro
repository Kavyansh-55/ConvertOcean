---
import { t } from '../../i18n/ui';
const { slug, headline, subtitle, lang = 'en'} = Astro.props;

/* Sample data per locale, rendered into the form AND read by the script from
   #rcptSample, so the two cannot drift. The Portuguese page used to open on a
   Bengaluru vendor, a Mumbai client, GST at 18% and US dollars — with no Real
   in the currency list and no PIX, on the page built for "modelo de recibo".
   The English sample is unchanged. */
const isPt = lang === 'pt';
/* Indonesian pages (/id/kwitansi/) open on an Indonesian kuitansi: Rupiah,
   bank transfer, and a total over Rp5.000.000 so the stamp-duty box shows —
   UU 10/2020: a receipt stating more than Rp5.000.000 carries Rp10.000 bea
   meterai. Fictional .example addresses, as everywhere else. */
const isId = lang === 'id';
const sample = isId ? {
  No: 'KW-2026-001',
  PayMethod: 'Bank Transfer',
  TaxModel: 'none',
  CustomTaxLabel: 'Pajak',
  TaxRate: 0,
  VendorName: 'Studio Contoh',
  VendorAddress: 'Jl. Melati No. 12\nJakarta Selatan 12345\nhalo@studiocontoh.example',
  ClientName: 'Budi Santoso',
  ClientAddress: 'Jl. Merdeka No. 45\nBandung 40111\nbudi@contoh.example',
  Notes: 'Pembayaran untuk jasa di atas telah diterima lunas. Terima kasih.',
  LineItems: [
    { desc: 'Pembuatan website company profile', qty: 1, rate: 3500000 },
    { desc: 'Paket perawatan bulanan', qty: 2, rate: 1250000 }
  ]
} : isPt ? {
  No: 'REC-2026-001',
  PayMethod: 'PIX',
  TaxModel: 'none',
  CustomTaxLabel: 'Imposto',
  TaxRate: 0,   // must travel with TaxModel: 'none' + 0.18 hid the row but still added 18% to the total
  VendorName: 'Estúdio Exemplo',
  VendorAddress: 'Rua das Flores, 123 — Sala 4\nSão Paulo, SP 01000-000\ncontato@estudioexemplo.com.br',
  ClientName: 'Maria Oliveira',
  ClientAddress: 'Av. Brasil, 456\nRio de Janeiro, RJ 20000-000\nmaria@exemplo.com.br',
  Notes: 'Recebemos o pagamento integral dos serviços descritos acima. Obrigado!',
  LineItems: [
    { desc: 'Criação de site institucional', qty: 1, rate: 3500.00 },
    { desc: 'Pacote de manutenção mensal', qty: 2, rate: 750.00 }
  ]
} : {
  /* US sample (2026-09-28): the English site targets US/UK/CA/AU, and the
     page used to open on a Bengaluru vendor, a Mumbai client and GST 18%.
     .example addresses (RFC 2606) so the sample points at no real business. */
  No: 'REC-2026-001',
  PayMethod: 'Credit Card',
  TaxModel: 'none',
  CustomTaxLabel: 'Tax',
  TaxRate: 0,
  VendorName: 'Brightline Design Co.',
  VendorAddress: '450 Market Street, Suite 12\nSan Francisco, CA 94105\nhello@brightline.example',
  ClientName: 'Harbor & Pine LLC',
  ClientAddress: '88 Congress Street\nBoston, MA 02109\naccounts@harborpine.example',
  Notes: 'Thank you for your payment.\nThis receipt confirms payment has been received in full.',
  LineItems: [
    { desc: 'Website Development Services', qty: 1, rate: 3500.00 },
    { desc: 'SEO Optimization Package', qty: 2, rate: 750.00 }
  ]
};
---

<style>
  .split-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }
  @media (max-width: 1024px) {
    .split-workspace {
      grid-template-columns: 1fr;
    }
  }
  .editor-pane {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  .preview-pane {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-x: auto;
  }
  .form-card {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: 8px;
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    /* elevation removed — separation comes from colour, not shadow */
  }
  .form-card-title {
    font-size: 13px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: var(--colors-mute);
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: var(--spacing-xs);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
  }
  .textarea-input {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--colors-hairline);
    padding: var(--spacing-sm);
    font-size: 13px;
    background-color: var(--colors-canvas);
    color: var(--colors-ink);
    resize: vertical;
    min-height: 60px;
    font-family: inherit;
  }
  .textarea-input:focus {
    border-color: var(--colors-ink);
  }
  .item-edit-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .item-edit-table th {
    text-align: left;
    font-family: var(--font-sans);
    font-size: 12px; /* was 11px: under the 12px floor verify-mobile enforces */
    color: var(--colors-mute);
    text-transform: uppercase;
    padding-bottom: 6px;
  }
  :global(.item-edit-row td) {
    padding: var(--spacing-xs) 0;
  }
  :global(.item-delete-btn) {
    background: none;
    border: none;
    color: var(--colors-error);
    cursor: pointer;
    font-size: 18px;
    padding: 0 var(--spacing-xs);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .a4-wrapper {
    transform-origin: top center;
    /* elevation removed — separation comes from colour, not shadow */
    background-color: #ffffff;
    color: #171717;
  }
  .receipt-pdf-container {
    --inv-accent: #171717;
    width: 700px;
    min-height: 800px;
    padding: 40px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #171717;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .receipt-pdf-header {
    display: flex;
    justify-content: space-between;
    border-bottom: 2px solid var(--inv-accent);
    padding-bottom: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }
  /* Optional logo, scaled down in the browser before it is placed. */
  .pdf-logo {
    display: block;
    max-height: 56px;
    max-width: 180px;
    object-fit: contain;
    margin-bottom: 8px;
  }
  .pdf-logo[hidden] { display: none; }
  /* Templates, as on the invoice generator. The class is toggled at runtime,
     so it is wrapped in :global() (the scoped-CSS note in CLAUDE.md). */
  .receipt-pdf-container:global(.tpl-modern) .receipt-pdf-header {
    background: var(--inv-accent);
    margin: -40px -40px var(--spacing-xl);
    padding: 32px 40px;
    border-bottom: 0;
  }
  .receipt-pdf-container:global(.tpl-modern) .pdf-brand-title { color: #ffffff; }
  .receipt-pdf-container:global(.tpl-modern) .pdf-doc-type,
  .receipt-pdf-container:global(.tpl-modern) .receipt-pdf-header .pdf-meta-text { color: rgba(255, 255, 255, 0.85); }
  .receipt-pdf-container:global(.tpl-modern) .receipt-pdf-table th {
    background: var(--inv-accent);
    color: #ffffff;
    border-bottom: 0;
    padding: 8px 6px;
  }
  .receipt-pdf-container:global(.tpl-minimal) .receipt-pdf-header { border-bottom: 1px solid #d4d4d4; }
  .receipt-pdf-container:global(.tpl-minimal) .pdf-brand-title { font-weight: 600; font-size: 20px; letter-spacing: -0.6px; }
  .receipt-pdf-container:global(.tpl-minimal) .receipt-pdf-table th { border-bottom: 1px solid #d4d4d4; }
  .receipt-pdf-container:global(.tpl-minimal) .receipt-pdf-table tr:last-child td { border-bottom: 1px solid #d4d4d4; }
  .receipt-pdf-container:global(.tpl-minimal) .pdf-totals-table tr.grand-total td { border-top: 1px solid #171717; }
  .pdf-brand-title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -1.2px;
  }
  .pdf-doc-type {
    font-size: 16px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: #888888;
    text-align: right;
  }
  .pdf-meta-text {
    font-size: 12px;
    font-family: var(--font-sans);
    color: #4d4d4d;
    margin-top: 4px;
  }
  .receipt-pdf-addresses {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }
  .address-col-title {
    font-size: 10px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: #888888;
    margin-bottom: 6px;
  }
  .address-details {
    font-size: 12px;
    line-height: 1.6;
    color: #4d4d4d;
    white-space: pre-wrap;
  }
  .receipt-pdf-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--spacing-2xl);
  }
  .receipt-pdf-table th {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    color: #888888;
    border-bottom: 1px solid var(--inv-accent);
    padding: var(--spacing-xs) 6px;
    text-align: left;
  }
  .receipt-pdf-table td {
    font-size: 12px;
    padding: 12px 6px;
    border-bottom: 1px solid #ebebeb;
    color: #4d4d4d;
  }
  .receipt-pdf-table tr:last-child td {
    border-bottom: 1px solid #171717;
  }
  .receipt-pdf-table th.right-align, .receipt-pdf-table td.right-align {
    text-align: right;
  }
  .pdf-summary-block {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--spacing-2xl);
  }
  .pdf-totals-table {
    width: 250px;
    border-collapse: collapse;
    font-size: 13px;
  }
  .pdf-totals-table td {
    padding: var(--spacing-xs) 6px;
    color: #4d4d4d;
  }
  .pdf-totals-table tr.grand-total td {
    font-weight: var(--fw-bold);
    color: #171717;
    font-size: 16px;
    border-top: 2px solid var(--inv-accent);
    padding-top: var(--spacing-sm);
  }
  .pdf-totals-table td.right-align {
    text-align: right;
    font-family: var(--font-sans);
  }
  .receipt-pdf-footer {
    border-top: 1px solid #ebebeb;
    padding-top: var(--spacing-md);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .pdf-terms {
    max-width: 400px;
    font-size: 11px;
    color: #888888;
    line-height: 1.6;
    white-space: pre-wrap;
  }
  /* Indonesian kuitansi: amount in words, signature, stamp-duty box. Paper
     colours, like the rest of the printed sheet. */
  .rcpt-id-block {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--spacing-md);
    margin: 0 0 var(--spacing-md);
  }
  .rcpt-id-words {
    font-size: 12px;
    font-style: italic;
    color: #171717;
    max-width: 60%;
  }
  .rcpt-id-sign { text-align: center; min-width: 170px; }
  .rcpt-id-meterai {
    display: inline-block;
    border: 1px dashed #888888;
    color: #888888;
    font-size: 10px;
    padding: 14px 10px;
    margin-bottom: 6px;
  }
  .rcpt-id-signline {
    border-top: 1px solid #171717;
    padding-top: 4px;
    font-size: 11px;
    color: #171717;
  }
  .pdf-thankyou {
    font-size: 12px;
    font-weight: 500;
    color: #171717;
    font-style: italic;
  }
  .payment-badge {
    display: inline-block;
    background-color: #e6f7ef;
    color: #0a7c42;
    font-size: 11px;
    font-weight: var(--fw-bold);
    padding: 4px 10px;
    border-radius: 100px;
    font-family: var(--font-sans);
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr !important;
      gap: var(--spacing-xs) !important;
    }
    .item-edit-table,
    .item-edit-table thead,
    .item-edit-table tbody,
    .item-edit-table tr,
    .item-edit-table td {
      display: block !important;
      width: 100% !important;
    }
    .item-edit-table thead {
      display: none !important;
    }
    :global(.item-edit-row) {
      position: relative !important;
      padding: var(--spacing-sm) 0 !important;
      border-bottom: 1px solid var(--colors-hairline) !important;
      display: flex !important;
      flex-direction: column !important;
      gap: var(--spacing-xs) !important;
    }
    :global(.item-edit-row td) {
      padding: 0 !important;
    }
    :global(.item-edit-row td:nth-child(1)::before) {
      content: "Description";
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--colors-mute);
      display: block;
      margin-bottom: 4px;
    }
    :global(.item-edit-row td:nth-child(2)::before) {
      content: "Quantity";
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--colors-mute);
      display: block;
      margin-bottom: 4px;
    }
    :global(.item-edit-row td:nth-child(3)::before) {
      content: "Rate";
      font-size: 11px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--colors-mute);
      display: block;
      margin-bottom: 4px;
    }
    :global(.item-edit-row td:nth-child(4)) {
      position: absolute !important;
      right: 0 !important;
      top: 24px !important;
    }
    :global(.item-delete-btn) {
      padding: 4px !important;
      font-size: 22px !important;
    }
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<div class="split-workspace">
  <section class="editor-pane">
    <div class="form-card">
      <div class="form-card-title">{t('Receipt Settings', lang)}</div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="rcptNo">{t('Receipt Number', lang)}</label>
          <input type="text" id="rcptNo" class="form-input" value="REC-2026-001" />
        </div>
        <div class="form-group">
          <label class="form-label" for="rcptDate">{t('Receipt Date', lang)}</label>
          <input type="date" id="rcptDate" class="form-input" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="rcptCurrency">{t('Currency', lang)}</label>
          <select id="rcptCurrency" class="select-input">
            <option value="$" selected={!isPt && !isId}>{t('$ – US Dollar (USD)', lang)}</option>
            <option value="Rp" selected={isId}>{t('Rp – Indonesian Rupiah (IDR)', lang)}</option>
            <option value="R$" selected={isPt}>{t('R$ – Real Brasileiro (BRL)', lang)}</option>
            <option value="&euro;">{t('€ – Euro (EUR)', lang)}</option>
            <option value="&pound;">{t('£ – British Pound (GBP)', lang)}</option>
            <option value="&#8377;">{t('₹ – Indian Rupee (INR)', lang)}</option>
            <option value="&yen;">{t('¥ – Japanese Yen (JPY)', lang)}</option>
            <option value="&yen;">{t('¥ – Chinese Yuan (CNY)', lang)}</option>
            <option value="C$">{t('C$ – Canadian Dollar (CAD)', lang)}</option>
            <option value="A$">{t('A$ – Australian Dollar (AUD)', lang)}</option>
            <option value="CHF">{t('CHF – Swiss Franc', lang)}</option>
            <option value="AED">{t('AED – UAE Dirham', lang)}</option>
            <option value="SGD">{t('SGD – Singapore Dollar', lang)}</option>
            <option value="R">{t('R – South African Rand', lang)}</option>
            <option value="zł">{t('zł – Polish Złoty (PLN)', lang)}</option>
            <option value="₩">{t('₩ – South Korean Won (KRW)', lang)}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="rcptTaxSelect">{t('Tax Configuration', lang)}</label>
          <select id="rcptTaxSelect" class="select-input">
            <option value="none" selected>{t('No Tax', lang)}</option>
            {isId && <option value="PPN">PPN (11%)</option>}
            <option value="GST">GST (18%)</option>
            <option value="IGST">IGST (18%)</option>
            <option value="VAT">VAT (15%)</option>
            <option value="custom">{t('Custom Tax Rate', lang)}</option>
          </select>
        </div>
      </div>
      <div id="rcptCustomTaxGroup" class="form-row" style="display: none; margin-top: var(--spacing-xxs);">
        <div class="form-group">
          <label class="form-label" for="rcptCustomTaxLabel">{t('Tax Label', lang)}</label>
          <input type="text" id="rcptCustomTaxLabel" class="form-input" value={sample.CustomTaxLabel} style="height: 36px; font-size: 13px;" />
        </div>
        <div class="form-group">
          <label class="form-label" for="rcptCustomTaxRate">{t('Tax Rate (%)', lang)}</label>
          <input type="number" id="rcptCustomTaxRate" class="form-input" value="5" min="0" max="100" step="0.01" style="height: 36px; font-size: 13px;" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="rcptPayMethod">{t('Payment Method', lang)}</label>
          <select id="rcptPayMethod" class="select-input">
            <option value="PIX" selected={isPt}>PIX</option>
            {isId && <option value="QRIS">QRIS</option>}
            <option value="Cash">{t('Cash', lang)}</option>
            <option value="Credit Card" selected={!isPt && !isId}>{t('Credit Card', lang)}</option>
            <option value="Debit Card">{t('Debit Card', lang)}</option>
            <option value="Bank Transfer" selected={isId}>{t('Bank Transfer', lang)}</option>
            <option value="PayPal">PayPal</option>
            <option value="Check">{t('Check', lang)}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Card: Design -->
    <div class="form-card">
      <div class="form-card-title">{t('Design', lang)}</div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="rcptTemplate">{t('Template', lang)}</label>
          <select id="rcptTemplate" class="select-input" name="template">
            <option value="classic" selected>{t('Classic', lang)}</option>
            <option value="modern">{t('Modern (colour header)', lang)}</option>
            <option value="minimal">{t('Minimal (prints cheaply)', lang)}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="rcptAccent">{t('Accent colour', lang)}</label>
          <select id="rcptAccent" class="select-input" name="accent-colour">
            <option value="#171717" selected>{t('Charcoal', lang)}</option>
            <option value="#1d4ed8">{t('Blue', lang)}</option>
            <option value="#047857">{t('Green', lang)}</option>
            <option value="#b91c1c">{t('Red', lang)}</option>
            <option value="#6d28d9">{t('Purple', lang)}</option>
            <option value="#c2410c">{t('Orange', lang)}</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="rcptLogo">{t('Logo (optional, stays on your device)', lang)}</label>
        <input type="file" id="rcptLogo" class="form-input" accept="image/png,image/jpeg,image/webp" />
      </div>
      <button type="button" class="button button-secondary" id="rcptLogoRemove" style="display: none; height: 34px; font-size: 13px;">{t('Remove logo', lang)}</button>
    </div>

    <div class="form-card">
      <div class="form-card-title">{t('From (Business / Seller)', lang)}</div>
      <div class="form-group">
        <label class="form-label" for="rcptVendorName">{t('Business Name', lang)}</label>
        <input type="text" id="rcptVendorName" class="form-input" value={sample.VendorName} />
      </div>
      <div class="form-group">
        <label class="form-label" for="rcptVendorAddress">{t('Address & Contact', lang)}</label>
        <textarea id="rcptVendorAddress" class="textarea-input">{sample.VendorAddress}</textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="rcptVendorTaxId">{t('Business GSTIN / VAT ID / Tax ID (Optional)', lang)}</label>
        <input type="text" id="rcptVendorTaxId" class="form-input" placeholder={t('e.g., GSTIN, VAT, or ABN', lang)} style="height: 36px; font-size: 13px;" />
      </div>
    </div>

    <div class="form-card">
      <div class="form-card-title">{t('To (Customer / Buyer)', lang)}</div>
      <div class="form-group">
        <label class="form-label" for="rcptClientName">{t('Customer Name', lang)}</label>
        <input type="text" id="rcptClientName" class="form-input" value={sample.ClientName} />
      </div>
      <div class="form-group">
        <label class="form-label" for="rcptClientAddress">{t('Address & Details', lang)}</label>
        <textarea id="rcptClientAddress" class="textarea-input">{sample.ClientAddress}</textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="rcptClientTaxId">{t('Customer GSTIN / VAT ID / Tax ID (Optional)', lang)}</label>
        <input type="text" id="rcptClientTaxId" class="form-input" placeholder={t('e.g., Client GSTIN, VAT', lang)} style="height: 36px; font-size: 13px;" />
      </div>
    </div>

    <div class="form-card">
      <div class="form-card-title">{t('Itemized Line Items', lang)}</div>
      <table class="item-edit-table" id="rcptItemEditTable">
        <thead>
          <tr>
            <th style="width: 50%;">{t('Description', lang)}</th>
            <th style="width: 15%;">{t('Qty', lang)}</th>
            <th style="width: 25%;" id="rcptRateHeader">{t('Rate ($)', lang)}</th>
            <th style="width: 10%;"></th>
          </tr>
        </thead>
        <tbody id="rcptItemEditRows">
        </tbody>
      </table>
      <button class="button button-secondary" id="rcptBtnAddItem" style="height: 34px; font-size: 13px; margin-top: var(--spacing-xs);">{t('+ Add Line Item', lang)}</button>
    </div>

    <div class="form-card">
      <div class="form-card-title">{t('Notes', lang)}</div>
      <div class="form-group">
        <label class="form-label" for="rcptNotes">{t('Receipt Notes', lang)}</label>
        <textarea id="rcptNotes" class="textarea-input">{sample.Notes}</textarea>
        <script type="application/json" id="rcptSample" set:html={JSON.stringify(sample)}></script>
      </div>
    </div>

    <div class="actions-bar" style="margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: var(--spacing-sm);">
      <button id="rcptBtnDownload" class="button button-primary">{t('Download Receipt PDF', lang)}</button>
      <button id="rcptBtnClear" class="button button-danger">{t('Clear Form', lang)}</button>
    </div>
  </section>

  <section class="preview-pane" id="rcptPreviewPane">
    <div class="a4-wrapper" id="rcptA4Wrapper">
      <div class="receipt-pdf-container" id="receiptPdfContainer">
        <div class="receipt-pdf-header">
          <div>
            <img id="rcptPdfLogo" class="pdf-logo" alt="" hidden />
            <div class="pdf-brand-title" id="rcptPdfVendorTitle">{sample.VendorName}</div>
            <div class="pdf-meta-text" id="rcptPdfVendorSub">{t('Payment Receipt', lang)}</div>
          </div>
          <div>
            <div class="pdf-doc-type">{t('Payment Receipt', lang)}</div>
            <div class="pdf-meta-text" style="text-align: right;">
              {t('No:', lang)} <strong id="rcptPdfNo">REC-2026-001</strong><br />
              {t('Date:', lang)} <span id="rcptPdfDate">--/--/----</span><br />
              {t('Method:', lang)} <span id="rcptPdfMethod" class="payment-badge">{t('Credit Card', lang)}</span>
            </div>
          </div>
        </div>

        <div class="receipt-pdf-addresses">
          <div>
            <div class="address-col-title">{t('Received From', lang)}</div>
            <!-- Same gap as the invoice: "Customer Name" was collected into
                 rcptData and used only to name the downloaded file, so the
                 payer never appeared on the receipt itself. -->
            <div class="address-details" id="rcptPdfClientName" style="font-weight: 700;"></div>
            <div class="address-details" id="rcptPdfClientAddr"></div>
            <div id="rcptClientTaxIdContainer" style="display: none; font-size: 11px; margin-top: 4px; color: #4d4d4d;">
              <strong>{t('Tax ID:', lang)}</strong> <span id="rcptClientTaxId"></span>
            </div>
          </div>
          <div>
            <div class="address-col-title">{t('Received By', lang)}</div>
            <div class="address-details" id="rcptPdfVendorAddr"></div>
            <div id="rcptVendorTaxIdContainer" style="display: none; font-size: 11px; margin-top: 4px; color: #4d4d4d;">
              <strong>{t('Tax ID:', lang)}</strong> <span id="rcptVendorTaxId"></span>
            </div>
          </div>
        </div>

        <table class="receipt-pdf-table">
          <thead>
            <tr>
              <th style="width: 50%;">{t('Item Description', lang)}</th>
              <th style="width: 10%; text-align: right;">{t('Qty', lang)}</th>
              <th style="width: 20%; text-align: right;">{t('Unit Rate', lang)}</th>
              <th style="width: 20%; text-align: right;">{t('Amount', lang)}</th>
            </tr>
          </thead>
          <tbody id="rcptPdfTableRows">
          </tbody>
        </table>

        <div style="margin-top: auto;">
          <div class="pdf-summary-block">
            <table class="pdf-totals-table">
              <tr>
                <td>{t('Subtotal', lang)}</td>
                <td class="right-align" id="rcptPdfSubtotal">$0.00</td>
              </tr>
              <tr id="rcptPdfTaxRow">
                <td id="rcptPdfTaxLabel">GST (18%)</td>
                <td class="right-align" id="rcptPdfTaxAmount">$0.00</td>
              </tr>
              <tr class="grand-total">
                <td>{t('Amount Paid', lang)}</td>
                <td class="right-align" id="rcptPdfGrandTotal">$0.00</td>
              </tr>
            </table>
          </div>

          {isId && (
            /* A kuitansi states the amount in words ("terbilang") and carries
               the receiver's signature — and, over Rp5.000.000, a Rp10.000
               meterai, which the box marks; it shows only when it applies. */
            <div class="rcpt-id-block">
              <div class="rcpt-id-words" id="rcptPdfWords"></div>
              <div class="rcpt-id-sign">
                <div class="rcpt-id-meterai" id="rcptPdfMeterai">{t('Stamp duty Rp10,000', lang)}</div>
                <div class="rcpt-id-signline">{t('Received by,', lang)}</div>
              </div>
            </div>
          )}

          <div class="receipt-pdf-footer">
            <div>
              <div class="address-col-title">{t('Notes', lang)}</div>
              <div class="pdf-terms" id="rcptPdfNotes"></div>
            </div>
            <div class="pdf-thankyou">{t('Payment received. Thank you.', lang)}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (function() {
    let rcptData = {
      No: "REC-2026-001",
      Date: "",
      PayMethod: "Credit Card",
      TaxModel: "GST",
      TaxRate: 0.18,
      /* Every text field below is overwritten by the locale's sample on the
         next line; these are only the shape. They used to hold an Indian
         sample that no page shows any more. */
      VendorName: "",
      VendorAddress: "",
      VendorTaxId: "",
      ClientName: "",
      ClientAddress: "",
      ClientTaxId: "",
      Notes: "",
      CustomTaxLabel: "",
      LineItems: []
    };
    /* The locale's sample, rendered by the component (see #rcptSample). */
    Object.assign(rcptData, JSON.parse(document.getElementById('rcptSample').textContent));
    rcptData.PayMethod = __t(rcptData.PayMethod);

    let rcptCurrSym = document.getElementById('rcptCurrency').value;
    const $ = (id) => document.getElementById(id);

    window.addEventListener('load', () => {
      const today = new Date();
      rcptData.Date = today.toISOString().substring(0, 10);
      $('rcptDate').value = rcptData.Date;
      renderEditorTable();
      updatePreview();
      scalePreview();
    });

    window.addEventListener('resize', scalePreview);

    function scalePreview() {
      const pane = $('rcptPreviewPane');
      const wrapper = $('rcptA4Wrapper');
      if (!pane || !wrapper) return;
      const pw = pane.clientWidth - 40;
      const s = pw < 700 ? pw / 700 : 1;
      wrapper.style.transform = `scale(${s})`;
      pane.style.minHeight = `${800 * s + 40}px`;
    }

    /* Brazilian receipts read "R$ 5.000,00", not "R$5000.00". English keeps
       its existing format exactly. */
    const PT_MONEY = document.documentElement.lang === 'pt';
    /* Indonesian: "Rp 6.000.000" — Rupiah is written without cents; any other
       currency keeps two decimals in Indonesian grouping. */
    const ID_MONEY = document.documentElement.lang === 'id';
    function fmt(n) {
      if (ID_MONEY) {
        const d = rcptCurrSym === 'Rp' ? 0 : 2;
        return rcptCurrSym + ' ' + n.toLocaleString('id-ID', { minimumFractionDigits: d, maximumFractionDigits: d });
      }
      return PT_MONEY
        ? rcptCurrSym + ' ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        : rcptCurrSym + n.toFixed(2);
    }

    /* Rupiah in words, for the "terbilang" line: 6000000 → "enam juta". */
    function terbilang(n) {
      const s = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];
      n = Math.floor(n);
      if (n < 12) return s[n];
      if (n < 20) return terbilang(n - 10) + ' belas';
      if (n < 100) return terbilang(Math.floor(n / 10)) + ' puluh ' + terbilang(n % 10);
      if (n < 200) return 'seratus ' + terbilang(n - 100);
      if (n < 1000) return terbilang(Math.floor(n / 100)) + ' ratus ' + terbilang(n % 100);
      if (n < 2000) return 'seribu ' + terbilang(n - 1000);
      if (n < 1e6) return terbilang(Math.floor(n / 1000)) + ' ribu ' + terbilang(n % 1000);
      if (n < 1e9) return terbilang(Math.floor(n / 1e6)) + ' juta ' + terbilang(n % 1e6);
      if (n < 1e12) return terbilang(Math.floor(n / 1e9)) + ' miliar ' + terbilang(n % 1e9);
      return terbilang(Math.floor(n / 1e12)) + ' triliun ' + terbilang(n % 1e12);
    }
    window.coTerbilang = terbilang;

    function updatePreview() {
      $('rcptPdfVendorTitle').textContent = rcptData.VendorName || "Business Name";
      $('rcptPdfVendorAddr').textContent = rcptData.VendorAddress;
      $('rcptPdfClientName').textContent = rcptData.ClientName;
      $('rcptPdfClientAddr').textContent = rcptData.ClientAddress;
      $('rcptPdfNo').textContent = rcptData.No || "REC-000";
      $('rcptPdfDate').textContent = formatDate(rcptData.Date);
      $('rcptPdfMethod').textContent = rcptData.PayMethod;
      $('rcptPdfNotes').textContent = rcptData.Notes;

      const tbody = $('rcptPdfTableRows');
      tbody.innerHTML = '';
      let subtotal = 0;
      rcptData.LineItems.forEach(item => {
        const amt = item.qty * item.rate;
        subtotal += amt;
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${item.desc || "Item"}</td><td class="right-align">${item.qty}</td><td class="right-align">${fmt(item.rate)}</td><td class="right-align">${fmt(amt)}</td>`;
        tbody.appendChild(tr);
      });

      $('rcptPdfSubtotal').textContent = fmt(subtotal);
      const tax = subtotal * rcptData.TaxRate;
      const grand = subtotal + tax;
      const taxRow = $('rcptPdfTaxRow');
      if (rcptData.TaxModel === 'none') {
        taxRow.style.display = 'none';
      } else {
        taxRow.style.display = 'table-row';
        const label = rcptData.TaxModel === 'custom' ? rcptData.CustomTaxLabel : rcptData.TaxModel;
        const ratePct = parseFloat((rcptData.TaxRate * 100).toFixed(4));
        $('rcptPdfTaxLabel').textContent = `${label} (${ratePct}%)`;
        $('rcptPdfTaxAmount').textContent = fmt(tax);
      }
      $('rcptPdfGrandTotal').textContent = fmt(grand);

      const words = $('rcptPdfWords');
      if (words) {
        const rp = rcptCurrSym === 'Rp';
        const w = rp ? terbilang(Math.round(grand)).replace(/\s+/g, ' ').trim() : '';
        words.textContent = w ? __t('In words:') + ' ' + w.charAt(0).toUpperCase() + w.slice(1) + ' rupiah' : '';
        $('rcptPdfMeterai').style.visibility = rp && grand > 5000000 ? 'visible' : 'hidden';
      }

      // Render Tax IDs
      const vendorTaxIdContainer = $('rcptVendorTaxIdContainer');
      const vendorTaxId = $('rcptVendorTaxId');
      if (vendorTaxIdContainer && vendorTaxId) {
        if (rcptData.VendorTaxId) {
          vendorTaxId.textContent = rcptData.VendorTaxId;
          vendorTaxIdContainer.style.display = 'block';
        } else {
          vendorTaxIdContainer.style.display = 'none';
        }
      }

      const clientTaxIdContainer = $('rcptClientTaxIdContainer');
      const clientTaxId = $('rcptClientTaxId');
      if (clientTaxIdContainer && clientTaxId) {
        if (rcptData.ClientTaxId) {
          clientTaxId.textContent = rcptData.ClientTaxId;
          clientTaxIdContainer.style.display = 'block';
        } else {
          clientTaxIdContainer.style.display = 'none';
        }
      }
    }

    function renderEditorTable() {
      const tbody = $('rcptItemEditRows');
      tbody.innerHTML = '';
      // Update header
      const hdr = $('rcptRateHeader');
      if (hdr) hdr.textContent = `${__t('Rate')} (${rcptCurrSym})`;
      rcptData.LineItems.forEach((item, i) => {
        const tr = document.createElement('tr');
        tr.className = 'item-edit-row';
        tr.innerHTML = `
          <td><input type="text" class="form-input" value="${item.desc}" oninput="window._rcptUpdateItem(${i},'desc',this.value)"></td>
          <td><input type="number" class="form-input" style="padding:0 6px;text-align:center;" value="${item.qty}" min="1" oninput="window._rcptUpdateItem(${i},'qty',this.value)"></td>
          <td><input type="number" class="form-input" value="${item.rate}" min="0" step="0.01" oninput="window._rcptUpdateItem(${i},'rate',this.value)"></td>
          <td><button class="item-delete-btn" onclick="window._rcptDeleteItem(${i})">×</button></td>
        `;
        tbody.appendChild(tr);
      });
    }

    window._rcptUpdateItem = function(i, k, v) {
      if (k === 'qty') rcptData.LineItems[i].qty = parseInt(v) || 1;
      else if (k === 'rate') rcptData.LineItems[i].rate = parseFloat(v) || 0;
      else rcptData.LineItems[i].desc = v;
      updatePreview();
    };

    window._rcptDeleteItem = function(i) {
      if (rcptData.LineItems.length > 1) {
        rcptData.LineItems.splice(i, 1);
        renderEditorTable();
        updatePreview();
      }
    };

    $('rcptBtnAddItem').addEventListener('click', () => {
      rcptData.LineItems.push({ desc: "New Item", qty: 1, rate: 0 });
      renderEditorTable();
      updatePreview();
    });

    $('rcptNo').addEventListener('input', e => { rcptData.No = e.target.value; updatePreview(); });
    $('rcptDate').addEventListener('change', e => { rcptData.Date = e.target.value; updatePreview(); });
    /* The option's visible text, not its value: the value is English, and the
       PDF printed "Bank Transfer" on a Portuguese receipt. */
    $('rcptPayMethod').addEventListener('change', e => { rcptData.PayMethod = e.target.options[e.target.selectedIndex].text; updatePreview(); });
    $('rcptCurrency').addEventListener('change', e => {
      rcptCurrSym = e.target.value;
      renderEditorTable();
      updatePreview();
    });
    $('rcptTaxSelect').addEventListener('change', e => {
      const t = e.target.value;
      rcptData.TaxModel = t;
      const customTaxGroup = $('rcptCustomTaxGroup');
      if (t === 'GST' || t === 'IGST') {
        rcptData.TaxRate = 0.18;
        customTaxGroup.style.display = 'none';
      } else if (t === 'PPN') {
        /* PMK 131/2024: 12% × DPP nilai lain 11/12 = an effective 11% on
           everything that is not a luxury good. */
        rcptData.TaxRate = 0.11;
        customTaxGroup.style.display = 'none';
      } else if (t === 'VAT') {
        rcptData.TaxRate = 0.15;
        customTaxGroup.style.display = 'none';
      } else if (t === 'custom') {
        customTaxGroup.style.display = 'flex';
        const customRate = parseFloat($('rcptCustomTaxRate').value) || 0;
        rcptData.TaxRate = customRate / 100;
        rcptData.CustomTaxLabel = $('rcptCustomTaxLabel').value || 'Tax';
      } else {
        rcptData.TaxRate = 0;
        customTaxGroup.style.display = 'none';
      }
      updatePreview();
    });
    $('rcptCustomTaxLabel').addEventListener('input', e => {
      rcptData.CustomTaxLabel = e.target.value || 'Tax';
      updatePreview();
    });
    $('rcptCustomTaxRate').addEventListener('input', e => {
      const rate = parseFloat(e.target.value) || 0;
      rcptData.TaxRate = rate / 100;
      updatePreview();
    });
    $('rcptVendorTaxId').addEventListener('input', e => {
      rcptData.VendorTaxId = e.target.value;
      updatePreview();
    });
    $('rcptClientTaxId').addEventListener('input', e => {
      rcptData.ClientTaxId = e.target.value;
      updatePreview();
    });
    $('rcptVendorName').addEventListener('input', e => { rcptData.VendorName = e.target.value; updatePreview(); });
    $('rcptVendorAddress').addEventListener('input', e => { rcptData.VendorAddress = e.target.value; updatePreview(); });
    $('rcptClientName').addEventListener('input', e => { rcptData.ClientName = e.target.value; updatePreview(); });
    $('rcptClientAddress').addEventListener('input', e => { rcptData.ClientAddress = e.target.value; updatePreview(); });
    $('rcptNotes').addEventListener('input', e => { rcptData.Notes = e.target.value; updatePreview(); });

    function formatDate(ds) {
      if (!ds) return '--/--/----';
      const p = ds.split('-');
      return p.length === 3 ? `${p[2]}/${p[1]}/${p[0]}` : ds;
    }

    $('rcptBtnDownload').addEventListener('click', () => {
      const el = $('receiptPdfContainer');
      const clone = el.cloneNode(true);
      // In flow, not moved off-screen, AND rendered with the document scrolled to
      // the top — html2canvas silently returns a blank white page if any of the
      // three is missing. See the full note in InvoiceGenerator. Measured ink:
      // 3.51% at scrollY 0, 0% once the page is scrolled down to the button.
      const savedScroll = window.scrollY || document.documentElement.scrollTop || 0;
      const pdfHost = document.createElement('div');
      pdfHost.style.height = '0';
      pdfHost.style.overflow = 'hidden';

      clone.style.transform = 'none';
      clone.style.position = 'static';
      clone.style.width = '794px';
      clone.style.height = 'auto';
      clone.removeAttribute('id');
      clone.querySelectorAll('[id]').forEach(n => n.removeAttribute('id'));
      pdfHost.appendChild(clone);
      document.body.insertBefore(pdfHost, document.body.firstChild);
      window.scrollTo(0, 0);

      const finishPdf = () => {
        pdfHost.remove();
        window.scrollTo(0, savedScroll);
      };
      const fn = (rcptData.No || 'receipt') + '_' + rcptData.ClientName.replace(/\s+/g, '_').toLowerCase() + '.pdf';
      html2pdf().set({
        margin: 0, filename: fn,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, logging: false },
        jsPDF: { unit: 'pt', format: 'a4', orientation: 'portrait' }
      }).from(clone).save().then(finishPdf).catch(finishPdf);
    });

    $('rcptBtnClear').addEventListener('click', () => {
      rcptData.VendorName = ""; rcptData.VendorAddress = ""; rcptData.VendorTaxId = "";
      rcptData.ClientName = ""; rcptData.ClientAddress = ""; rcptData.ClientTaxId = "";
      rcptData.No = ""; rcptData.Notes = ""; rcptData.CustomTaxLabel = "Tax";
      rcptData.LineItems = [{ desc: "New Item", qty: 1, rate: 0 }];
      $('rcptVendorName').value = ""; $('rcptVendorAddress').value = "";
      $('rcptVendorTaxId').value = "";
      $('rcptClientName').value = ""; $('rcptClientAddress').value = "";
      $('rcptClientTaxId').value = "";
      $('rcptNo').value = ""; $('rcptNotes').value = "";
      $('rcptCustomTaxLabel').value = "Tax";
      $('rcptCustomTaxRate').value = "5";
      $('rcptCustomTaxGroup').style.display = 'none';
      renderEditorTable(); updatePreview();
    });
  })();
</script>

<script is:inline>
  /* Template, accent colour and logo — the invoice generator's Design card.
     The logo is scaled onto a canvas no larger than 400 x 160. */
  (function () {
    const box = document.getElementById('receiptPdfContainer');
    const tpl = document.getElementById('rcptTemplate');
    const acc = document.getElementById('rcptAccent');
    const logo = document.getElementById('rcptLogo');
    const img = document.getElementById('rcptPdfLogo');
    const rm = document.getElementById('rcptLogoRemove');
    if (!box || !tpl) return;
    const apply = () => {
      box.classList.remove('tpl-modern', 'tpl-minimal');
      if (tpl.value !== 'classic') box.classList.add('tpl-' + tpl.value);
      box.style.setProperty('--inv-accent', tpl.value === 'minimal' ? '#171717' : acc.value);
      acc.disabled = tpl.value === 'minimal';
    };
    tpl.addEventListener('change', apply);
    acc.addEventListener('change', apply);
    logo.addEventListener('change', () => {
      const f = logo.files && logo.files[0];
      if (!f) return;
      const r = new FileReader();
      r.onload = () => {
        const im = new Image();
        im.onload = () => {
          const k = Math.min(1, 400 / im.width, 160 / im.height);
          const cv = document.createElement('canvas');
          cv.width = Math.max(1, Math.round(im.width * k));
          cv.height = Math.max(1, Math.round(im.height * k));
          cv.getContext('2d').drawImage(im, 0, 0, cv.width, cv.height);
          img.src = cv.toDataURL('image/png');
          img.hidden = false;
          rm.style.display = 'inline-flex';
        };
        im.src = r.result;
      };
      r.readAsDataURL(f);
    });
    rm.addEventListener('click', () => {
      img.removeAttribute('src');
      img.hidden = true;
      logo.value = '';
      rm.style.display = 'none';
    });
    apply();
  })();
</script>
