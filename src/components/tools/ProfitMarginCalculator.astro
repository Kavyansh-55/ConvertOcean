---
import { t } from '../../i18n/ui';
const { slug, headline, subtitle, lang = 'en'} = Astro.props;
/* Indonesian pages open in Rupiah, at Rupiah scale (same 40% margin). */
const isId = lang === 'id';
const k = isId ? 1000 : 1;
---

<style>
  .calc-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }
  @media (max-width: 900px) {
    .calc-workspace { grid-template-columns: 1fr; }
  }
  .calc-panel {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    /* elevation removed — separation comes from colour, not shadow */
  }
  .calc-panel-title {
    font-size: 13px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: var(--colors-mute);
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: var(--spacing-xs);
  }
  .mode-tabs {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }
  .mode-tab {
    padding: 8px 16px;
    border-radius: var(--rounded-pill);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas);
    color: var(--colors-body);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .mode-tab:hover { border-color: var(--colors-hairline-strong); }
  .mode-tab.active {
    background-color: var(--colors-action);
    color: var(--colors-action-ink);
    border-color: var(--colors-action);
    font-weight: var(--fw-bold);
  }
  .result-card {
    background-color: var(--colors-canvas-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-xs) 0;
    border-bottom: 1px solid var(--colors-hairline);
  }
  .result-row:last-child { border-bottom: none; }
  .result-label {
    font-size: 14px;
    color: var(--colors-body);
  }
  .result-value {
    font-size: 16px;
    font-weight: var(--fw-bold);
    color: var(--colors-ink);
    font-family: var(--font-sans);
  }
  .result-value.highlight {
    font-size: 24px;
    color: var(--colors-link);
  }
  .margin-bar-container {
    width: 100%;
    height: 32px;
    border-radius: var(--rounded-md);
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    overflow: hidden;
    display: flex;
    position: relative;
  }
  .margin-bar-cost {
    height: 100%;
    background-color: var(--p-saffron);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: var(--fw-bold);
    /* Dark, and static: this fill does not change with the theme, so the label
       must not either. White measured 3.27:1 on the red end and 1.54:1 on the
       amber. */
    color: var(--colors-ink-static);
    transition: width 0.4s cubic-bezier(0.16,1,0.3,1);
    min-width: 30px;
  }
  .margin-bar-profit {
    height: 100%;
    background: var(--colors-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: var(--fw-bold);
    color: #fff;
    transition: width 0.4s cubic-bezier(0.16,1,0.3,1);
    min-width: 30px;
  }
  /* The accent lightens in dark mode (#2E96B0), so the white label that clears
     AA on the light accent (5.36:1) falls to 3.44:1. Flipping the label dark
     gives 5.76:1. --colors-ink would NOT do it: it inverts to #f5f5f5 in dark
     and measures 3.15:1, worse than the white it replaces. :global() on the
     ancestor is required - <html> carries data-theme but not this component's
     scope id, so a bare selector would compile to nothing. */
  :global([data-theme="dark"]) .margin-bar-profit {
    color: var(--colors-canvas);
  }

  .formula-box {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    padding: var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--colors-body);
    line-height: 1.8;
  }
</style>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<div class="calc-workspace">
  <div class="calc-panel">
    <div class="calc-panel-title">{t('Calculation Mode', lang)}</div>
    <div class="mode-tabs">
      <button class="mode-tab active" aria-pressed="true" data-mode="margin" id="pmTabMargin">{t('Cost & Revenue → Margin', lang)}</button>
      <button class="mode-tab" aria-pressed="false" data-mode="selling" id="pmTabSelling">{t('Cost & Margin → Price', lang)}</button>
      <button class="mode-tab" aria-pressed="false" data-mode="cost" id="pmTabCost">{t('Revenue & Margin → Cost', lang)}</button>
    </div>

    <div class="calc-panel-title">{t('Currency & Values', lang)}</div>
    <div class="form-group" style="margin-bottom: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xxs);">
      <label class="form-label" for="pmCurrency" style="font-size: 13px; font-weight: 500;">{t('Currency', lang)}</label>
      <select id="pmCurrency" class="select-input" style="height: 40px; border-radius: 6px; border: 1px solid var(--colors-hairline); padding: 0 var(--spacing-sm); font-size: 14px; background-color: var(--colors-canvas); color: var(--colors-ink);">
        <option value="$" selected={!isId}>{t('$ – US Dollar (USD)', lang)}</option>
        <option value="Rp" selected={isId}>{t('Rp – Indonesian Rupiah (IDR)', lang)}</option>
        <option value="€">{t('€ – Euro (EUR)', lang)}</option>
        <option value="£">{t('£ – British Pound (GBP)', lang)}</option>
        <option value="₹">{t('₹ – Indian Rupee (INR)', lang)}</option>
        <option value="¥">{t('¥ – Japanese Yen (JPY)', lang)}</option>
        <option value="¥">{t('¥ – Chinese Yuan (CNY)', lang)}</option>
        <option value="C$">{t('C$ – Canadian Dollar (CAD)', lang)}</option>
        <option value="A$">{t('A$ – Australian Dollar (AUD)', lang)}</option>
        <option value="CHF">{t('CHF – Swiss Franc (CHF)', lang)}</option>
        <option value="AED">{t('AED – UAE Dirham (AED)', lang)}</option>
        <option value="SGD">{t('SGD – Singapore Dollar (SGD)', lang)}</option>
        <option value="R">{t('R – South African Rand (ZAR)', lang)}</option>
        <option value="zł">{t('zł – Polish Złoty (PLN)', lang)}</option>
        <option value="₩">{t('₩ – South Korean Won (KRW)', lang)}</option>
      </select>
    </div>

    <div class="calc-panel-title">{t('Enter Values', lang)}</div>

    <div id="pmFieldsMargin">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="pmCost1" id="pmLblCost1">{t('Cost Price ($)', lang)}</label>
        <input type="number" id="pmCost1" class="form-input" value={60 * k} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="pmRevenue1" id="pmLblRevenue1">{t('Selling Price / Revenue ($)', lang)}</label>
        <input type="number" id="pmRevenue1" class="form-input" value={100 * k} min="0" step="0.01" />
      </div>
    </div>

    <div id="pmFieldsSelling" style="display:none;">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="pmCost2" id="pmLblCost2">{t('Cost Price ($)', lang)}</label>
        <input type="number" id="pmCost2" class="form-input" value={60 * k} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="pmMargin2">{t('Desired Profit Margin (%)', lang)}</label>
        <input type="number" id="pmMargin2" class="form-input" value="40" min="0" max="100" step="0.01" />
      </div>
    </div>

    <div id="pmFieldsCost" style="display:none;">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="pmRevenue3" id="pmLblRevenue3">{t('Revenue / Selling Price ($)', lang)}</label>
        <input type="number" id="pmRevenue3" class="form-input" value={100 * k} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="pmMargin3">{t('Desired Profit Margin (%)', lang)}</label>
        <input type="number" id="pmMargin3" class="form-input" value="40" min="0" max="100" step="0.01" />
      </div>
    </div>

    <button class="button button-primary" id="pmCalcBtn" style="align-self: flex-start;">{t('Calculate', lang)}</button>
  </div>

  <div class="calc-panel">
    <div class="calc-panel-title">{t('Results', lang)}</div>

    <div class="result-card" id="pmResults">
      <div class="result-row">
        <span class="result-label">{t('Profit Margin', lang)}</span>
        <span class="result-value highlight" id="pmResMargin">40.00%</span>
      </div>
      <div class="result-row">
        <span class="result-label">{t('Markup', lang)}</span>
        <span class="result-value" id="pmResMarkup">66.67%</span>
      </div>
      <div class="result-row">
        <span class="result-label">{t('Gross Profit', lang)}</span>
        <span class="result-value" id="pmResProfit">$40.00</span>
      </div>
      <div class="result-row">
        <span class="result-label">{t('Cost', lang)}</span>
        <span class="result-value" id="pmResCost">$60.00</span>
      </div>
      <div class="result-row">
        <span class="result-label">{t('Revenue', lang)}</span>
        <span class="result-value" id="pmResRevenue">$100.00</span>
      </div>
    </div>

    <div class="calc-panel-title" style="margin-top: var(--spacing-sm);">{t('Cost vs Profit Ratio', lang)}</div>
    <div class="margin-bar-container">
      <div class="margin-bar-cost" id="pmBarCost" style="width:60%;">{t('Cost 60%', lang)}</div>
      <div class="margin-bar-profit" id="pmBarProfit" style="width:40%;">{t('Profit 40%', lang)}</div>
    </div>

    <div class="calc-panel-title" style="margin-top: var(--spacing-sm);">{t('Formula Used', lang)}</div>
    <div class="formula-box" id="pmFormula">
      {t('Profit = Revenue − Cost = $100.00 − $60.00 = $40.00', lang)}<br/>
      {t('Margin = (Profit ÷ Revenue) × 100 = (40 ÷ 100) × 100 = 40.00%', lang)}<br/>
      {t('Markup = (Profit ÷ Cost) × 100 = (40 ÷ 60) × 100 = 66.67%', lang)}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const $ = id => document.getElementById(id);
    let mode = 'margin';
    let currSym = $('pmCurrency').value;

    // Currency selector
    $('pmCurrency').addEventListener('change', function() {
      currSym = this.value;
      updateCurrencyLabels();
      calculate();
    });

    function updateCurrencyLabels() {
      $('pmLblCost1').textContent = __tf('Cost Price ({0})', currSym);
      $('pmLblRevenue1').textContent = __tf('Selling Price / Revenue ({0})', currSym);
      $('pmLblCost2').textContent = __tf('Cost Price ({0})', currSym);
      $('pmLblRevenue3').textContent = __tf('Revenue / Selling Price ({0})', currSym);
    }

    const tabs = document.querySelectorAll('.mode-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
        tab.classList.add('active');
        tab.setAttribute('aria-pressed', 'true');
        mode = tab.dataset.mode;
        $('pmFieldsMargin').style.display = mode === 'margin' ? 'block' : 'none';
        $('pmFieldsSelling').style.display = mode === 'selling' ? 'block' : 'none';
        $('pmFieldsCost').style.display = mode === 'cost' ? 'block' : 'none';
        calculate();
      });
    });

    /* Indonesian pages: "Rp 7.800.000" — Rupiah without cents, Indonesian
       grouping for every currency. */
    const ID_MONEY = document.documentElement.lang === 'id';
    function fmt(n) {
      if (ID_MONEY) {
        const d = currSym === 'Rp' ? 0 : 2;
        return currSym + ' ' + n.toLocaleString('id-ID', { minimumFractionDigits: d, maximumFractionDigits: d });
      }
      return currSym + n.toFixed(2);
    }

    function calculate() {
      let cost = 0, revenue = 0, profit = 0, marginPct = 0, markupPct = 0;

      if (mode === 'margin') {
        cost = parseFloat($('pmCost1').value) || 0;
        revenue = parseFloat($('pmRevenue1').value) || 0;
        profit = revenue - cost;
        marginPct = revenue > 0 ? (profit / revenue) * 100 : 0;
        markupPct = cost > 0 ? (profit / cost) * 100 : 0;
      } else if (mode === 'selling') {
        cost = parseFloat($('pmCost2').value) || 0;
        marginPct = parseFloat($('pmMargin2').value) || 0;
        revenue = marginPct < 100 ? cost / (1 - marginPct / 100) : 0;
        profit = revenue - cost;
        markupPct = cost > 0 ? (profit / cost) * 100 : 0;
      } else if (mode === 'cost') {
        revenue = parseFloat($('pmRevenue3').value) || 0;
        marginPct = parseFloat($('pmMargin3').value) || 0;
        profit = revenue * (marginPct / 100);
        cost = revenue - profit;
        markupPct = cost > 0 ? (profit / cost) * 100 : 0;
      }

      $('pmResMargin').textContent = marginPct.toFixed(2) + '%';
      $('pmResMarkup').textContent = markupPct.toFixed(2) + '%';
      $('pmResProfit').textContent = fmt(profit);
      $('pmResCost').textContent = fmt(cost);
      $('pmResRevenue').textContent = fmt(revenue);

      const costPct = revenue > 0 ? Math.max(5, (cost / revenue) * 100) : 50;
      const profitPct = revenue > 0 ? Math.max(5, (profit / revenue) * 100) : 50;
      $('pmBarCost').style.width = costPct + '%';
      $('pmBarCost').textContent = __tf('Cost {0}%', Math.round(costPct));
      $('pmBarProfit').style.width = profitPct + '%';
      $('pmBarProfit').textContent = __tf('Profit {0}%', Math.round(profitPct));

      if (mode === 'margin') {
        $('pmFormula').innerHTML = [
          __tf('Profit = Revenue − Cost = {0} − {1} = {2}', fmt(revenue), fmt(cost), fmt(profit)),
          __tf('Margin = (Profit ÷ Revenue) × 100 = ({0} ÷ {1}) × 100 = {2}%', profit.toFixed(2), revenue.toFixed(2), marginPct.toFixed(2)),
          __tf('Markup = (Profit ÷ Cost) × 100 = ({0} ÷ {1}) × 100 = {2}%', profit.toFixed(2), cost.toFixed(2), markupPct.toFixed(2)),
        ].join('<br/>');
      } else if (mode === 'selling') {
        $('pmFormula').innerHTML = [
          __tf('Selling Price = Cost ÷ (1 − Margin/100) = {0} ÷ {1} = {2}', fmt(cost), (1 - marginPct/100).toFixed(4), fmt(revenue)),
          __tf('Profit = Revenue − Cost = {0} − {1} = {2}', fmt(revenue), fmt(cost), fmt(profit)),
          __tf('Markup = (Profit ÷ Cost) × 100 = {0}%', markupPct.toFixed(2)),
        ].join('<br/>');
      } else {
        $('pmFormula').innerHTML = [
          __tf('Cost = Revenue × (1 − Margin/100) = {0} × {1} = {2}', fmt(revenue), (1 - marginPct/100).toFixed(4), fmt(cost)),
          __tf('Profit = Revenue − Cost = {0} − {1} = {2}', fmt(revenue), fmt(cost), fmt(profit)),
          __tf('Markup = (Profit ÷ Cost) × 100 = {0}%', markupPct.toFixed(2)),
        ].join('<br/>');
      }
    }

    $('pmCalcBtn').addEventListener('click', calculate);
    ['pmCost1','pmRevenue1','pmCost2','pmMargin2','pmRevenue3','pmMargin3'].forEach(id => {
      $(id).addEventListener('input', calculate);
    });

    updateCurrencyLabels();
    window.addEventListener('load', calculate);
  })();
</script>
