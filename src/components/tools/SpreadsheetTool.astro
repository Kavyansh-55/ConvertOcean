---
import CategoryIcon from '../CategoryIcon.astro';
const { slug, name, headline, subtitle } = Astro.props;

// Determine file inputs accept attributes and details
let acceptMime = ".csv";
let uploadLabel = "CSV";
let targetFormat = "JSON";
if (slug === 'csv-to-json') {
  acceptMime = ".csv";
  uploadLabel = "CSV (Max 25MB)";
  targetFormat = "JSON";
} else if (slug === 'json-to-csv') {
  acceptMime = ".json";
  uploadLabel = "JSON (Max 15MB)";
  targetFormat = "CSV";
} else if (slug === 'xlsx-to-csv') {
  acceptMime = ".xlsx,.xls";
  uploadLabel = "XLSX or XLS (Max 25MB)";
  targetFormat = "CSV";
} else if (slug === 'csv-to-xlsx') {
  acceptMime = ".csv";
  uploadLabel = "CSV (Max 25MB)";
  targetFormat = "XLSX";
} else if (slug === 'json-to-xlsx') {
  acceptMime = ".json";
  uploadLabel = "JSON (Max 15MB)";
  targetFormat = "XLSX";
} else if (slug === 'xml-to-json') {
  acceptMime = ".xml";
  uploadLabel = "XML (Max 15MB)";
  targetFormat = "JSON";
} else if (slug === 'xlsx-to-json') {
  acceptMime = ".xlsx";
  uploadLabel = "XLSX (Max 25MB)";
  targetFormat = "JSON";
} else if (slug === 'xls-to-json') {
  acceptMime = ".xls";
  uploadLabel = "XLS (Max 25MB)";
  targetFormat = "JSON";
} else if (slug === 'xls-to-csv') {
  acceptMime = ".xls";
  uploadLabel = "XLS (Max 25MB)";
  targetFormat = "CSV";
} else if (slug === 'xml-to-csv') {
  acceptMime = ".xml";
  uploadLabel = "XML (Max 15MB)";
  targetFormat = "CSV";
} else if (slug === 'xml-to-xlsx') {
  acceptMime = ".xml";
  uploadLabel = "XML (Max 15MB)";
  targetFormat = "XLSX";
}

const isJsonOutput = ['csv-to-json', 'xml-to-json', 'xlsx-to-json', 'xls-to-json'].includes(slug);
---

<style>
  .preview-area {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    padding: var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 13px;
    white-space: pre-wrap;
    max-height: 300px;
    overflow: auto;
    margin-top: var(--spacing-lg);
  }
</style>

<script is:inline src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<!-- Error Banner -->
<div id="errorBanner" class="error-banner">
  <span class="banner-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
  <span id="errorMessage"></span>
</div>

<!-- Progress Indicator -->
<div id="progressOverlay" class="progress-overlay">
  <div class="progress-bar-container">
    <div id="progressBarFill" class="progress-bar-fill"></div>
  </div>
  <div id="progressLabel" class="progress-label">Processing file…</div>
</div>

<!-- Upload Card -->
<div id="dropZone" class="upload-card" onclick="document.getElementById('fileInput').click()">
  <div class="upload-icon"><CategoryIcon icon="⚙️" width="40" height="40" /></div>
  <div class="upload-text-primary">Drag and drop file here, or click to browse</div>
  <div class="upload-text-secondary">{uploadLabel}</div>
  <button type="button" class="upload-cta">Choose file</button>
  <input type="file" id="fileInput" class="file-input" accept={acceptMime} />
</div>

<!-- The script below is a bundled module (it imports the conversion core), and
     Astro's define:vars only works on inline scripts. So the per-tool config
     travels through the DOM instead. -->
<div id="toolConfig" hidden data-slug={slug} data-target={targetFormat} data-json={String(isJsonOutput)}></div>

<pre id="textPreview" class="preview-area" style="display: none;"></pre>

<div id="actionControls" class="panel-card" style="display: none; margin-top: var(--spacing-md); flex-direction: row; justify-content: space-between; align-items: center;">
  <span id="fileNameDisplay" style="font-weight:600; font-size:14px;"></span>
  <div class="button-group">
    <button class="button button-primary" id="btnDownload">Download {targetFormat}</button>
    <button class="button button-danger" id="btnClear">Clear</button>
  </div>
</div>

<script>
  import {
    parseCsv, coerceValue, recordsToRows, pickRecords,
    pickXmlRecords, xmlElementToObject, rowsToCsv,
  } from '../../scripts/tabular.js';

  (function() {
    const cfg = document.getElementById('toolConfig');
    const slug = cfg.dataset.slug;
    const targetFormat = cfg.dataset.target;
    const isJsonOutput = cfg.dataset.json === 'true';

    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const progressOverlay = document.getElementById('progressOverlay');
    const progressBarFill = document.getElementById('progressBarFill');
    const progressLabel = document.getElementById('progressLabel');
    const textPreview = document.getElementById('textPreview');
    const actionControls = document.getElementById('actionControls');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const btnDownload = document.getElementById('btnDownload');
    const btnClear = document.getElementById('btnClear');

    let resultData = null;
    let originalName = '';

    // Drag and drop setup
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('dragover');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      let files = Array.from(e.dataTransfer.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    fileInput.addEventListener('change', (e) => {
      let files = Array.from(e.target.files).slice(0, 1);
      if (files.length > 0) handleFile(files[0]);
    });

    function showProgress(pct, label) {
      progressOverlay.style.display = 'flex';
      progressBarFill.style.width = pct + '%';
      progressLabel.textContent = label;
    }

    function hideProgress() {
      progressOverlay.style.display = 'none';
    }

    function showError(msg) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    /* Read a text file as UTF-8, explicitly.

       The previous code handed the raw bytes of a CSV to the spreadsheet
       library, which decoded them with its default codepage — so every
       non-ASCII character came back as mojibake ("Ünïcodé" → "ÃnÃ¯codÃ©").
       Naming the encoding is the whole fix for that class of bug. */
    function readTextUtf8(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => resolve(String(e.target.result));
        reader.onerror = () => reject(new Error('read failed'));
        reader.readAsText(file, 'utf-8');
      });
    }

    function readBytes(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => resolve(new Uint8Array(e.target.result));
        reader.onerror = () => reject(new Error('read failed'));
        reader.readAsArrayBuffer(file);
      });
    }

    /* A CSV field becomes a typed value, except when the output is JSON: a
       date there should stay the ISO string the user wrote, not the Excel
       serial that only means something inside a spreadsheet. */
    function valueFor(raw, forJson) {
      const c = coerceValue(raw);
      if (c.t === 'd' && forJson) return String(raw).trim();
      return c.v;
    }

    /** Header row + data rows from a parsed CSV, with a parallel type grid. */
    function csvToGrid(text, forJson) {
      const parsed = parseCsv(text);
      if (!parsed.length) return { rows: [], types: [] };

      const header = parsed[0].map((h, i) => (String(h).trim() || 'column' + (i + 1)));
      const rows = [header];
      const types = [header.map(() => 's')];

      for (let r = 1; r < parsed.length; r++) {
        const src = parsed[r];
        const row = [];
        const trow = [];
        for (let c = 0; c < header.length; c++) {
          const raw = src[c] === undefined ? '' : src[c];
          const coerced = coerceValue(raw);
          row.push(valueFor(raw, forJson));
          trow.push(coerced.t);
        }
        rows.push(row);
        types.push(trow);
      }
      return { rows, types };
    }

    /** Records (objects) from a header + data grid. */
    function gridToRecords(grid) {
      const [header, ...body] = grid.rows;
      if (!header) return [];
      return body.map((row) => {
        const rec = {};
        header.forEach((h, i) => { rec[h] = row[i]; });
        return rec;
      });
    }

    /**
     * Build a worksheet, re-applying a date format to the cells that hold a
     * date serial. Without the format Excel shows a bare 45658.
     */
    function gridToSheet(grid) {
      const ws = window.XLSX.utils.aoa_to_sheet(grid.rows);
      for (let r = 1; r < grid.types.length; r++) {
        for (let c = 0; c < grid.types[r].length; c++) {
          if (grid.types[r][c] !== 'd') continue;
          const ref = window.XLSX.utils.encode_cell({ r, c });
          if (ws[ref]) { ws[ref].t = 'n'; ws[ref].z = 'yyyy-mm-dd'; }
        }
      }
      return ws;
    }

    function sheetToWorkbook(ws, name) {
      const wb = window.XLSX.utils.book_new();
      window.XLSX.utils.book_append_sheet(wb, ws, name || 'Data');
      return window.XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
    }

    /** Rows from an arbitrary JSON value, keeping nested data. */
    function jsonToGrid(text) {
      const picked = pickRecords(JSON.parse(text));
      const rows = recordsToRows(picked.records);
      return { rows, types: rows.map((r) => r.map(() => 's')), note: picked.source };
    }

    /** Rows from an XML document, using its repeating element as the record. */
    function xmlToGrid(text) {
      const doc = parseXmlStrict(text);
      const picked = pickXmlRecords(doc.documentElement);
      const records = picked.elements.map((el) => {
        const obj = xmlElementToObject(el);
        return (obj && typeof obj === 'object') ? obj : { value: obj };
      });
      const rows = recordsToRows(records);
      return { rows, types: rows.map((r) => r.map(() => 's')), note: '<' + picked.name + '> × ' + picked.elements.length };
    }

    async function handleFile(file) {
      /* The drop zone promises 25MB; this is what keeps it. Published by
         [tool].astro because this script is is:inline and cannot import. */
      const tooLarge = window.coFileTooLarge && window.coFileTooLarge(file, 25);
      if (tooLarge) { showError(tooLarge); return; }
      hideError();
      originalName = file.name;
      showProgress(20, 'Reading file content…');

      try {
        if (slug === 'csv-to-json') {
          const grid = csvToGrid(await readTextUtf8(file), true);
          resultData = JSON.stringify(gridToRecords(grid), null, 2);
          showPreview(resultData);

        } else if (slug === 'csv-to-xlsx') {
          const grid = csvToGrid(await readTextUtf8(file), false);
          resultData = sheetToWorkbook(gridToSheet(grid));
          showPreview(previewGrid(grid.rows));

        } else if (slug === 'json-to-csv') {
          const grid = jsonToGrid(await readTextUtf8(file));
          resultData = rowsToCsv(grid.rows);
          showPreview(resultData);

        } else if (slug === 'json-to-xlsx') {
          const grid = jsonToGrid(await readTextUtf8(file));
          resultData = sheetToWorkbook(gridToSheet(grid));
          showPreview(previewGrid(grid.rows));

        } else if (slug === 'xml-to-json') {
          const doc = parseXmlStrict(await readTextUtf8(file));
          resultData = JSON.stringify(xmlElementToObject(doc.documentElement), null, 2);
          showPreview(resultData);

        } else if (slug === 'xml-to-csv') {
          const grid = xmlToGrid(await readTextUtf8(file));
          resultData = rowsToCsv(grid.rows);
          showPreview(resultData);

        } else if (slug === 'xml-to-xlsx') {
          const grid = xmlToGrid(await readTextUtf8(file));
          resultData = sheetToWorkbook(gridToSheet(grid));
          showPreview(previewGrid(grid.rows));

        } else if (slug === 'xlsx-to-json' || slug === 'xls-to-json') {
          const wb = window.XLSX.read(await readBytes(file), { type: 'array' });
          const sheet = wb.Sheets[wb.SheetNames[0]];
          // raw:false gives the formatted text, so a currency or date cell
          // reads the way it looked in Excel rather than as a bare serial.
          resultData = JSON.stringify(
            window.XLSX.utils.sheet_to_json(sheet, { defval: '', raw: false }), null, 2);
          showPreview(resultData);

        } else if (slug === 'xlsx-to-csv' || slug === 'xls-to-csv') {
          const wb = window.XLSX.read(await readBytes(file), { type: 'array' });
          const sheet = wb.Sheets[wb.SheetNames[0]];
          const rows = window.XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
          resultData = rowsToCsv(rows);
          showPreview(resultData);

        } else {
          throw new Error('unsupported conversion: ' + slug);
        }
      } catch (err) {
        showError(errorFor(slug, err));
      }
      hideProgress();
    }

    /** A readable text preview of a grid that will be written as a binary workbook. */
    function previewGrid(rows) {
      return rows.slice(0, 20)
        .map((r) => r.map((c) => (c === null || c === undefined ? '' : String(c))).join('\t'))
        .join('\n') + (rows.length > 20 ? '\n…[' + (rows.length - 20) + ' more rows]' : '');
    }

    /* Error copy that says what to do next, not just that something failed. */
    function errorFor(slug, err) {
      const from = String(slug).split('-to-')[0].toUpperCase();
      if (err && /JSON/i.test(err.message) && from === 'JSON') {
        return 'That file is not valid JSON. Check it in the JSON Formatter first, then try again.';
      }
      if (err && /Invalid XML/i.test(err.message)) {
        return 'That file is not valid XML — it may be truncated or contain an unescaped & or < character.';
      }
      return 'Could not read that ' + from + ' file. If it opens correctly elsewhere, try re-saving it as ' +
             from + ' and converting again.';
    }

    // DOMParser does not throw on malformed XML — it returns a document
    // containing a <parsererror> element. Detect that so bad input shows a
    // clear error instead of being turned into garbage rows.
    function parseXmlStrict(text) {
      const doc = new DOMParser().parseFromString(text, 'text/xml');
      if (doc.getElementsByTagName('parsererror').length > 0 || !doc.documentElement) {
        throw new Error('Invalid XML');
      }
      return doc;
    }

    /**
     * Reveal the result — unless there is no result.
     *
     * Every branch above ends here, which is why the emptiness check lives at
     * this one point rather than in each of the five conversions. An empty
     * input used to sail through and offer a download: `csv-to-json` on an
     * empty .csv handed back two bytes, `[]`, and the reader discovered that
     * only after opening it.
     *
     * "Empty" has to mean more than a zero-length string, because a converter
     * that found nothing still emits its container — `[]` for JSON, a bare
     * newline or BOM for CSV. Those are the shapes to catch.
     */
    function showPreview(text) {
      const body = String(text == null ? '' : text)
        .replace(/^﻿/, '')
        .trim();
      const emptyContainer = body === '' || body === '[]' || body === '{}'
        || /^\[\s*\]$/.test(body) || /^\{\s*\}$/.test(body);
      if (emptyContainer) {
        showError(window.coNothingToConvert
          ? window.coNothingToConvert('file')
          : 'This file has nothing in it to convert.');
        return;
      }

      textPreview.textContent = text.substring(0, 1200) + (text.length > 1200 ? '\n…[truncated preview]' : '');
      textPreview.style.display = 'block';
      fileNameDisplay.textContent = originalName;
      actionControls.style.display = 'flex';
      dropZone.style.display = 'none';
    }

    btnDownload.addEventListener('click', () => {
      const ext = targetFormat.toLowerCase();
      const outName = originalName.replace(/\.[^/.]+$/, "") + '.' + ext;
      let blob;
      if (['xlsx'].includes(ext)) {
        blob = new Blob([resultData], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
      } else if (['json'].includes(ext)) {
        blob = new Blob([resultData], { type: "application/json;charset=utf-8;" });
      } else {
        blob = new Blob([resultData], { type: "text/csv;charset=utf-8;" });
      }
      window.downloadBlob(blob, outName, blob.type);
    });

    btnClear.addEventListener('click', () => {
      resultData = null;
      textPreview.style.display = 'none';
      actionControls.style.display = 'none';
      dropZone.style.display = 'flex';
      fileInput.value = '';
    });
  })();
</script>
