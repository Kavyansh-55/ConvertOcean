---
import { t } from '../../i18n/ui';
import { stateSalesTaxRates, AS_OF, US_AVERAGE_COMBINED } from '../../data/us-sales-tax-rates';

const { slug, headline, subtitle, lang = 'en'} = Astro.props;
/* Indonesian pages (/id/kalkulator-ppn/) are a PPN calculator: PMK 131/2024
   taxes non-luxury goods at 12% of a DPP nilai lain of 11/12 — an effective
   11% of the price — and luxury goods at the full 12%. The US state picker
   means nothing there and is left out. */
const isId = lang === 'id';
---

<style>
  .tax-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }
  @media (max-width: 900px) {
    .tax-workspace { grid-template-columns: 1fr; }
  }
  .tax-panel {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    /* elevation removed — separation comes from colour, not shadow */
  }
  .tax-panel-title {
    font-size: 13px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    font-family: var(--font-sans);
    color: var(--colors-mute);
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: var(--spacing-xs);
  }
  .tax-mode-tabs {
    display: flex;
    gap: var(--spacing-xs);
  }
  .tax-mode-tab {
    flex: 1;
    padding: 10px 16px;
    border-radius: var(--rounded-pill);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas);
    color: var(--colors-body);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
    text-align: center;
  }
  .tax-mode-tab:hover { border-color: var(--colors-hairline-strong); }
  .tax-mode-tab.active {
    background-color: var(--colors-ink);
    color: var(--colors-canvas);
    border-color: var(--colors-ink);
  }
  .preset-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-xs);
  }
  @media (max-width: 600px) {
    .preset-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .preset-btn {
    padding: 8px 6px;
    border-radius: var(--rounded-md);
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas-soft);
    color: var(--colors-body);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
    text-align: center;
  }
  .preset-btn:hover {
    border-color: var(--colors-link);
    color: var(--colors-link);
    background-color: var(--colors-link-bg-soft);
  }
  .preset-btn.active {
    background-color: var(--colors-action);
    color: var(--colors-action-ink);
    border-color: var(--colors-action);
    font-weight: var(--fw-bold);
  }
  .tax-result-card {
    background-color: var(--colors-canvas-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .tax-result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-xs) 0;
    border-bottom: 1px solid var(--colors-hairline);
  }
  .tax-result-row:last-child { border-bottom: none; }
  .tax-result-label {
    font-size: 14px;
    color: var(--colors-body);
  }
  .tax-result-value {
    font-size: 16px;
    font-weight: var(--fw-bold);
    color: var(--colors-ink);
    font-family: var(--font-sans);
  }
  .tax-result-value.grand {
    font-size: 26px;
    color: var(--colors-link);
  }
  .tax-breakdown {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    overflow: hidden;
  }
  .tax-breakdown table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .tax-breakdown th {
    background-color: var(--colors-canvas-soft-2);
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--colors-mute);
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--colors-hairline);
  }
  .tax-breakdown td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--colors-hairline);
    color: var(--colors-body);
  }
  .tax-breakdown tr:last-child td { border-bottom: none; }
  .tax-breakdown td:last-child, .tax-breakdown th:last-child { text-align: right; }
  .tax-state-note {
    font-size: 12px;
    line-height: 1.55;
    color: var(--colors-mute);
    margin: var(--spacing-xxs) 0 0;
  }
  .tax-state-note a {
    color: var(--colors-link);
    text-decoration: underline;
  }
  .tax-state-note a:hover { color: var(--colors-link-deep); }
  .tax-state-note strong { color: var(--colors-body); font-weight: var(--fw-bold); }
  .formula-box {
    background-color: var(--colors-canvas-soft-2);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    padding: var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--colors-body);
    line-height: 1.8;
  }
</style>

<div class="page-header">
  <h1 class="page-title">{headline}</h1>
  <p class="page-description">{subtitle}</p>
</div>

<div class="tax-workspace">
  <div class="tax-panel">
    <div class="tax-panel-title">{t('Calculation Mode', lang)}</div>
    <div class="tax-mode-tabs">
      <button class="tax-mode-tab active" aria-pressed="true" id="taxTabAdd">{t('Add Sales Tax', lang)}</button>
      <button class="tax-mode-tab" aria-pressed="false" id="taxTabRemove">{t('Remove Sales Tax', lang)}</button>
    </div>

    <div class="tax-panel-title">{t('Country / Region', lang)} <span style="text-transform: none; font-weight: 400;">{t('— sales tax, VAT & GST', lang)}</span></div>
    <div class="preset-grid" id="taxPresetGrid">
      {isId && [
        <button class="preset-btn active" data-rate="11">{t('PPN 11% (non-luxury goods)', lang)}</button>,
        <button class="preset-btn" data-rate="12">{t('PPN 12% (luxury goods)', lang)}</button>
      ]}
      {!isId && <button class="preset-btn active" data-rate={US_AVERAGE_COMBINED.toFixed(2)}>US Avg {US_AVERAGE_COMBINED.toFixed(2)}%</button>}
      <button class="preset-btn" data-rate="20">UK VAT 20%</button>
      <button class="preset-btn" data-rate="5">CA GST 5%</button>
      <button class="preset-btn" data-rate="13">CA HST 13%</button>
      <button class="preset-btn" data-rate="10">AU GST 10%</button>
      <button class="preset-btn" data-rate="19">DE VAT 19%</button>
      <button class="preset-btn" data-rate="18">IN GST 18%</button>
      <button class="preset-btn" data-rate="10">JP Tax 10%</button>
      <button class="preset-btn" id="presetBtnCustom" data-rate="custom">{t('Custom Rate', lang)}</button>
    </div>
    <p class="tax-state-note">{t('Any country works — pick a preset, or type your own rate below. Currency is set separately.', lang)}</p>

    {!isId && <Fragment>
    <div class="tax-panel-title">{t('United States — rate by state', lang)} <span style="text-transform: none; font-weight: 400;">{t('(optional)', lang)}</span></div>
    <div class="form-group" style="margin-bottom: 0; display: flex; flex-direction: column; gap: var(--spacing-xxs);">
      <label class="form-label" for="taxUsState" style="font-size: 13px; font-weight: 500;">{t('US buyers: pick a state to load its combined rate', lang)}</label>
      <select id="taxUsState" class="select-input" style="height: 40px; border-radius: 6px; border: 1px solid var(--colors-hairline); padding: 0 var(--spacing-sm); font-size: 14px; background-color: var(--colors-canvas); color: var(--colors-ink);">
        <option value="" selected>{t('— Choose a state —', lang)}</option>
        {stateSalesTaxRates.map(s => (
          <option value={s.abbr} data-rate={s.combined.toFixed(2)} data-state={s.state}>
            {s.state} — {s.combined.toFixed(2)}%
          </option>
        ))}
      </select>
      <p class="tax-state-note" id="taxStateNote">
        {t('State rate plus the average local rate, as of', lang)} {AS_OF}. {t('Local rates vary by address, so treat this as an estimate', lang)} &mdash; <a href="/guides/us-sales-tax-by-state/">{t('see the full rate table and how to find your exact rate', lang)}</a>.
      </p>
    </div>
    </Fragment>}

    <div class="tax-panel-title">{t('Currency & Values', lang)}</div>
    <div class="form-group" style="margin-bottom: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xxs);">
      <label class="form-label" for="taxCurrency" style="font-size: 13px; font-weight: 500;">{t('Currency', lang)}</label>
      <select id="taxCurrency" class="select-input" style="height: 40px; border-radius: 6px; border: 1px solid var(--colors-hairline); padding: 0 var(--spacing-sm); font-size: 14px; background-color: var(--colors-canvas); color: var(--colors-ink);">
        <option value="$" selected={!isId}>{t('$ – US Dollar (USD)', lang)}</option>
        <option value="Rp" selected={isId}>{t('Rp – Indonesian Rupiah (IDR)', lang)}</option>
        <option value="&euro;">{t('€ – Euro (EUR)', lang)}</option>
        <option value="&pound;">{t('£ – British Pound (GBP)', lang)}</option>
        <option value="&#8377;">{t('₹ – Indian Rupee (INR)', lang)}</option>
        <option value="&yen;">{t('¥ – Japanese Yen (JPY)', lang)}</option>
        <option value="&yen;">{t('¥ – Chinese Yuan (CNY)', lang)}</option>
        <option value="C$">{t('C$ – Canadian Dollar (CAD)', lang)}</option>
        <option value="A$">{t('A$ – Australian Dollar (AUD)', lang)}</option>
        <option value="CHF">{t('CHF – Swiss Franc (CHF)', lang)}</option>
        <option value="AED">{t('AED – UAE Dirham (AED)', lang)}</option>
        <option value="SGD">{t('SGD – Singapore Dollar (SGD)', lang)}</option>
        <option value="R">{t('R – South African Rand (ZAR)', lang)}</option>
        <option value="zł">{t('zł – Polish Złoty (PLN)', lang)}</option>
        <option value="₩">{t('₩ – South Korean Won (KRW)', lang)}</option>
      </select>
    </div>

    <div class="tax-panel-title">{t('Enter Values', lang)}</div>
    <div id="taxFieldsAdd">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="taxPrice1" id="taxLblPrice1">{t('Pre-Tax Price ($)', lang)}</label>
        <input type="number" id="taxPrice1" class="form-input" value={isId ? 1000000 : 100} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="taxRate1">{t('Tax Rate (%)', lang)}</label>
        <input type="number" id="taxRate1" class="form-input" value={isId ? 11 : 7.53} min="0" max="100" step="0.01" />
      </div>
    </div>

    <div id="taxFieldsRemove" style="display:none;">
      <div class="form-group" style="margin-bottom: var(--spacing-md);">
        <label class="form-label" for="taxTotal2" id="taxLblTotal2">{t('Total Price (Tax Inclusive) ($)', lang)}</label>
        <input type="number" id="taxTotal2" class="form-input" value={isId ? 1110000 : 107.53} min="0" step="0.01" />
      </div>
      <div class="form-group">
        <label class="form-label" for="taxRate2">{t('Tax Rate (%)', lang)}</label>
        <input type="number" id="taxRate2" class="form-input" value={isId ? 11 : 7.53} min="0" max="100" step="0.01" />
      </div>
    </div>

    <button class="button button-primary" id="taxCalcBtn" style="align-self: flex-start;">{t('Calculate Tax', lang)}</button>
  </div>

  <div class="tax-panel">
    <div class="tax-panel-title">{t('Tax Calculation Results', lang)}</div>

    <div class="tax-result-card">
      <div class="tax-result-row">
        <span class="tax-result-label" id="taxResGrandLabel">{t('Total (Tax Inclusive)', lang)}</span>
        <span class="tax-result-value grand" id="taxResGrand">$107.53</span>
      </div>
      <div class="tax-result-row">
        <span class="tax-result-label">{t('Tax Amount', lang)}</span>
        <span class="tax-result-value" id="taxResTax">$7.53</span>
      </div>
      <div class="tax-result-row">
        <span class="tax-result-label" id="taxResBaseLabel">{t('Pre-Tax Price', lang)}</span>
        <span class="tax-result-value" id="taxResBase">$100.00</span>
      </div>
      <div class="tax-result-row">
        <span class="tax-result-label">{t('Tax Rate', lang)}</span>
        <span class="tax-result-value" id="taxResRate">7.53%</span>
      </div>
    </div>

    <div class="tax-panel-title" style="margin-top: var(--spacing-sm);">{t('Detailed Breakdown', lang)}</div>
    <div class="tax-breakdown">
      <table>
        <thead>
          <tr>
            <th>{t('Component', lang)}</th>
            <th>{t('Amount', lang)}</th>
          </tr>
        </thead>
        <tbody id="taxBreakdownBody">
          <tr><td>{t('Base Price', lang)}</td><td>$100.00</td></tr>
          <tr><td>{t('Tax (7.53%)', lang)}</td><td>$7.53</td></tr>
          <tr><td style="font-weight:600; color: var(--colors-ink);">{t('Total', lang)}</td><td style="font-weight:600; color: var(--colors-ink);">$107.53</td></tr>
        </tbody>
      </table>
    </div>

    <div class="tax-panel-title" style="margin-top: var(--spacing-sm);">{t('Formula Used', lang)}</div>
    <div class="formula-box" id="taxFormula">
      {t('Tax Amount = Price × (Rate ÷ 100) = $100.00 × 0.0753 = $7.53', lang)}<br/>
      {t('Total = Price + Tax = $100.00 + $7.53 = $107.53', lang)}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const $ = id => document.getElementById(id);
    let taxMode = 'add';
    let currSym = $('taxCurrency').value;

    // Currency selector (setCurrency is defined below, alongside the state picker)
    $('taxCurrency').addEventListener('change', function() {
      setCurrency(this.value);
      calculate();
    });

    $('taxTabAdd').addEventListener('click', () => {
      taxMode = 'add';
      $('taxTabAdd').classList.add('active'); $('taxTabAdd').setAttribute('aria-pressed', 'true');
      $('taxTabRemove').classList.remove('active'); $('taxTabRemove').setAttribute('aria-pressed', 'false');
      $('taxFieldsAdd').style.display = 'block';
      $('taxFieldsRemove').style.display = 'none';
      calculate();
    });

    $('taxTabRemove').addEventListener('click', () => {
      taxMode = 'remove';
      $('taxTabRemove').classList.add('active'); $('taxTabRemove').setAttribute('aria-pressed', 'true');
      $('taxTabAdd').classList.remove('active'); $('taxTabAdd').setAttribute('aria-pressed', 'false');
      $('taxFieldsAdd').style.display = 'none';
      $('taxFieldsRemove').style.display = 'block';
      calculate();
    });

    // US state selector — loads that state's combined (state + average local) rate.
    /* Absent on Indonesian pages, where the picker is not rendered. */
    const stateSelect = $('taxUsState');
    const stateNote = $('taxStateNote');
    const stateNoteDefault = stateNote ? stateNote.innerHTML : '';

    function setCurrency(sym) {
      currSym = sym;
      $('taxCurrency').value = sym;
      $('taxLblPrice1').textContent = __tf('Pre-Tax Price ({0})', sym);
      $('taxLblTotal2').textContent = __tf('Total Price (Tax Inclusive) ({0})', sym);
    }

    // The note names a state, so it must stop naming one the moment the rate
    // stops being that state's rate — otherwise it mislabels the number.
    function clearStateSelection() {
      if (stateSelect && stateSelect.value !== '') {
        stateSelect.value = '';
        stateNote.innerHTML = stateNoteDefault;
      }
    }

    if (stateSelect) stateSelect.addEventListener('change', function() {
      const opt = this.options[this.selectedIndex];
      const rate = parseFloat(opt.dataset.rate);
      if (isNaN(rate)) {
        stateNote.innerHTML = stateNoteDefault;
        return;
      }
      $('taxRate1').value = rate;
      $('taxRate2').value = rate;
      setCurrency('$');
      document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
      stateNote.innerHTML = __tf('<strong>{0}: {1}%</strong> — state rate plus the <em>average</em> local rate. Local rates vary by address, so use this to estimate and confirm the exact rate with the state revenue department before filing. <a href="/guides/us-sales-tax-by-state/">Full rate table for all 50 states</a>.', opt.dataset.state, rate.toFixed(2));
      calculate();
    });

    // Preset buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        clearStateSelection();
        if (btn.dataset.rate === 'custom') {
          if (taxMode === 'add') {
            $('taxRate1').focus();
          } else {
            $('taxRate2').focus();
          }
          return;
        }
        const rate = parseFloat(btn.dataset.rate);
        if (!isNaN(rate)) {
          $('taxRate1').value = rate;
          $('taxRate2').value = rate;
        }
        calculate();
      });
    });

    // Auto-highlight Custom preset when editing rate fields
    ['taxRate1', 'taxRate2'].forEach(id => {
      $(id).addEventListener('input', () => {
        const val = parseFloat($(id).value);
        clearStateSelection();
        let matched = false;
        document.querySelectorAll('.preset-btn').forEach(btn => {
          if (btn.dataset.rate !== 'custom' && parseFloat(btn.dataset.rate) === val) {
            document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            matched = true;
          }
        });
        if (!matched) {
          document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
          $('presetBtnCustom').classList.add('active');
        }
      });
    });

    /* Indonesian pages: "Rp 7.800.000" — Rupiah without cents, Indonesian
       grouping for every currency. */
    const ID_MONEY = document.documentElement.lang === 'id';
    function fmt(n) {
      if (ID_MONEY) {
        const d = currSym === 'Rp' ? 0 : 2;
        return currSym + ' ' + n.toLocaleString('id-ID', { minimumFractionDigits: d, maximumFractionDigits: d });
      }
      return currSym + n.toFixed(2);
    }

    function calculate() {
      let base = 0, tax = 0, total = 0, rate = 0;

      if (taxMode === 'add') {
        base = parseFloat($('taxPrice1').value) || 0;
        rate = parseFloat($('taxRate1').value) || 0;
        tax = base * (rate / 100);
        total = base + tax;
        $('taxResGrandLabel').textContent = __t('Total (Tax Inclusive)');
        $('taxResBaseLabel').textContent = __t('Pre-Tax Price');
        $('taxFormula').innerHTML = [
          __tf('Tax Amount = Price × (Rate ÷ 100) = {0} × {1} = {2}', fmt(base), (rate/100).toFixed(4), fmt(tax)),
          __tf('Total = Price + Tax = {0} + {1} = {2}', fmt(base), fmt(tax), fmt(total)),
        ].join('<br/>');
      } else {
        total = parseFloat($('taxTotal2').value) || 0;
        rate = parseFloat($('taxRate2').value) || 0;
        base = total / (1 + rate / 100);
        tax = total - base;
        $('taxResGrandLabel').textContent = __t('Total (Original)');
        $('taxResBaseLabel').textContent = __t('Pre-Tax Price (Extracted)');
        $('taxFormula').innerHTML = [
          __tf('Pre-Tax Price = Total ÷ (1 + Rate/100) = {0} ÷ {1} = {2}', fmt(total), (1 + rate/100).toFixed(4), fmt(base)),
          __tf('Tax Amount = Total − Pre-Tax = {0} − {1} = {2}', fmt(total), fmt(base), fmt(tax)),
        ].join('<br/>');
      }

      $('taxResGrand').textContent = fmt(total);
      $('taxResTax').textContent = fmt(tax);
      $('taxResBase').textContent = fmt(base);
      $('taxResRate').textContent = rate.toFixed(2) + '%';

      $('taxBreakdownBody').innerHTML = `
        <tr><td>${__t('Base Price')}</td><td>${fmt(base)}</td></tr>
        <tr><td>${__tf('Tax ({0}%)', rate.toFixed(2))}</td><td>${fmt(tax)}</td></tr>
        <tr><td style="font-weight:600; color: var(--colors-ink);">${__t('Total')}</td><td style="font-weight:600; color: var(--colors-ink);">${fmt(total)}</td></tr>
      `;
    }

    $('taxCalcBtn').addEventListener('click', calculate);
    ['taxPrice1','taxRate1','taxTotal2','taxRate2'].forEach(id => {
      $(id).addEventListener('input', calculate);
    });

    setCurrency(currSym);
    window.addEventListener('load', calculate);
  })();
</script>
