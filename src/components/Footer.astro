---
const { lang = 'en' } = Astro.props;

const relLink = (target: string) => {
  const cleanTarget = target.startsWith('/') ? target : `/${target}`;
  if (lang === 'en') return cleanTarget;
  return `/${lang}${cleanTarget}`;
};
---

{/* Footer — the closing deep band. Every link, rule and label inside it
     re-pairs through .band--maroon's tokens; nothing here is coloured by
     hand. */}
<footer class="band--maroon">
  <div class="footer-content">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={relLink('/')} class="nav-brand" style="margin-bottom: 8px;">
          <img src="/logo.png" alt="ConvertOcean Logo" class="brand-logo-img" width="42" height="42" loading="lazy" decoding="async" style="width: 42px; height: 42px; object-fit: contain; flex-shrink: 0; transition: transform 0.2s ease;" />
          <span class="brand-text">Convert<span class="brand-text-sub">ocean</span></span>
        </a>
        <p class="footer-desc">Privacy-first browser-based file utilities. Convert, merge, split and extract file data 100% locally in your browser sandbox.</p>

        {/* The comparison pages used to hang off the bottom of the
            "Resources & Company" list, which made that column 18 rows
            tall. The grid row takes its height from the tallest column,
            so the brand cell sat above ~420px of empty maroon. They are
            their own thing anyway, and this is the space they fill. */}
        <span class="footer-title footer-title--compare">Compare</span>
        <div class="footer-links footer-links--compare">
          <a href={relLink('/vs/smallpdf/')} class="footer-link">vs Smallpdf</a>
          <a href={relLink('/vs/ilovepdf/')} class="footer-link">vs iLovePDF</a>
          <a href={relLink('/vs/adobe-acrobat/')} class="footer-link">vs Adobe Acrobat</a>
          <a href={relLink('/vs/cloudconvert/')} class="footer-link">vs CloudConvert</a>
          <a href={relLink('/vs/zamzar/')} class="footer-link">vs Zamzar</a>
          <a href={relLink('/vs/convertio/')} class="footer-link">vs Convertio</a>
          <a href={relLink('/vs/iloveimg/')} class="footer-link">vs iLoveIMG</a>
          <a href={relLink('/vs/pdf24/')} class="footer-link">vs PDF24</a>
