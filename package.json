{
  "name": "convert-ocean",
  "type": "module",
  "version": "1.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/clean_sitemaps.js",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "i18n:tools": "node scripts/fidelity/verify-i18n.mjs",
    "pt-leaks": "node scripts/fidelity/verify-pt-leaks.mjs",
    "pt-parity": "node scripts/fidelity/verify-pt-parity.mjs",
    "i18n": "node --test scripts/tests/i18n.test.mjs scripts/tests/pt-no-upload-claim.test.mjs",
    "fidelity": "node scripts/fidelity/fixtures/build-all.mjs && node scripts/fidelity/run.mjs",
    "fidelity:fixtures": "node scripts/fidelity/fixtures/build-all.mjs",
    "resilience": "node scripts/fidelity/verify-resilience.mjs",
    "og": "node scripts/og/build-og.mjs",
    "mobile": "node scripts/fidelity/verify-mobile.mjs",
    "limits": "node scripts/fidelity/verify-limits.mjs",
    "races": "node scripts/fidelity/verify-races.mjs",
    "order": "node scripts/fidelity/verify-order.mjs",
    "offline": "node scripts/fidelity/verify-offline.mjs",
    "degenerate": "node scripts/fidelity/verify-degenerate.mjs",
    "calculators": "node scripts/fidelity/verify-calculators.mjs",
    "generators": "node scripts/fidelity/verify-generators.mjs",
    "themes": "node scripts/fidelity/verify-themes.mjs",
    "theme-default": "node scripts/fidelity/verify-theme-default.mjs",
    "webkit": "node scripts/fidelity/verify-webkit.mjs",
    "compress": "node scripts/fidelity/verify-compress.mjs",
    "compress:office": "node scripts/fidelity/verify-compress-office.mjs",
    "keywords": "node scripts/research/keyword-dupes.mjs",
    "imgsize": "node scripts/fidelity/verify-image-resize.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "jszip": "^3.10.2",
    "pdfjs-dist": "^3.4.120",
    "playwright": "^1.63.0",
    "puppeteer-core": "^25.3.0",
    "sax": "^1.6.1",
    "wrangler": "^4.100.0"
  }
}
